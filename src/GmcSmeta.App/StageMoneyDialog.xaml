<Window x:Class="GmcSmeta.App.StageMoneyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="СМР и транспорт этапа" Width="490" Height="410" MinWidth="440"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA"
        FontFamily="{StaticResource UiFontFamily}" FontSize="{StaticResource UiBodySize}"
        ResizeMode="CanResize" MinHeight="410" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="{StaticResource LayoutDialogMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="StageTitle" Grid.Row="0" FontWeight="SemiBold" FontSize="{StaticResource UiH2Size}"
                   TextWrapping="Wrap"/>
        <TextBlock x:Name="MaterialsText" Grid.Row="1" Margin="0,10,0,16"
                   Foreground="#64748B" TextWrapping="Wrap"/>
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="СМР, ₽"/>
            <TextBox x:Name="SmrBox" Grid.Column="1" HorizontalContentAlignment="Right" TextAlignment="Right" MinHeight="32"
                     Padding="8,6"/>
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Транспорт, ₽"/>
            <TextBox x:Name="TransportBox" Grid.Column="1" HorizontalContentAlignment="Right" TextAlignment="Right" MinHeight="32"
                     Padding="8,6"/>
        </Grid>
        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="По договору, ₽"/>
            <TextBox x:Name="TargetBox" Grid.Column="1" HorizontalContentAlignment="Right" TextAlignment="Right" MinHeight="32"
                     Padding="8,6" TextChanged="TargetChanged"/>
        </Grid>
        <TextBlock x:Name="NoteText" Grid.Row="5" Foreground="#64748B"
                   TextWrapping="Wrap"/>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Отмена" Style="{StaticResource PythonToolbarButton}" IsCancel="True" MinWidth="100" Padding="12,6"
                    Margin="0,0,8,0"/>
            <Button x:Name="SaveButton" Content="Сохранить" IsDefault="True"
                    MinWidth="118" Padding="12,6" Click="Save_Click"
                    Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>