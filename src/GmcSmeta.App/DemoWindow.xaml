<Window x:Class="GmcSmeta.App.DemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ГМЦ-Смета · ДЕМО — без SQL Server"
        Height="660" Width="1000" MinWidth="740"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FEF3C7" CornerRadius="5" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock FontWeight="Bold" FontSize="16" Foreground="#92400E"
                           Text="ДЕМОНСТРАЦИОННЫЙ РЕЖИМ · НЕТ ПОДКЛЮЧЕНИЯ К SQL SERVER"/>
                <TextBlock TextWrapping="Wrap" Foreground="#92400E"
                           Text="Все данные синтетические и существуют только в памяти. Редактирование, сохранение, экспорт и Undo/Redo недоступны до подключения к тестовой SQL Server."/>
            </StackPanel>
        </Border>
        <TabControl Grid.Row="1">
            <TabItem Header="Объекты">
                <DataGrid x:Name="DemoObjects" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" Margin="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="70"/>
                        <DataGridTextColumn Header="Объект" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="КП · Смета">
                <DataGrid x:Name="DemoEstimate" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" Margin="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Раздел" Binding="{Binding Section}" Width="155"/>
                        <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="65"/>
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="90"/>
                        <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="105"/>
                        <DataGridTextColumn Header="Итого" Binding="{Binding Total}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Закупки">
                <DataGrid x:Name="DemoProcurement" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" Margin="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Материал" Binding="{Binding Material}" Width="*"/>
                        <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="100"/>
                        <DataGridTextColumn Header="Поставщик" Binding="{Binding Supplier}" Width="200"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="155"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Себестоимость">
                <DataGrid x:Name="DemoCost" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" Margin="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Статья" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Закупка" Binding="{Binding Purchase}" Width="135"/>
                        <DataGridTextColumn Header="Продажа" Binding="{Binding Retail}" Width="135"/>
                        <DataGridTextColumn Header="Разница" Binding="{Binding Margin}" Width="135"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" Margin="0,10,0,0" Foreground="#64748B"
                   Text="Чтобы работать с реальной сметой, закройте демо и запустите программу снова, выбрав тестовую базу."/>
    </Grid>
</Window>
