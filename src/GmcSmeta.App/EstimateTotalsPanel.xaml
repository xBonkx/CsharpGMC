<Grid x:Class="GmcSmeta.App.EstimateTotalsPanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:GmcSmeta.App">
    <Grid.Resources>
        <Style x:Key="TotalsPageRow" TargetType="DataGridRow" BasedOn="{StaticResource TotalsArticleRow}">
            <Setter Property="MinHeight" Value="{Binding MinRowHeight, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
        </Style>
        <Style x:Key="TotalsPageEditor" TargetType="TextBox" BasedOn="{StaticResource TotalsArticleEditor}">
            <Setter Property="FontWeight" Value="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=DataGridCell}}"/>
            <Setter Property="FontStyle" Value="{Binding FontStyle, RelativeSource={RelativeSource AncestorType=DataGridCell}}"/>
        </Style>
    </Grid.Resources>
    <ScrollViewer x:Name="TotalsScroll" Margin="{StaticResource LayoutEmbeddedPageMargin}"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
    <StackPanel MaxWidth="{StaticResource LayoutTotalsMaxWidth}" HorizontalAlignment="Left"
                Width="{Binding ViewportWidth, ElementName=TotalsScroll}">
        <!-- плитки: себестоимость · розница (акцент) · маржа -->
        <Grid Margin="{StaticResource LayoutTotalsTileSectionGap}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{Binding Source={StaticResource LayoutTotalsTileGap}}"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{Binding Source={StaticResource LayoutTotalsTileGap}}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource PythonTile}" MinWidth="0">
                <StackPanel>
                    <TextBlock Text="Себестоимость — всего" Style="{StaticResource PythonTileLabel}"/>
                    <TextBlock x:Name="TotalsTileCostValue" Style="{StaticResource PythonTileValue}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource PythonTileAccent}" MinWidth="0">
                <StackPanel>
                    <TextBlock x:Name="TotalsTileSellCaption" Text="Розница — всего" Style="{StaticResource PythonTileLabel}" Foreground="#DBEAFE"/>
                    <TextBlock x:Name="TotalsTileSellValue" Foreground="White" Style="{StaticResource PythonTileValue}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource PythonTile}" MinWidth="0">
                <StackPanel>
                    <TextBlock Text="Маржа" Style="{StaticResource PythonTileLabel}"/>
                    <TextBlock x:Name="TotalsTileMarginValue" Style="{StaticResource PythonTileValue}"/>
                </StackPanel>
            </Border>
        </Grid>
        <!-- таблица статей (cost_totals_view._show) -->
        <local:SummaryTableFrame Background="White" CornerRadius="12" BorderThickness="1"
                                 Padding="{StaticResource LayoutTotalsTablePadding}" BorderBrush="#E4E8EF">
        <DataGrid local:TableColumnMenu.Key="estimate-totals" x:Name="TotalsGrid" AutoGenerateColumns="False" IsReadOnly="False"
                  MinRowHeight="{StaticResource LayoutTotalsRowHeight}" FontSize="{StaticResource UiTotalsTableSize}"
                  CellStyle="{StaticResource TotalsArticleCell}" RowStyle="{StaticResource TotalsPageRow}" ColumnHeaderStyle="{StaticResource TotalsArticleHeader}"
                  SelectionMode="Extended" SelectionUnit="Cell" ClipboardCopyMode="ExcludeHeader"
                  EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                  CanUserReorderColumns="False" CanUserResizeRows="False" CanUserResizeColumns="True" RowHeaderWidth="0"
                  HeadersVisibility="Column" GridLinesVisibility="All"
                  HorizontalGridLinesBrush="#E4E8EF" VerticalGridLinesBrush="#E4E8EF" Background="White"
                  BorderThickness="0"
                  AlternatingRowBackground="#F9FAFC" AlternationCount="2"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <DataGrid.Resources><Style TargetType="TextBox" BasedOn="{StaticResource TotalsPageEditor}"/></DataGrid.Resources>
            
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="*" MinWidth="190" SortMemberPath="name" IsReadOnly="True"
                                        CellStyle="{StaticResource TotalsArticleCell}"
                                        HeaderStyle="{StaticResource TotalsArticleHeader}" Header="Статья">
                    
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" ToolTip="{Binding NameTip}" Style="{StaticResource TotalsArticleText}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="190" SortMemberPath="cost"
                                        CellStyle="{StaticResource TotalsCostCell}"
                                        HeaderStyle="{StaticResource TotalsArticleHeader}" Header="Себестоимость (нам)">
                    
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CostText}" Style="{StaticResource TotalsArticleMoney}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding CostRaw, Mode=OneWay}" TextAlignment="Right"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Сумма — наш расход статьи. Пусто — не учитывается"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="190" SortMemberPath="sell"
                                        CellStyle="{StaticResource TotalsSellCell}"
                                        HeaderStyle="{StaticResource TotalsArticleHeader}" Header="Розница (клиенту)">
                    
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SellText}" Style="{StaticResource TotalsArticleMoney}"
                                       ToolTip="{Binding SellTip}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding SellRaw, Mode=OneWay}" TextAlignment="Right"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Сумма клиенту по статье (Enter — сохранить)"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="160" SortMemberPath="margin" IsReadOnly="True"
                                    CellStyle="{StaticResource TotalsArticleCell}"
                                    HeaderStyle="{StaticResource TotalsArticleHeader}"
                                    Binding="{Binding MarginText}" Header="Маржа">
                
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource TotalsArticleMargin}"/></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Width="100" SortMemberPath="pct" IsReadOnly="True"
                                    CellStyle="{StaticResource TotalsArticleCell}"
                                    HeaderStyle="{StaticResource TotalsArticleHeader}"
                                    Binding="{Binding PctText}"
                                    ElementStyle="{StaticResource TotalsArticleMargin}" Header="Маржа, %">
                
            </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        </local:SummaryTableFrame>
    </StackPanel>
    </ScrollViewer>
</Grid>
