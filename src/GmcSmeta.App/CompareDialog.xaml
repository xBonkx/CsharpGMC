<Window x:Class="GmcSmeta.App.CompareDialog" UseLayoutRounding="True" SnapsToDevicePixels="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GmcSmeta.App"
        Title="Сравнить документы" Width="1240" Height="780" MinWidth="960" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA"
        FontFamily="{StaticResource UiFontFamily}" FontSize="{StaticResource UiBodySize}"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}" Foreground="#0F172A">
    <Grid Margin="{StaticResource LayoutCompareDialogMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Что изменилось между документами" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="{StaticResource UiH2Size}"/>
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Было:" Foreground="{StaticResource UiMutedTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="ComboA" Grid.Column="1" MinWidth="0" SelectionChanged="Combo_Changed"/>
            <Button x:Name="SwapButton" Style="{StaticResource PythonToolbarButton}" Grid.Column="2" Content="" ContentTemplate="{StaticResource IconLabelRefresh}" MinWidth="34" MinHeight="34" AutomationProperties.Name="Поменять местами" Click="Swap_Click" Margin="8,0"
                    ToolTip="Поменять местами" Padding="8,2"/>
            <TextBlock Text="Стало:" Foreground="{StaticResource UiMutedTextBrush}" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="ComboB" Grid.Column="4" MinWidth="0" SelectionChanged="Combo_Changed"/>
        </Grid>
        <UniformGrid Grid.Row="2" Columns="4" Margin="0,10,0,0">
            <Border x:Name="TileCount" Margin="0,0,10,0" Style="{StaticResource PythonTile}">
                <StackPanel>
                    <TextBlock Text="Строки" Foreground="{StaticResource UiMutedTextBrush}" FontSize="{StaticResource UiCaptionSize}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TileCountValue" FontSize="{StaticResource UiValueSize}" FontWeight="Bold" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border x:Name="TileMat" Margin="0,0,10,0" Style="{StaticResource PythonTile}">
                <StackPanel>
                    <TextBlock Text="Материалы" Foreground="{StaticResource UiMutedTextBrush}" FontSize="{StaticResource UiCaptionSize}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TileMatValue" FontSize="{StaticResource UiValueSize}" FontWeight="Bold" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border x:Name="TileSmr" Margin="0,0,10,0" Style="{StaticResource PythonTile}">
                <StackPanel>
                    <TextBlock Text="СМР" Foreground="{StaticResource UiMutedTextBrush}" FontSize="{StaticResource UiCaptionSize}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TileSmrValue" FontSize="{StaticResource UiValueSize}" FontWeight="Bold" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="12" Padding="{StaticResource LayoutTilePadding}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2563EB" Offset="0"/>
                        <GradientStop Color="#4F46E5" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <TextBlock Text="ИТОГО с НДС" Foreground="#DBEAFE" FontSize="{StaticResource UiCaptionSize}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TileTotalValue" Foreground="White" FontSize="{StaticResource UiValueSize}" FontWeight="Bold" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </UniformGrid>
        <WrapPanel Grid.Row="3" Margin="0,10,0,0">
            <CheckBox x:Name="ShowSameCheck" Style="{StaticResource PythonFilterChip}" Content="Показывать строки без изменений" Checked="Refresh_Changed" Unchecked="Refresh_Changed" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <TextBlock Text="■ добавлено" Foreground="#047857" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Text="■ убрано" Foreground="#B91C1C" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Text="■ изменено" Foreground="#B45309" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </WrapPanel>
        <DataGrid local:TableColumnMenu.Key="compare" local:TableColumnMenu.Protect="Наименование" MinRowHeight="27"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto" HorizontalGridLinesBrush="#E4E8EF"
                  Background="#FFFFFF" BorderBrush="#E4E8EF" x:Name="CompareGrid" Grid.Row="4" Margin="0,10,0,0"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="All" RowHeaderWidth="0"
                  SelectionMode="Extended" SelectionUnit="FullRow" Style="{StaticResource DocumentTable}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Система" Binding="{Binding Sys}" Width="120" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*" MinWidth="160" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="60" ElementStyle="{StaticResource CompactCostCenter}" HeaderStyle="{StaticResource KsQuantityHeader}"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Qty}" Width="70" ElementStyle="{StaticResource CompactCostCenter}" HeaderStyle="{StaticResource KsQuantityHeader}"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="150" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                <DataGridTextColumn Header="Сумма было" Binding="{Binding SumA}" Width="130" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource ReportGridBeforeHeader}"/>
                <DataGridTextColumn Header="Сумма стало" Binding="{Binding SumB}" Width="130" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource ReportGridAfterHeader}"/>
                <DataGridTextColumn Header="Разница" Binding="{Binding Diff}" Width="120" ElementStyle="{StaticResource CompactCostStrongMoney}" HeaderStyle="{StaticResource ReportGridTotalsHeader}"/>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource PythonTableRow}">
                    <Setter Property="Background" Value="{Binding RowBackground}"/>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
        <Grid Grid.Row="5" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="InfoText" Foreground="{StaticResource UiMutedTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <Button x:Name="ExportButton" Grid.Column="1" Content="Сохранить в Excel" ContentTemplate="{StaticResource IconLabelDownload}" Click="Export_Click" Style="{StaticResource PythonToolbarButton}" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Style="{StaticResource PythonToolbarPrimary}" Content="Закрыть" IsCancel="True" Padding="18,6" FontWeight="SemiBold"/>
        </Grid>
    </Grid>
</Window>
