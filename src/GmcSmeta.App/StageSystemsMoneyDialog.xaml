<Window x:Class="GmcSmeta.App.StageSystemsMoneyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GmcSmeta.App"
        Title="СМР по системам" Width="690" Height="535"
        MinWidth="580" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="#F4F6FA" FontFamily="{StaticResource UiFontFamily}"
        FontSize="{StaticResource UiBodySize}">
    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="CaptionText" FontSize="16" FontWeight="SemiBold"
                   Margin="0,0,0,12" TextWrapping="Wrap"/>
        <DataGrid local:TableColumnMenu.Key="stage-systems-money" local:TableColumnMenu.Protect="Система" x:Name="SystemsGrid" Grid.Row="1" CanUserAddRows="False"
                  CanUserDeleteRows="False" AutoGenerateColumns="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0" EnableRowVirtualization="True"
                  BorderBrush="#E4E8EF" Background="White" Style="{StaticResource DocumentTable}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Система" Binding="{Binding Name}"
                                    Width="*" IsReadOnly="True" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                <DataGridTextColumn Header="СМР, ₽"
                    Binding="{Binding AmountText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                    Width="180" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}" EditingElementStyle="{StaticResource CompactCostMoneyEditor}"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="SummaryText" Grid.Row="2" Margin="0,10,0,0"
                   Foreground="#64748B" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Отмена" IsCancel="True" MinWidth="105"
                    Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="Сохранить" Click="Save_Click" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" MinWidth="120" Padding="12,6"/>
        </StackPanel>
    </Grid>
</Window>