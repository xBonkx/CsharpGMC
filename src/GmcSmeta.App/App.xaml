<Application x:Class="GmcSmeta.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/LayoutMetrics.xaml"/>
                <ResourceDictionary Source="Theme/TypographyMetrics.xaml"/>
                <ResourceDictionary Source="Theme/ToolbarIcons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <!-- Python selection palette, also used by default WPF controls and
             grids created in code. Focus loss must never restore white text. -->
        <SolidColorBrush x:Key="GridSelectionBrush" Color="#C9DBFB"/>
        <SolidColorBrush x:Key="GridSelectionTextBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="GridFocusBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#C9DBFB"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#C9DBFB"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A"/>
        <!-- Python theme.py uses points; WPF uses 96-DPI units (pt * 4/3). -->
        <FontFamily x:Key="UiFontFamily">Segoe UI Variable Text, Segoe UI Variable, Segoe UI</FontFamily>
        <sys:Double x:Key="UiBodySize">13.333333333333334</sys:Double>
        <sys:Double x:Key="UiCaptionSize">11.333333333333334</sys:Double>
        <sys:Double x:Key="UiSectionSize">10.666666666666666</sys:Double>
        <sys:Double x:Key="UiHeaderSize">12</sys:Double>
        <sys:Double x:Key="UiH1Size">24</sys:Double>
        <sys:Double x:Key="UiH2Size">16</sys:Double>
        <sys:Double x:Key="UiValueSize">20</sys:Double>
        <sys:Double x:Key="UiAppTitleSize">17.333333333333332</sys:Double>
        <Style x:Key="UiCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource UiCaptionSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource UiMutedTextBrush}"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource UiBodySize}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E4E8EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinRowHeight" Value="23"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E4E8EF"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E4E8EF"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ListChrome" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ListChrome" Property="Background" Value="#F9FAFC"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ListChrome" Property="Background" Value="#C9DBFB"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TreeView">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource UiBodySize}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource UiBodySize}"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Border x:Name="CheckChrome" BorderThickness="1" CornerRadius="4"
                                        Background="White" BorderBrush="#D0D7E2"/>
                                <Path x:Name="CheckMark" Data="M4,9 L7.5,12.5 L14,5.5" Stroke="White"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Visibility="Collapsed"/>
                                <Rectangle x:Name="MixedMark" Fill="White" Width="8" Height="2"
                                           RadiusX="1" RadiusY="1" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckChrome" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckChrome" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="CheckChrome" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="CheckChrome" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="CheckChrome" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="MixedMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CheckChrome" Property="BorderBrush" Value="#1E40AF"/>
                                <Setter TargetName="CheckChrome" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Python theme.py QComboBox: white, radius 8, thin border; hover/focus border, light dropdown. -->
        <Style TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource UiBodySize}"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D7E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#94A3B8"/></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#2563EB"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Background" Value="#F7F9FC"/><Setter Property="Foreground" Value="{StaticResource UiDisabledTextBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource UiBodySize}"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D7E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboChrome" Background="{TemplateBinding Background}" CornerRadius="8"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="SelectedContent" Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Left"
                                                      IsHitTestVisible="False"/>
                                    <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" Visibility="Collapsed"
                                             Background="Transparent" BorderThickness="0" Padding="{TemplateBinding Padding}"
                                             VerticalContentAlignment="Center" IsReadOnly="{TemplateBinding IsReadOnly}">
                                        <TextBox.Template>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                                                </Border>
                                            </ControlTemplate>
                                        </TextBox.Template>
                                    </TextBox>
                                    <Path Grid.Column="1" Data="M5,8 L10,13 L15,8" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" Stroke="#64748B" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Rectangle Fill="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade" Focusable="False"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" VerticalOffset="2">
                                <Border Margin="4,2,4,8" Background="White" BorderBrush="#E4E8EF" BorderThickness="1"
                                        CornerRadius="10" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#0F172A" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.16"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4,4">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="SelectedContent" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ToggleButton" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="ToggleButton" Property="Width" Value="24"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="ComboChrome" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="ComboChrome" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboChrome" Property="Background" Value="#F7F9FC"/>
                                <Setter Property="Foreground" Value="{StaticResource UiDisabledTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#0F172A"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemChrome" Background="Transparent" CornerRadius="6"
                                            Padding="10,5" Margin="0,0,0,1">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemChrome" Property="Background" Value="#E8F0FE"/>
                                            <Setter Property="Foreground" Value="#1E40AF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemChrome" Property="Background" Value="#E8F0FE"/>
                                            <Setter Property="Foreground" Value="#1E40AF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Python theme.py QMenu: white rounded card, soft shadow, items with blue hover.
             Replaces the default grey Windows menu (the user called it "устаревшая серая заливка
             с чёрной обводкой"). -->
        <!-- Shared card chrome for context, nested, sidebar and Actions popups. -->
        <Style x:Key="MenuPopupChrome" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E4E8EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="10,10,10,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F172A" BlurRadius="18" ShadowDepth="3"
                                      Direction="270" Opacity="0.18"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource UiBodySize}"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="HorizontalOffset" Value="-10"/>
            <Setter Property="VerticalOffset" Value="-6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Style="{StaticResource MenuPopupChrome}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MinHeight="0">
                                <StackPanel IsItemsHost="True" Grid.IsSharedSizeScope="True"
                                            KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Python QMenu::item: 7px 28px 7px 12px, radius 6, hover #E8F0FE / text #1E40AF,
             disabled #94A3B8. Roles: submenu items live in ContextMenu; TopLevelHeader — «☰» в сайдбаре. -->
        <Style TargetType="MenuItem">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource UiBodySize}"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemChrome" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" MinHeight="32">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuShortcut"/>
                                    <ColumnDefinition Width="16"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" x:Name="CheckGlyph" Width="18" Height="18"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphCheck}"
                                              Stroke="{TemplateBinding Foreground}"/>
                                    </Canvas>
                                </Viewbox>
                                <ContentPresenter Grid.Column="0" x:Name="IconHost" ContentSource="Icon"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                                <TextBlock Grid.Column="2" x:Name="ShortcutText" Text="{TemplateBinding InputGestureText}"
                                           Foreground="#64748B" Margin="18,0,0,0"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <Viewbox Grid.Column="3" x:Name="ArrowGlyph" Width="12" Height="12"
                                         HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphChevronRight}"
                                              Stroke="{TemplateBinding Foreground}"/>
                                    </Canvas>
                                </Viewbox>
                                <Popup x:Name="PART_Popup" AllowsTransparency="True"
                                       Placement="Right" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                       HorizontalOffset="-10" VerticalOffset="-10"
                                       Focusable="False" PopupAnimation="Fade"
                                       IsOpen="{TemplateBinding IsSubmenuOpen}">
                                    <Border Style="{StaticResource MenuPopupChrome}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel IsItemsHost="True" Grid.IsSharedSizeScope="True"
                                                        KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="ArrowGlyph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="ArrowGlyph" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ItemChrome" Property="Background" Value="Transparent"/>
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                                <Setter TargetName="PART_Popup" Property="HorizontalOffset" Value="-10"/>
                                <Setter TargetName="PART_Popup" Property="VerticalOffset" Value="-6"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="InputGestureText" Value="">
                                <Setter TargetName="ShortcutText" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="Icon" Value="{x:Null}">
                                <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#E8F0FE"/>
                                <Setter Property="Foreground" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#E8F0FE"/>
                                <Setter Property="Foreground" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource UiDisabledTextBrush}"/>
                                <Setter TargetName="ShortcutText" Property="Foreground" Value="{StaticResource UiDisabledTextBrush}"/>
                                <Setter TargetName="ItemChrome" Property="Background" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Padding" Value="12,7,12,7"/>
        </Style>
        <!-- Python QMenu::separator: 1px #E4E8EF, margin 5px 8px. -->
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Rectangle Height="1" Fill="#E4E8EF" Margin="8,5"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Separators inside plain StackPanels (Действия popup uses buttons, but Window menus may too). -->
        <Style x:Key="MenuSeparator" TargetType="Separator">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Rectangle Height="1" Fill="#E4E8EF" Margin="8,5"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource UiBodySize}"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
        </Style>
        <!-- Direct visual tokens from Python 0.66.4 ui/theme.py, QSS v3. -->
        <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentHover" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#E8F0FE"/>
        <SolidColorBrush x:Key="AccentText" Color="#1E40AF"/>
        <SolidColorBrush x:Key="PageSurface" Color="#F4F6FA"/>
        <SolidColorBrush x:Key="CardSurface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Muted" Color="#64748B"/>
        <SolidColorBrush x:Key="Line" Color="#E4E8EF"/>
        <SolidColorBrush x:Key="LineStrong" Color="#D0D7E2"/>
        <SolidColorBrush x:Key="TableHeaderSurface" Color="#F7F9FC"/>
        <SolidColorBrush x:Key="TableSystemSurface" Color="#F1F4F9"/>
        <SolidColorBrush x:Key="TableSubSystemSurface" Color="#E8F5FC"/>
        <!-- QScrollBar (theme.py): тонкая 11px полоса с прозрачным фоном и скруглённым
             бегунком #D0D7E2 (hover #94A3B8), без стрелок. Глобально, как qss в Python. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="11"/>
            <Setter Property="MinWidth" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                                <Track.Resources>
                                    <!-- WPF Track allocates half these values as its minimum thumb
                                         length. Thumb.MinHeight alone cannot reserve track space. -->
                                    <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">80</sys:Double>
                                    <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}">68</sys:Double>
                                </Track.Resources>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="PageBefore" Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="PageAfter" Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="ThumbElement">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbChrome" CornerRadius="4" Margin="2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#D0D7E2"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
                                                                    <Setter Property="Background" Value="#94A3B8"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
