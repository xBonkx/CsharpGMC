<UserControl x:Class="GmcSmeta.App.AgreementCardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Grid Margin="{StaticResource LayoutPageMargin}">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16">
   <Button Content="‹ К карточке договора" Style="{StaticResource PythonToolbarButton}" HorizontalAlignment="Left" Click="Back_Click" Margin="0,0,0,10"/>
   <TextBlock Text="Реквизиты договора" FontSize="{StaticResource UiH1Size}" FontWeight="Bold"/>
   <TextBlock x:Name="TitleText" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel x:Name="Fields" IsEnabled="False" MaxWidth="1100" HorizontalAlignment="Stretch">
    <Border Style="{StaticResource PythonTile}" Padding="18" Margin="0,0,0,12">
     <StackPanel>
      <TextBlock Text="Договор" FontSize="{StaticResource UiValueSize}" FontWeight="SemiBold"/>
      <TextBlock x:Name="AgreementText" TextWrapping="Wrap" Margin="0,8,0,4"/>
      <TextBlock x:Name="CompanyText" TextWrapping="Wrap"/>
      <TextBlock Text="Номер, дата и подрядчик пока берутся из приложений. При расхождениях исправьте реквизиты конкретных приложений; автоматического объединения нет." Foreground="#64748B" TextWrapping="Wrap" Margin="0,8,0,0"/>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource PythonTile}" Padding="18" Margin="0,0,0,12">
     <StackPanel>
      <TextBlock Text="Основные сведения" FontSize="{StaticResource UiValueSize}" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <TextBlock Text="Название карточки"/>
      <TextBox x:Name="NameBox" MinHeight="32" Margin="0,4,0,10"/>
      <Grid Margin="0,0,0,10">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,8,0"><TextBlock Text="Заказчик (кратко)"/><TextBox x:Name="CustomerBox" MinHeight="32" Margin="0,4,0,0"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Адрес"/><TextBox x:Name="AddressBox" MinHeight="32" Margin="0,4,0,0"/></StackPanel>
      </Grid>
      <TextBlock Text="Папка документов"/>
      <DockPanel Margin="0,4,0,10">
       <Button DockPanel.Dock="Right" Content="Обзор…" Style="{StaticResource PythonToolbarButton}" Click="Browse_Click" Margin="8,0,0,0"/>
       <TextBox x:Name="FolderBox" MinHeight="32"/>
      </DockPanel>
      <TextBlock Text="Тег заказчика"/>
      <ComboBox x:Name="TagBox" DisplayMemberPath="Caption" SelectedValuePath="Key" MinHeight="32" Margin="0,4,0,10"/>
      <TextBlock Text="Примечание"/>
      <TextBox x:Name="NoteBox" MinHeight="48" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,4,0,0"/>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource PythonTile}" Padding="18" Margin="0,0,0,12">
     <StackPanel>
      <TextBlock Text="Реквизиты для КС-2 и КС-3" FontSize="{StaticResource UiValueSize}" FontWeight="SemiBold"/>
      <TextBlock Text="Общие для всех приложений и ДС этой карточки. Используются при формировании новых выгрузок КС." Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,14"/>
      <TextBlock Text="Полное наименование заказчика с адресом"/>
      <TextBox x:Name="CustomerFullBox" MinHeight="50" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,4,0,10"/>
      <TextBlock Text="Стройка / объект строительства (для печати)"/>
      <TextBox x:Name="SiteFullBox" MinHeight="50" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,4,0,14"/>
      <TextBlock Text="Подписант заказчика" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <Grid Margin="0,0,0,12">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,8,0"><TextBlock Text="Организация"/><TextBox x:Name="CustOrgBox" MinHeight="32" Margin="0,4,0,0"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Должность"/><TextBox x:Name="CustPostBox" MinHeight="32" Margin="0,4,0,0"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="ФИО"/><TextBox x:Name="CustNameBox" MinHeight="32" Margin="0,4,0,0"/></StackPanel>
      </Grid>
      <TextBlock Text="Второй подписант (при необходимости)" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBlock Text="Роль"/>
      <TextBox x:Name="SecondRoleBox" MinHeight="32" Margin="0,4,0,10"/>
      <Grid Margin="0,0,0,12">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,8,0"><TextBlock Text="Организация"/><TextBox x:Name="SecondOrgBox" MinHeight="32" Margin="0,4,0,0"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Должность"/><TextBox x:Name="SecondPostBox" MinHeight="32" Margin="0,4,0,0"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="ФИО"/><TextBox x:Name="SecondNameBox" MinHeight="32" Margin="0,4,0,0"/></StackPanel>
      </Grid>
      <TextBlock Text="Наименование работ для КС-3"/>
      <TextBox x:Name="WorkTitleBox" MinHeight="32" Margin="0,4,0,10"/>
      <TextBlock Text="Дата начала работ (дд.мм.гггг)"/>
      <TextBox x:Name="WorksStartBox" MinHeight="32" Width="200" HorizontalAlignment="Left" Margin="0,4,0,0"/>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
  <DockPanel Grid.Row="2" Margin="0,12,0,0">
   <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Сохранить реквизиты" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="Save_Click" Margin="12,0,0,0"/>
   <TextBlock x:Name="StatusText" Foreground="#64748B" VerticalAlignment="Center" TextWrapping="Wrap"/>
  </DockPanel>
 </Grid>
</UserControl>
