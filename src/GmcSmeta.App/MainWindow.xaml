<Window x:Class="GmcSmeta.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GmcSmeta.App"
        Title="ГМЦ-Смета — C#"
        Height="880" Width="1480" MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterScreen" Background="#F4F6FA"
        FontFamily="{StaticResource UiFontFamily}" FontSize="{StaticResource UiBodySize}" Foreground="#0F172A"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">
        <!-- Без MaxWidth/MaxHeight по WorkArea: они обрезали развёрнутое окно до 1920×1040,
             и по правому/нижнему краю экрана оставалась чёрная полоса. Windows сам
             позиционирует развёрнутое окно с 8px «нахлёстом» за края — так он заполняет рабочую
             область ровно; ограничивать размер руками не нужно. -->
    <Window.Resources>
        <!-- Local single-line search: reserve icon space once, and let the text
             host measure its line at the current font scale instead of clipping it. -->
        <Style x:Key="SidebarSearch" TargetType="TextBox" BasedOn="{StaticResource PythonSearch}">
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          Margin="30,0,32,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="Chrome" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource UiDisabledTextBrush}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="#F7F9FC"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#E4E8EF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarIconButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonKeyboardFocusVisual}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E8F0FE"/><Setter Property="Foreground" Value="#1E40AF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#D9E6FD"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarHomeButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonKeyboardFocusVisual}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="{StaticResource UiAppTitleSize}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}"
                                CornerRadius="6" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#2563EB"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarMenuHeader" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonKeyboardFocusVisual}"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="8"
                                BorderBrush="Transparent" BorderThickness="1">
                            <Grid>
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                       PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                       HorizontalOffset="-10" VerticalOffset="-6" Focusable="False" PopupAnimation="Fade"
                                       IsOpen="{TemplateBinding IsSubmenuOpen}">
                                    <Border Style="{StaticResource MenuPopupChrome}" MinWidth="220">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter Grid.IsSharedSizeScope="True" KeyboardNavigation.DirectionalNavigation="Cycle"
                                                            KeyboardNavigation.TabNavigation="Cycle"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E8F0FE"/><Setter Property="Foreground" Value="#1E40AF"/></Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E8F0FE"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#BFD3FB"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavigationExpander" TargetType="ToggleButton">
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Width="16" Height="18">
                        <Viewbox Style="{StaticResource LayoutSmallAffordanceIcon}" HorizontalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="Chevron" Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphChevronRight}" Stroke="#64748B"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Data" Value="{StaticResource GlyphChevronDown}"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chevron" Property="Stroke" Value="#2563EB"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource UiBodySize}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0,7,4,7"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid>
                        <!-- Indent content, not the full-width selection background. -->
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border x:Name="HeaderBorder" Grid.Row="0" CornerRadius="6" Background="Transparent"
                                HorizontalAlignment="Stretch" SnapsToDevicePixels="True"
                                Padding="{TemplateBinding Padding}" MinHeight="31">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ToggleButton x:Name="Expander" Style="{StaticResource NavigationExpander}" Focusable="False" ClickMode="Press" VerticalAlignment="Center"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>
                        </Border>
                        <Border x:Name="SelectionMark" Grid.Row="0" Width="3" Background="#2563EB" CornerRadius="2,0,0,2"
                                HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0"
                                SnapsToDevicePixels="True" IsHitTestVisible="False" Visibility="Collapsed"/>
                        <Border x:Name="KeyboardFrame" Grid.Row="0" CornerRadius="6" BorderBrush="#2563EB" BorderThickness="1" IsHitTestVisible="False" Visibility="Collapsed"/>
                        <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" HorizontalAlignment="Stretch"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
                        <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/></Trigger>
                        <Trigger SourceName="HeaderBorder" Property="IsMouseOver" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="#F1F4F9"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="#E8F0FE"/>
                            <Setter TargetName="SelectionMark" Property="Visibility" Value="Visible"/>
                            <!-- Only the active header becomes semibold; never its descendants. -->
                            <Setter TargetName="PART_Header" Property="TextElement.FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="#1E40AF"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="KeyboardFrame" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="YearNavigationTemplate">
            <DockPanel>
                <Viewbox Style="{StaticResource LayoutNavigationIcon}" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Canvas Width="24" Height="24">
                        <Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphHistory}" Stroke="#64748B"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </DataTemplate>
        <Style x:Key="ObjectTileShadow" TargetType="Border">
            <Setter Property="Effect">
                <Setter.Value><DropShadowEffect Color="#0F172A" Opacity="0.063" BlurRadius="18" ShadowDepth="2" Direction="270"/></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DocumentCardButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonKeyboardFocusVisual}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource UiBodySize}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="MinHeight" Value="150"/>
            <Setter Property="MinWidth" Value="300"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="CardBorder" Background="White" BorderBrush="#E4E8EF" BorderThickness="1" CornerRadius="12" Padding="{StaticResource LayoutCardPadding}">
                        <Border.Effect>
                            <DropShadowEffect Color="#0F172A" Opacity="0.055" BlurRadius="20" ShadowDepth="2" Direction="270"/>
                        </Border.Effect>
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardBorder" Property="BorderBrush" Value="#2563EB"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="CardBorder" Property="Background" Value="#F9FAFC"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="DocumentCardTemplate">
            <Button Style="{StaticResource DocumentCardButton}" Click="DocumentCard_Click" Tag="{Binding Id}"
                    ContextMenuOpening="DocumentCard_ContextMenuOpening" ToolTip="Открыть смету; ПКМ — файлы документа"
                    AutomationProperties.Name="{Binding Title}"
                    Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=Window}}">
                <Button.ContextMenu><ContextMenu/></Button.ContextMenu>
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top">
                    <WrapPanel Margin="0,0,0,4">
                        <Border Background="#E8F0FE" CornerRadius="9" Padding="9,2"><TextBlock Text="{Binding DisplayKind}" Foreground="#1E40AF" FontSize="{StaticResource UiCaptionSize}" FontWeight="SemiBold"/></Border>
                        <Border Background="#F1F4F9" CornerRadius="9" Padding="9,2" Margin="6,0,0,0">
                            <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding TagName}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                            <TextBlock Text="{Binding TagName}" Foreground="#64748B" FontSize="{StaticResource UiCaptionSize}" TextWrapping="Wrap" MaxWidth="220" ToolTip="{Binding TagName}"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="{Binding DisplayTitle}" Style="{StaticResource UiWrappedHeading}" FontSize="{StaticResource UiH2Size}" FontWeight="SemiBold" ToolTip="{Binding Title}"/>
                    <TextBlock Text="{Binding BaseCaption}" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0">
                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding BaseTitle}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Meta}" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" ToolTip="{Binding Meta}"/>
                  </StackPanel>
                  <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="{Binding Total, StringFormat={}{0:N2} ₽}" FontSize="{StaticResource UiValueSize}" FontWeight="Bold" Margin="0,10,0,4" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SplitText}" Foreground="#64748B" TextWrapping="Wrap"/>
                    <StackPanel Margin="0,8,0,0">
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding ShowProgress}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style></StackPanel.Style>
                        <local:ContractProgressBar Height="8" SignedFraction="{Binding Progress.SignedFraction}" PendingFraction="{Binding Progress.PendingFraction}"/>
                        <UniformGrid Columns="3" Margin="0,4,0,0">
                            <StackPanel Margin="{StaticResource LayoutCardLegendGap}"><TextBlock Foreground="#64748B" FontSize="{StaticResource UiCaptionSize}" TextWrapping="Wrap"><Run Text="● " Foreground="#2563EB"/><Run Text="Подписано "/><Run Text="{Binding Progress.SignedPercent, Mode=OneWay}"/></TextBlock>
                                <TextBlock Text="{Binding Finance.Signed, StringFormat={}{0:N2}}" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
                            <StackPanel Margin="{StaticResource LayoutCardLegendGap}"><TextBlock Foreground="#64748B" FontSize="{StaticResource UiCaptionSize}" TextWrapping="Wrap"><Run Text="● " Foreground="#F59E0B"/><Run Text="На сдаче "/><Run Text="{Binding Progress.PendingPercent, Mode=OneWay}"/></TextBlock>
                                <TextBlock Text="{Binding Finance.Pending, StringFormat={}{0:N2}}" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
                            <StackPanel><TextBlock Text="○ Остаток" Foreground="#64748B" FontSize="{StaticResource UiCaptionSize}"/>
                                <TextBlock Text="{Binding Progress.Remaining, StringFormat={}{0:N2}}" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
                        </UniformGrid>
                    </StackPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <WrapPanel.Style><Style TargetType="WrapPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers><DataTrigger Binding="{Binding IsProposal}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                        </Style></WrapPanel.Style>
                        <Button Style="{StaticResource PythonToolbarButton}" Content="Подписанный PDF" ContentTemplate="{StaticResource IconLabelCheck}"
                                Tag="{Binding Id}" Click="CardSignedPdf_Click" Margin="0,0,0,4" ToolTip="Открыть основной подписанный PDF этого документа"/>
                        <Button Style="{StaticResource PythonToolbarButton}" Tag="{Binding Id}" Click="CardSignedPdfMenu_Click"
                                Padding="6,4" Margin="0,0,6,4" ToolTip="Добавить / выбрать подписанный PDF"
                                AutomationProperties.Name="Меню подписанного PDF">
                            <Viewbox Style="{StaticResource LayoutSmallAffordanceIcon}">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource GlyphChevronDown}" Style="{StaticResource SvgGlyphPath}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource PythonToolbarButton}" Content="Файлы" ContentTemplate="{StaticResource IconLabelFile}"
                                Tag="{Binding Id}" Click="CardFiles_Click" Margin="0,0,6,4" ToolTip="Файлы этого документа"/>
                        <Button Style="{StaticResource PythonToolbarButton}" Content="АОСР" ContentTemplate="{StaticResource IconLabelFile}"
                                Tag="{Binding Id}" Click="CardPto_Click" Margin="0,0,6,4"
                                Visibility="{Binding PtoModeVisibility, RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="Исполнительная документация этого документа"/>
                        <Button Style="{StaticResource PythonToolbarButton}" Content="Письма" ContentTemplate="{StaticResource IconLabelFile}"
                                Tag="{Binding Id}" Click="CardLetters_Click" Margin="0,0,0,4" ToolTip="Письма в контексте этого документа"/>
                    </WrapPanel>
                    <TextBlock Text="Предложение — ещё не договор" Foreground="#64748B" FontSize="{StaticResource UiCaptionSize}" FontWeight="SemiBold" Margin="0,6,0,0">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsProposal}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                  <Border/>
                </DockPanel>
            </Button>
        </DataTemplate>
        <!-- Python object_view.py NewCard: a dashed tile at the end of the same
             responsive WrapPanel, not a detached button below the grid. -->
        <Style x:Key="NewContractCardButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonKeyboardFocusVisual}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource UiBodySize}"/>
            <Setter Property="MinWidth" Value="300"/>
            <Setter Property="MinHeight" Value="150"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Rectangle x:Name="DashedOutline" RadiusX="12" RadiusY="12"
                                           Stroke="#D0D7E2" StrokeThickness="1.5"
                                           StrokeDashArray="4 3" SnapsToDevicePixels="True"/>
                                <ContentPresenter Margin="{StaticResource LayoutCardPadding}" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DashedOutline" Property="Stroke" Value="#2563EB"/>
                                <Setter Property="Background" Value="#F9FAFC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="NewDocumentCardTemplate">
            <Button Style="{StaticResource NewContractCardButton}" Click="ObjectNewContract_Click"
                    IsEnabled="{Binding CanCreate}"
                    AutomationProperties.Name="{Binding Caption}"
                    Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                    ToolTip="Создать документ или копию существующего">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Viewbox Width="28" Height="28" Stretch="Uniform" IsHitTestVisible="False" HorizontalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphPlus}" Stroke="#2563EB"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="{Binding Caption}" FontSize="{StaticResource UiH2Size}" FontWeight="SemiBold"
                               Foreground="#2563EB" TextAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="пустое или копия существующего"
                               Foreground="#64748B" FontSize="{StaticResource UiCaptionSize}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Button>
        </DataTemplate>
        <local:ObjectCardTemplateSelector x:Key="ObjectCardSelector"
                DocumentTemplate="{StaticResource DocumentCardTemplate}"
                NewDocumentTemplate="{StaticResource NewDocumentCardTemplate}"/>
        <DataTemplate x:Key="ObjectNavigationTemplate">
            <DockPanel>
                <Viewbox Style="{StaticResource LayoutNavigationIcon}" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Canvas Width="24" Height="24">
                        <Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphFolder}" Stroke="#64748B"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="DocumentNavigationTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="17"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Viewbox Style="{StaticResource LayoutNavigationIcon}" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphFile}" Stroke="#2563EB" x:Name="DocumentIcon"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" VerticalAlignment="Center" Margin="6,0,4,0"/>
                <!-- Python NavDelegate: 10pt body × 0.88 = 8.8pt (11.733 DIP). -->
                <Border x:Name="PhaseBadge" Grid.Column="2" Background="{Binding Document.PhaseColor}" CornerRadius="9" Width="17" Height="17"
                        Padding="0" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Document.PhaseNumber}" FontSize="11.733333333333333"
                               Foreground="White" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="3" Text="{Binding Document.NavigationDate}" Foreground="#64748B" FontSize="11.733333333333333"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Document.Kind}" Value="main"><Setter TargetName="DocumentIcon" Property="Stroke" Value="#15803D"/></DataTrigger>
                <DataTrigger Binding="{Binding Document.Kind}" Value="dop"><Setter TargetName="DocumentIcon" Property="Stroke" Value="#B45309"/></DataTrigger>
                <DataTrigger Binding="{Binding IconRole}" Value="Stage">
                    <Setter TargetName="DocumentIcon" Property="Data" Value="{StaticResource GlyphStage}"/>
                    <Setter TargetName="DocumentIcon" Property="Stroke" Value="#2563EB"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IconRole}" Value="Remainder">
                    <Setter TargetName="DocumentIcon" Property="Data" Value="{StaticResource GlyphStage}"/>
                    <Setter TargetName="DocumentIcon" Property="Stroke" Value="#64748B"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IconRole}" Value="Parent">
                    <Setter TargetName="DocumentIcon" Property="Data" Value="{StaticResource GlyphLayers}"/>
                    <Setter TargetName="DocumentIcon" Property="Stroke" Value="#2563EB"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Document.PhaseNumber}" Value=""><Setter TargetName="PhaseBadge" Property="Visibility" Value="Collapsed"/></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ReportGridHeader}">
            <Setter Property="Background" Value="#F7F9FC"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="{StaticResource UiHeaderSize}"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="BorderBrush" Value="#D0D7E2"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="ToolTip" Value="{Binding Title}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EBF4FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#C9DBFB"/>
                    <Setter Property="Foreground" Value="#1A365D"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell" BasedOn="{StaticResource PythonGridCell}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>
    </Window.Resources>
    <DockPanel x:Name="RootLayout" Background="#F4F6FA">
        <!-- Status values remain available to diagnostics, but never reserve workspace height. -->
        <Grid Visibility="Collapsed">
            <TextBlock x:Name="StatusText"/>
            <TextBlock x:Name="DatabaseLabel"/>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="300" MinWidth="270"/>
                <ColumnDefinition x:Name="SplitterColumn" Width="1"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="Sidebar" Background="#FBFCFE" BorderThickness="0" Padding="{StaticResource LayoutSidebarPadding}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel Margin="{StaticResource LayoutSidebarSectionGap}">
                            <Button x:Name="SidebarCollapseButton" DockPanel.Dock="Right" VerticalAlignment="Center"
                                    Style="{StaticResource SidebarIconButton}" ToolTip="Спрятать панель (Ctrl+B)"
                                    AutomationProperties.Name="Спрятать панель" Click="ToggleSidebar_Click">
                                <Viewbox Width="18" Height="18" Stretch="Uniform" IsHitTestVisible="False">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphChevronLeft}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Menu DockPanel.Dock="Right" Background="Transparent" VerticalAlignment="Center" Margin="0,0,4,0">
                                <MenuItem x:Name="MainMenuItem" Style="{StaticResource SidebarMenuHeader}" ToolTip="Меню: справочник, организации, маржа, настройки" AutomationProperties.Name="Меню">
                                    <MenuItem.Header>
                                        <Viewbox Width="20" Height="20" Stretch="Uniform" IsHitTestVisible="False">
                                            <Canvas Width="24" Height="24">
                                                <Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphMenu}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}"/>
                                            </Canvas>
                                        </Viewbox>
                                    </MenuItem.Header>
                                    <MenuItem x:Name="LettersMenuItem" Header="Письма" Click="Letters_Click"/>
                                    <MenuItem x:Name="MetalRegisterMenuItem" Header="Учёт металла" Click="MetalRegister_Click"/>
                                    <MenuItem x:Name="MetalWarehouseMenuItem" Header="Склад металла" Click="MetalWarehouse_Click"/>
                                    <Separator/>
                                    <MenuItem x:Name="PtoModeToggle" Header="Режим ПТО (локальная настройка)" IsCheckable="True" Click="PtoMode_Click"/>
                                    <MenuItem x:Name="PtoMenuItem" Header="Исполнительная документация (АОСР / ПТО)" Click="Pto_Click" Visibility="Collapsed"/>
                                </MenuItem>
                            </Menu>
                            <Button x:Name="SidebarBrandButton" Style="{StaticResource SidebarHomeButton}" VerticalAlignment="Center"
                                    Click="Home_Click" ToolTip="На главную: сводка по договорам и группам">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="28" Height="28" Stretch="Uniform" IsHitTestVisible="False" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphLayers}" Stroke="#2563EB"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="ГМЦ-Смета" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>
                        <Grid Margin="{StaticResource LayoutSidebarSectionGap}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="NewObjectButton" Content="Новый договор" ContentTemplate="{StaticResource IconLabelPlus}" Click="NewObject_Click" ToolTip="Создать карточку договора (Ctrl+N)"
                                    Style="{StaticResource PrimaryButton}" Padding="5,4" MinHeight="32"/>
                            <Button x:Name="SidebarImportButton" Grid.Column="2" Style="{StaticResource PythonToolbarButton}"
                                    BorderBrush="#D0D7E2" Padding="5,4"
                                    Content="Из Excel" ContentTemplate="{StaticResource IconLabelUpload}"
                                    IsEnabled="{Binding IsEnabled, ElementName=NewObjectButton}"
                                    ToolTip="Загрузить КП из Excel (Ctrl+I)" Click="ImportExcelFromObject_Click"/>
                        </Grid>
                        <Grid Margin="{StaticResource LayoutSidebarSectionGap}">
                            <TextBox x:Name="ObjectSearch" Style="{StaticResource SidebarSearch}"
                                     AutomationProperties.Name="Поиск договора"
                                     ToolTip="Договор, приложение или КП: несколько слов в любом порядке. Esc — очистить; Ctrl+P — поиск по всей базе."
                                     TextChanged="ObjectSearch_TextChanged" KeyDown="ObjectSearch_KeyDown"/>
                            <Viewbox Style="{StaticResource LayoutSmallSearchIcon}" HorizontalAlignment="Left" Margin="9,0,0,0" IsHitTestVisible="False">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphSearch}" Stroke="#64748B"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="NavigationSearchPlaceholder" Text="Поиск договора…" Margin="30,0,32,0" Foreground="#64748B"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ObjectSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button x:Name="ClearNavigationSearchButton" Content="Очистить" ContentTemplate="{StaticResource IconOnlyX}" HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Margin="0,0,2,0"
                                    ToolTip="Очистить поиск договора" AutomationProperties.Name="Очистить поиск договора"
                                    Click="ClearObjectSearch_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PythonToolbarButton}">
                                        <Setter Property="MinHeight" Value="26"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=ObjectSearch}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                        <Border Background="#F1F4F9" BorderBrush="#E4E8EF" BorderThickness="1" CornerRadius="11" Padding="3" Margin="{StaticResource LayoutSidebarSectionGap}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="11*"/>
                                <ColumnDefinition Width="7*"/>
                                <ColumnDefinition Width="8*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0" x:Name="ContractsMode" Content="Договоры" GroupName="Navigation" IsChecked="True" Checked="Navigation_Checked" Style="{StaticResource Segment}" Margin="0,0,2,0"/>
                            <RadioButton Grid.Column="1" x:Name="KpMode" Content="КП" GroupName="Navigation" Checked="Navigation_Checked" Style="{StaticResource Segment}" Margin="0,0,2,0"/>
                            <RadioButton Grid.Column="2" x:Name="ArchiveMode" Content="Архив" GroupName="Navigation" Checked="Navigation_Checked" Style="{StaticResource Segment}"/>
                        </Grid>
                        </Border>
                    </StackPanel>
                    <TreeView x:Name="NavigationTree" BorderThickness="0" Background="Transparent" Padding="0"
                              HorizontalContentAlignment="Stretch" SnapsToDevicePixels="True"
                              SelectedItemChanged="NavigationTree_SelectedItemChanged"
                              ContextMenuOpening="NavigationTree_ContextMenuOpening"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </DockPanel>
            </Border>
            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="5" Margin="-2,0,-2,0"
                          Grid.ZIndex="2" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent"
                          AutomationProperties.Name="Изменить ширину панели объектов">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border x:Name="Divider" Width="1" HorizontalAlignment="Center" Background="#E4E8EF"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Divider" Property="Background" Value="#94A3B8"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Divider" Property="Background" Value="#2563EB"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <!-- The tab strip switches two retained workspace surfaces; the estimate is not reparented. -->
                <TabControl x:Name="AuxWorkspaceTabs" Visibility="Collapsed" SelectedIndex="0"
                            Style="{StaticResource PythonTabbedPane}" SelectionChanged="AuxWorkspaceTabs_SelectionChanged">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <TabPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </ControlTemplate>
                    </TabControl.Template>
                    <TabItem x:Name="DocumentsWorkspaceTab" Header="Договоры и КП"/>
                    <TabItem x:Name="PeopleWorkspaceTab" Header="Люди и автомобили"/>
                </TabControl>
                <Grid x:Name="DocumentsWorkspaceSurface" Grid.Row="1">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Button x:Name="ShowSidebarButton" Style="{StaticResource PythonToolbarButton}" Content="Показать объекты" ContentTemplate="{StaticResource IconLabelMenu}" Visibility="Collapsed" HorizontalAlignment="Left"
                        MinWidth="148" MinHeight="30" Margin="{StaticResource LayoutShowSidebarMargin}" Click="ToggleSidebar_Click" ToolTip="Показать панель (Ctrl+B)"/>
                <Grid x:Name="EmptyPage" Grid.Row="1" Visibility="Collapsed" Margin="16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="1">
                        <Viewbox Width="44" Height="44" Stretch="Uniform" IsHitTestVisible="False" Margin="0,0,0,12" HorizontalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphLayers}" Stroke="#2563EB"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="EmptyNavigationHeading" Text="Выберите договор или КП слева" FontSize="{StaticResource UiH1Size}" FontWeight="Bold"
                                   TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock x:Name="EmptyNavigationHint" Text="или создайте новый: соберите КП в конструкторе или загрузите готовое из Excel."
                                   Foreground="#64748B" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,14"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" IsEnabled="{Binding IsEnabled, ElementName=NewObjectButton}">
                            <Button Content="Загрузить КП из Excel" Style="{StaticResource PythonToolbarButton}" Click="ImportExcelFromObject_Click" Margin="0,0,6,0"/>
                            <Button x:Name="EmptyNewObjectButton" Content="Новый договор" Style="{StaticResource PrimaryButton}" Click="NewObject_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <ContentControl x:Name="PageHost" Grid.Row="1">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <Trigger Property="Content" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.Content>
                        <Grid x:Name="ObjectPage" Margin="{StaticResource LayoutPageMargin}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,16">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,4">
                                        <Button x:Name="ObjectNewKpButton" Content="Новое КП" ContentTemplate="{StaticResource IconLabelPlus}" Click="ObjectNewContract_Click"
                                                Style="{StaticResource PrimaryButton}" Visibility="Collapsed" Margin="0,0,8,0"
                                                ToolTip="Создать КП: пустое или копию существующего"/>
                                        <Button x:Name="ObjectPropertiesButton" Style="{StaticResource PythonToolbarButton}" Content="Свойства" Click="ObjectProperties_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
                                        <Button x:Name="ObjectMoreButton" Style="{StaticResource PythonToolbarButton}" Content="Ещё" ContentTemplate="{StaticResource IconOnlyMore}" Padding="7,4" MinWidth="32" ToolTip="Ещё"
                                                AutomationProperties.Name="Ещё" Click="ObjectMore_Click" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ObjectCrumb" Text="Объект" Foreground="#64748B" Margin="0,0,0,4" Visibility="Collapsed"/>
                                </DockPanel>
                                <DockPanel HorizontalAlignment="Left" LastChildFill="True">
                                    <Button x:Name="ObjectRenameButton" Style="{StaticResource PythonToolbarButton}" DockPanel.Dock="Right" Content="Переименовать" ContentTemplate="{StaticResource IconOnlyEdit}" AutomationProperties.Name="Переименовать объект" ToolTip="Переименовать объект"
                                            Click="ObjectRename_Click" Visibility="Collapsed" Margin="4,0,0,0" Padding="4,2" MinHeight="26" MinWidth="26" Background="Transparent" BorderBrush="Transparent"/>
                                    <TextBlock x:Name="ObjectTitle" FontSize="{StaticResource UiH1Size}" FontWeight="Bold" Text="Объекты" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                               Cursor="Hand" MouseLeftButtonDown="ObjectTitle_MouseDown"/>
                                </DockPanel>
                                <TextBox x:Name="ObjectRenameBox" Style="{StaticResource PythonSearch}" Visibility="Collapsed" FontSize="{StaticResource UiValueSize}" FontWeight="Bold"
                                         Padding="8,2" MinWidth="260" MaxWidth="640" Margin="0,2,0,0"
                                         KeyDown="ObjectRenameBox_KeyDown" LostFocus="ObjectRenameBox_LostFocus"/>
                                <TextBlock x:Name="ObjectSubtitle" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Grid x:Name="ObjectTotals" Grid.Row="1" Visibility="Collapsed" Margin="0,0,12,14">
                                <Border x:Name="ObjectTotalCard" Style="{StaticResource ObjectTileShadow}" MinHeight="78" CornerRadius="12" Padding="{StaticResource LayoutTilePadding}" Margin="0,0,10,0">
                                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2563EB" Offset="0"/><GradientStop Color="#4F46E5" Offset="1"/></LinearGradientBrush></Border.Background>
                                    <StackPanel>
                                    <TextBlock x:Name="ObjectTotalCaption" Text="Итого по группе" Foreground="White" FontSize="{StaticResource UiCaptionSize}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ObjectTotalValue" Foreground="White" FontSize="{StaticResource UiValueSize}" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="ObjectTotalSub" Foreground="#DBEAFE" FontSize="{StaticResource UiCaptionSize}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                                </StackPanel></Border>
                                <Border x:Name="ObjectProgressCard" Style="{StaticResource ObjectTileShadow}" MinHeight="78" Background="White" BorderBrush="#E4E8EF" BorderThickness="1" CornerRadius="12" Padding="{StaticResource LayoutTilePadding}"><StackPanel>
                                    <TextBlock Text="Выполнение по КС" Style="{StaticResource UiCaption}"/>
                                    <TextBlock Text="{Binding Progress.Caption}" FontSize="{StaticResource UiValueSize}" FontWeight="Bold" Margin="0,4,0,6" TextWrapping="Wrap"/>
                                    <local:ContractProgressBar Height="8" SignedFraction="{Binding Progress.SignedFraction}" PendingFraction="{Binding Progress.PendingFraction}"/>
                                    <TextBlock Text="{Binding Progress.Legend}" Foreground="#64748B" FontSize="{StaticResource UiCaptionSize}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel></Border>
                                <Border x:Name="ObjectMaterialsCard" Style="{StaticResource ObjectTileShadow}" MinHeight="78" Background="White" BorderBrush="#E4E8EF" BorderThickness="1" CornerRadius="12" Padding="{StaticResource LayoutTilePadding}" Margin="0,0,10,0"><StackPanel>
                                    <TextBlock x:Name="ObjectMaterialsCaption" Text="Материалы" Style="{StaticResource UiCaption}"/>
                                    <TextBlock x:Name="ObjectMaterialsValue" FontSize="{StaticResource UiValueSize}" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel></Border>
                                <Border x:Name="ObjectSmrCard" Style="{StaticResource ObjectTileShadow}" MinHeight="78" Background="White" BorderBrush="#E4E8EF" BorderThickness="1" CornerRadius="12" Padding="{StaticResource LayoutTilePadding}"><StackPanel>
                                    <TextBlock x:Name="ObjectSmrCaption" Text="СМР" Style="{StaticResource UiCaption}"/>
                                    <TextBlock x:Name="ObjectSmrValue" FontSize="{StaticResource UiValueSize}" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel></Border>
                                <Border x:Name="ObjectEarnedCard" Style="{StaticResource ObjectTileShadow}" MinHeight="78" Background="White" BorderBrush="#E4E8EF" BorderThickness="1" CornerRadius="12" Padding="{StaticResource LayoutTilePadding}" ToolTip="{Binding EarnedNotes}"><StackPanel>
                                    <TextBlock Text="{Binding EarnedCaption}" Style="{StaticResource UiCaption}"/>
                                    <TextBlock Text="{Binding EarnedText}" FontSize="{StaticResource UiValueSize}" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel></Border>
                            </Grid>
                            <TextBlock x:Name="ObjectDocumentsCaption" Text="ДОКУМЕНТЫ" Foreground="#64748B" FontSize="{StaticResource UiSectionSize}" FontWeight="Bold" Grid.Row="2" Margin="0,0,0,10"/>
                            <TextBlock x:Name="ObjectCardsStatus" Grid.Row="3" Foreground="#64748B" TextWrapping="Wrap" Visibility="Collapsed"/>
                            <ScrollViewer x:Name="ObjectCardsScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed" SizeChanged="ObjectCards_SizeChanged" ScrollChanged="ObjectCards_ScrollChanged">
                                <ItemsControl x:Name="DocumentCards" ItemTemplateSelector="{StaticResource ObjectCardSelector}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                            <Border x:Name="ObjectDocumentTools" Grid.Row="4" Style="{StaticResource PythonTile}"
                                    Padding="16,10" Margin="0,10,12,0" Visibility="Collapsed"
                                    IsEnabled="{Binding IsEnabled, ElementName=ObjectMoreButton}">
                                <StackPanel>
                                    <TextBlock x:Name="ObjectToolsCaption" Text="Документы группы" Style="{StaticResource UiCaption}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <WrapPanel>
                                        <Button Content="АОСР" Style="{StaticResource PythonToolbarButton}" Click="ObjectPto_Click" Margin="0,0,8,3"
                                                Visibility="{Binding Visibility, ElementName=PtoMenuItem}" ToolTip="Исполнительная документация по объекту"/>
                                        <Button Content="Письма" Style="{StaticResource PythonToolbarButton}" Click="ObjectLetters_Click" Margin="0,0,8,3"/>
                                        <Button Content="Допуск" Style="{StaticResource PythonToolbarButton}" Click="ObjectAccess_Click" Margin="0,0,8,3"/>
                                        <Button Content="Приказы" Style="{StaticResource PythonToolbarButton}" Click="ObjectOrders_Click" Margin="0,0,8,3"/>
                                        <Button Content="Паспорта" Style="{StaticResource PythonToolbarButton}" Click="ObjectPassports_Click" Margin="0,0,0,3"
                                                ToolTip="Паспорта вентиляционных систем объекта"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ContentControl.Content>
                </ContentControl>
                </Grid>
                <ContentControl x:Name="PeopleWorkspaceHost" Grid.Row="1" Visibility="Collapsed"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
