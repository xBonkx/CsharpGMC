<UserControl x:Class="GmcSmeta.App.DirectorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GmcSmeta.App"
        Background="#F4F6FA"
        FontFamily="{StaticResource UiFontFamily}" FontSize="{StaticResource UiBodySize}"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="DirectorBoolVisibility"/>
        <Style x:Key="DirectorExportButton" TargetType="Button" BasedOn="{StaticResource PythonToolbarButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="9,6"/>
        </Style>
        <Style x:Key="DirectorHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ReportGridHeader}">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="ContentTemplate">
                <Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextAlignment="Center" TextWrapping="Wrap"/></DataTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DirectorObjectHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DirectorHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="ContentTemplate">
                <Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextAlignment="Left" TextWrapping="Wrap"/></DataTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DirectorTableFrame" TargetType="Border" BasedOn="{StaticResource PythonTile}">
            <Setter Property="BorderBrush" Value="#E4E8EF"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Effect">
                <Setter.Value><DropShadowEffect Color="#0F172A" Opacity="0.047" BlurRadius="20" ShadowDepth="2" Direction="270"/></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DirectorCell" TargetType="DataGridCell" BasedOn="{StaticResource PythonGridCell}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>
        <Style x:Key="DirectorRow" TargetType="DataGridRow" BasedOn="{StaticResource PythonTableRow}">
            <Setter Property="MinHeight" Value="{Binding MinRowHeight, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="#F9FAFC"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F1F4F9"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource GridSelectionBrush}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DirectorText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="DirectorMoney" TargetType="TextBlock" BasedOn="{StaticResource DirectorText}">
            <Setter Property="TextAlignment" Value="Right"/>
            <Style.Triggers><DataTrigger Binding="{Binding KpOnly}" Value="True"><Setter Property="Foreground" Value="#64748B"/></DataTrigger><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Value="True"><Setter Property="Foreground" Value="{StaticResource GridSelectionTextBrush}"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="DirectorCenter" TargetType="TextBlock" BasedOn="{StaticResource DirectorMoney}">
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DirectorCoverage" TargetType="TextBlock" BasedOn="{StaticResource DirectorCenter}">
            
            <Style.Triggers>
                <DataTrigger Binding="{Binding IncompleteCoverage}" Value="True"><Setter Property="Foreground" Value="#B45309"/></DataTrigger>
                <DataTrigger Binding="{Binding KpOnly}" Value="True"><Setter Property="Foreground" Value="#64748B"/></DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Value="True"><Setter Property="Foreground" Value="{StaticResource GridSelectionTextBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DirectorExtra" TargetType="TextBlock" BasedOn="{StaticResource DirectorMoney}">
            
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasExtra}" Value="True"><Setter Property="Foreground" Value="#DC2626"/></DataTrigger>
                <DataTrigger Binding="{Binding KpOnly}" Value="True"><Setter Property="Foreground" Value="#64748B"/></DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Value="True"><Setter Property="Foreground" Value="{StaticResource GridSelectionTextBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DirectorEarned" TargetType="TextBlock" BasedOn="{StaticResource DirectorMoney}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding NegativeEarned}" Value="True"><Setter Property="Foreground" Value="#DC2626"/></DataTrigger>
                <DataTrigger Binding="{Binding KpOnly}" Value="True"><Setter Property="Foreground" Value="#64748B"/></DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Value="True"><Setter Property="Foreground" Value="{StaticResource GridSelectionTextBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DirectorLate" TargetType="TextBlock" BasedOn="{StaticResource DirectorCenter}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasLate}" Value="True"><Setter Property="Foreground" Value="#DC2626"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="ToolTip" Value="Поставки, которые не пришли в срок. Откройте карточку → «Закупки» → «Просрочено»."/></DataTrigger>
                <DataTrigger Binding="{Binding KpOnly}" Value="True"><Setter Property="Foreground" Value="#64748B"/></DataTrigger><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Value="True"><Setter Property="Foreground" Value="{StaticResource GridSelectionTextBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DirectorObjectText" TargetType="TextBlock" BasedOn="{StaticResource DirectorText}">
            <Setter Property="ToolTip" Value="{Binding WarningTip}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding KpOnly}" Value="True"><Setter Property="Foreground" Value="#64748B"/></DataTrigger>
                <DataTrigger Binding="{Binding Incomplete}" Value="True"><Setter Property="Foreground" Value="#B45309"/></DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Value="True"><Setter Property="Foreground" Value="{StaticResource GridSelectionTextBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Python ProgressDelegate: 4 DIP track, blue until 99.5%, then green. -->
        <Style x:Key="DirectorProgressTrack" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Height" Value="4"/>
            <Setter Property="Margin" Value="4,3,4,0"/>
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="Background" Value="#F1F4F9"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2"/>
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2"/>
                    </Grid>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="{StaticResource LayoutPageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Главная" Foreground="#64748B" FontSize="{StaticResource UiBodySize}" Margin="0,0,0,2" VerticalAlignment="Center"/>
                <TextBlock x:Name="HeadingText" Text="Договоры и группы — в работе" FontWeight="Bold" FontSize="{StaticResource UiH1Size}" TextWrapping="Wrap"/>
            </StackPanel>
            <Button x:Name="ExportButton" Grid.Column="1" Content="Сохранить в Excel" Click="Export_Click"
                    VerticalAlignment="Bottom" Style="{StaticResource DirectorExportButton}" ContentTemplate="{StaticResource IconLabelDownload}" ToolTip="Сохранить сводку в Excel"/>
        </Grid>
        <ComboBox x:Name="ModeCombo" Grid.Row="1" Margin="{StaticResource LayoutDirectorSectionGap}" HorizontalAlignment="Stretch" SelectionChanged="Mode_Changed">
            <ComboBoxItem Content="Договоры — в работе" Tag="contracts" IsSelected="True"/>
            <ComboBoxItem Content="КП — просчёты (последнее КП по карточке)" Tag="kp"/>
        </ComboBox>
        <UniformGrid x:Name="DirectorTiles" Grid.Row="2" Columns="4" Margin="{StaticResource LayoutDirectorTilesInset}" SizeChanged="DirectorTiles_SizeChanged">
            <Border Margin="{StaticResource LayoutDirectorTileInset}" Style="{StaticResource PythonTile}">
                <StackPanel>
                    <TextBlock x:Name="TileTotalCaption" Text="Договоры всего, с НДС" Style="{StaticResource PythonTileLabel}"/>
                    <TextBlock x:Name="TileTotalValue" Style="{StaticResource PythonTileValue}"/>
                </StackPanel>
            </Border>
            <Border x:Name="TileClosed" Margin="{StaticResource LayoutDirectorTileInset}" Style="{StaticResource PythonTile}">
                <StackPanel>
                    <TextBlock Text="Сдано по КС" Style="{StaticResource PythonTileLabel}"/>
                    <TextBlock x:Name="TileClosedValue" Style="{StaticResource PythonTileValue}"/>
                </StackPanel>
            </Border>
            <Border x:Name="TileExtra" Margin="{StaticResource LayoutDirectorTileInset}" Style="{StaticResource PythonTile}">
                <StackPanel>
                    <TextBlock Text="Докуплено вне сметы" Style="{StaticResource PythonTileLabel}"/>
                    <TextBlock x:Name="TileExtraValue" Style="{StaticResource PythonTileValue}"/>
                </StackPanel>
            </Border>
            <Border Margin="{StaticResource LayoutDirectorTileInset}" Style="{StaticResource PythonTileAccent}">
                <StackPanel>
                    <TextBlock x:Name="TileEarnedCaption" Text="Заработано (материалы + монтаж)" Style="{StaticResource PythonTileLabel}" Foreground="#DBEAFE"/>
                    <TextBlock x:Name="TileEarnedValue" Style="{StaticResource PythonTileValue}" Foreground="White"/>
                </StackPanel>
            </Border>
        </UniformGrid>
        <Border Grid.Row="3" Margin="{StaticResource LayoutDirectorSectionGap}" Style="{StaticResource DirectorTableFrame}">
            <!-- Outer border owns shadow and stroke; the inner clip keeps scrolling content inside the rounded corners. -->
            <local:SummaryTableFrame Background="White" CornerRadius="11" BorderThickness="0">
            <DataGrid local:TableColumnMenu.Key="director" local:TableColumnMenu.Exclude="Сдано по КС|Докуплено вне сметы|Выдано на объект|Просрочено поставок|Закуп известен" local:TableColumnMenu.Protect="Карточка" x:Name="DirectorGrid" CellStyle="{StaticResource DirectorCell}" ColumnHeaderStyle="{StaticResource DirectorHeader}"
                      RowStyle="{StaticResource DirectorRow}" MinRowHeight="40" AlternationCount="2" Background="White" BorderThickness="0"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      HorizontalGridLinesBrush="#E4E8EF" VerticalGridLinesBrush="#E4E8EF"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="All" RowHeaderWidth="0"
                      CanUserResizeRows="False" CanUserResizeColumns="True" CanUserSortColumns="True"
                      SelectionMode="Single" SelectionUnit="FullRow" MouseDoubleClick="Grid_DoubleClick"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Карточка" Width="3*" MinWidth="180" HeaderStyle="{StaticResource DirectorObjectHeader}" SortMemberPath="DisplayObject">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <DockPanel LastChildFill="True" ToolTip="{Binding WarningTip}">
                                <!-- director_view.py uses the literal warning character, not an SVG. -->
                                <TextBlock DockPanel.Dock="Left" Text="⚠" Margin="0,0,4,0"
                                           Visibility="{Binding Incomplete, Converter={StaticResource DirectorBoolVisibility}}"
                                           Style="{StaticResource DirectorObjectText}" AutomationProperties.Name="Неполные данные"/>
                                <TextBlock Text="{Binding DisplayObject}" Style="{StaticResource DirectorObjectText}"/>
                            </DockPanel>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Итого,&#10;₽" Binding="{Binding Total}" Width="1.3*" MinWidth="114" ElementStyle="{StaticResource DirectorMoney}" SortMemberPath="TotalValue" x:Name="TotalColumn"/>
                    <DataGridTemplateColumn x:Name="ClosedColumn" Header="Сдано&#10;по КС" Width="1.5*" MinWidth="137" SortMemberPath="ClosedValue">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Closed}" Style="{StaticResource DirectorMoney}"/>
                                <ProgressBar Value="{Binding ClosedBarValue, Mode=OneWay}" Visibility="{Binding HasClosedProgress, Converter={StaticResource DirectorBoolVisibility}}">
                                    <ProgressBar.Style><Style TargetType="ProgressBar" BasedOn="{StaticResource DirectorProgressTrack}">
                                        <Style.Triggers><DataTrigger Binding="{Binding ClosedComplete}" Value="True"><Setter Property="Foreground" Value="#15803D"/></DataTrigger></Style.Triggers>
                                    </Style></ProgressBar.Style>
                                </ProgressBar>
                            </StackPanel>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Маржа:&#10;материалы" Binding="{Binding Margin}" Width="1.6*" MinWidth="137" ElementStyle="{StaticResource DirectorMoney}" SortMemberPath="MarginValue"/>
                    <DataGridTextColumn Header="Закуп&#10;известен" Binding="{Binding Coverage}" Width="1.0*" MinWidth="78" ElementStyle="{StaticResource DirectorCoverage}" SortMemberPath="CoverageValue" x:Name="CoverageColumn"/>
                    <DataGridTextColumn Header="Маржа:&#10;монтаж" Binding="{Binding SmrMargin}" Width="1.2*" MinWidth="110" ElementStyle="{StaticResource DirectorMoney}" SortMemberPath="SmrMarginValue"/>
                    <DataGridTextColumn Header="Докуплено&#10;вне сметы" Binding="{Binding OutCost}" Width="1.3*" MinWidth="110" ElementStyle="{StaticResource DirectorExtra}" SortMemberPath="OutCostValue" x:Name="ExtraColumn"/>
                    <DataGridTextColumn Header="Заработано" Binding="{Binding Earned}" Width="1.3*" MinWidth="114" ElementStyle="{StaticResource DirectorEarned}" SortMemberPath="EarnedValue" x:Name="EarnedColumn"/>
                    <DataGridTemplateColumn x:Name="IssuedColumn" Header="Выдано&#10;на объект" Width="1.2*" MinWidth="95" SortMemberPath="ProgressValue">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Progress}" Style="{StaticResource DirectorCenter}"/>
                                <ProgressBar Value="{Binding IssuedBarValue, Mode=OneWay}" Visibility="{Binding HasIssuedProgress, Converter={StaticResource DirectorBoolVisibility}}">
                                    <ProgressBar.Style><Style TargetType="ProgressBar" BasedOn="{StaticResource DirectorProgressTrack}">
                                        <Style.Triggers><DataTrigger Binding="{Binding IssuedComplete}" Value="True"><Setter Property="Foreground" Value="#15803D"/></DataTrigger></Style.Triggers>
                                    </Style></ProgressBar.Style>
                                </ProgressBar>
                            </StackPanel>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Просрочено&#10;поставок" Binding="{Binding Late}" Width="1.1*" MinWidth="95" ElementStyle="{StaticResource DirectorLate}" SortMemberPath="LateValue" x:Name="LateColumn"/>
                </DataGrid.Columns>
            </DataGrid>
            </local:SummaryTableFrame>
        </Border>
        <StackPanel Grid.Row="4" Margin="{StaticResource LayoutDirectorSectionGap}">
            <DockPanel x:Name="LoadStatusPanel" Visibility="Collapsed" Margin="0,0,0,6">
                <Button x:Name="RetryButton" DockPanel.Dock="Right" Content="Повторить загрузку"
                        Visibility="Collapsed" Style="{StaticResource PythonToolbarButton}" Click="Retry_Click"/>
                <TextBlock x:Name="LoadStatus" Foreground="#64748B" TextWrapping="Wrap"/>
            </DockPanel>
            <TextBlock Foreground="#64748B" TextWrapping="Wrap" FontSize="{StaticResource UiBodySize}"
                       Text="Двойной щелчок — открыть карточку. ⚠ — данные неполные: закуп известен не по всем позициям или не внесены затраты на монтаж (вкладка «Себестоимость» в КП). Суммы с НДС."/>
        </StackPanel>
    </Grid>
</UserControl>
