<Window x:Class="GmcSmeta.App.ArchiveYearDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Год в архиве" Width="470" SizeToContent="Height" MinWidth="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F4F6FA"
        FontFamily="{StaticResource UiFontFamily}" FontSize="{StaticResource UiBodySize}" Foreground="#0F172A"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True">
    <Window.Resources>
        <!-- QPushButton[chip] темы: серый чип, при выборе синий градиент -->
        <Style x:Key="YearChip" TargetType="ToggleButton">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonKeyboardFocusVisual}"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ChipBorder" Background="White" BorderBrush="#D0D7E2" BorderThickness="1" CornerRadius="13">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChipBorder" Property="BorderBrush" Value="#2563EB"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ChipBorder" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#3B74F0" Offset="0"/><GradientStop Color="#2158D8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#1D4ED8"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border Padding="{StaticResource LayoutFormDialogMargin}">
        <StackPanel>
            <TextBlock Text="В какой год архива отнести карточку?" FontSize="{StaticResource UiH2Size}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="ObjectName" Foreground="#64748B" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <UniformGrid x:Name="YearGrid" Columns="4" Margin="0,10,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Другой год:" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="YearBox" Style="{StaticResource PythonSearch}" Width="100" MaxLength="4" TextAlignment="Center" FontWeight="SemiBold" Padding="8,6" TextChanged="YearBox_TextChanged" KeyDown="YearBox_KeyDown"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Style="{StaticResource PythonToolbarButton}" Content="Отмена" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button x:Name="MoveButton" Content="Перенести" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Move_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
