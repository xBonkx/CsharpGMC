<Window x:Class="GmcSmeta.App.KsRequisitesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Реквизиты для КС-2 / КС-3"
        Width="780" Height="700" MinHeight="540" MinWidth="650"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA"
        FontFamily="{StaticResource UiFontFamily}" FontSize="{StaticResource UiBodySize}"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}" Foreground="#0F172A" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="{StaticResource LayoutDialogMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Реквизиты для КС-2 и КС-3" TextWrapping="Wrap"
                       FontSize="{StaticResource UiH1Size}" FontWeight="SemiBold"
                       Foreground="#1E3A5F"/>
            <TextBlock x:Name="ObjectTitle" Text="Данные объекта и подписантов"
                       Foreground="#64748B" Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#E4E8EF"
                BorderThickness="1" CornerRadius="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                <StackPanel x:Name="RequisitesFields" IsEnabled="False">
                    <TextBlock Text="Стройка и договор" TextWrapping="Wrap" FontWeight="Bold"
                               Foreground="#2563EB" Margin="0,0,0,7"/>
                    <TextBlock Text="Заказчик (с адресом)" Foreground="#475569"/>
                    <TextBox x:Name="CustomerFullBox" Height="54" VerticalScrollBarVisibility="Auto" Margin="0,4,0,9"
                             AcceptsReturn="True" TextWrapping="Wrap"/>
                    <TextBlock Text="Стройка / объект" Foreground="#475569"/>
                    <TextBox x:Name="SiteFullBox" Height="54" VerticalScrollBarVisibility="Auto" Margin="0,4,0,9"
                             AcceptsReturn="True" TextWrapping="Wrap"/>
                    <TextBlock Text="Часть объекта в КС-2" Foreground="#475569"/>
                    <TextBox MinHeight="{StaticResource LayoutFieldMinHeight}" x:Name="SitePartBox" Margin="0,4,0,13"/>
                    <Separator Margin="0,0,0,10"/>
                    <TextBlock Text="Подписывает со стороны заказчика" TextWrapping="Wrap" FontWeight="Bold"
                               Foreground="#2563EB" Margin="0,0,0,7"/>
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Организация"/>
                            <TextBox MinHeight="{StaticResource LayoutFieldMinHeight}" x:Name="CustOrgBox" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Должность"/>
                            <TextBox MinHeight="{StaticResource LayoutFieldMinHeight}" x:Name="CustPostBox" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ФИО"/>
                            <TextBox MinHeight="{StaticResource LayoutFieldMinHeight}" x:Name="CustNameBox" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Separator Margin="0,7,0,10"/>
                    <TextBlock Text="Второй подписант (если есть)" TextWrapping="Wrap" FontWeight="Bold"
                               Foreground="#2563EB" Margin="0,0,0,7"/>
                    <TextBlock Text="Роль: генподрядчик / технический заказчик"/>
                    <TextBox MinHeight="{StaticResource LayoutFieldMinHeight}" x:Name="SecondRoleBox" Margin="0,4,0,9"/>
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Организация"/>
                            <TextBox MinHeight="{StaticResource LayoutFieldMinHeight}" x:Name="SecondOrgBox" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Должность"/>
                            <TextBox MinHeight="{StaticResource LayoutFieldMinHeight}" x:Name="SecondPostBox" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ФИО"/>
                            <TextBox MinHeight="{StaticResource LayoutFieldMinHeight}" x:Name="SecondNameBox" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Separator Margin="0,7,0,10"/>
                    <TextBlock Text="Параметры работ" TextWrapping="Wrap" FontWeight="Bold" Foreground="#2563EB"
                               Margin="0,0,0,7"/>
                    <TextBlock Text="Наименование работ для КС-3"/>
                    <TextBox MinHeight="{StaticResource LayoutFieldMinHeight}" x:Name="WorkTitleBox" Margin="0,4,0,9"/>
                    <TextBlock Text="Дата начала работ · дд.мм.гггг" TextWrapping="Wrap"/>
                    <TextBox MinHeight="{StaticResource LayoutFieldMinHeight}" x:Name="WorksStartBox" Margin="0,4,0,9" Width="190"
                             HorizontalAlignment="Left"/>
                    <TextBlock Text="Общие реквизиты заказчика и подписантов сохраняются у объекта, часть объекта — у выбранного договора."
                               Foreground="#64748B" TextWrapping="Wrap" Margin="0,7,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Foreground="#64748B"
                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="2,0,12,0"/>
            <Button Grid.Column="1" Style="{StaticResource PythonToolbarButton}" Content="Закрыть" Click="Close_Click" Margin="0,0,9,0"/>
            <Button x:Name="SaveButton" Grid.Column="2" Content="Сохранить реквизиты"
                    IsEnabled="False" Click="Save_Click" Style="{StaticResource PrimaryButton}"/>
        </Grid>
    </Grid>
</Window>
