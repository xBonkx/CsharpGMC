<Window x:Class="GmcSmeta.App.Ks3ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GmcSmeta.App"
        Title="КС-3 — расчёт" Width="920" Height="640" MinWidth="740" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA"
        FontFamily="{StaticResource UiFontFamily}" FontSize="{StaticResource UiBodySize}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}" Foreground="#0F172A" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Расчёт КС-3" TextWrapping="Wrap" Foreground="#0F172A" FontWeight="Bold"
                           FontSize="{StaticResource UiH1Size}"/>
                <TextBlock x:Name="ActInfoText" Foreground="{StaticResource UiMutedTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ExportButton" Content="Сохранить Excel" ContentTemplate="{StaticResource IconLabelDownload}" Click="Export_Click"
                        Style="{StaticResource PrimaryButton}" IsEnabled="False" Margin="0,0,8,0"/>
                <Button Style="{StaticResource PythonToolbarButton}" Content="Закрыть" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#FFF8EB" BorderBrush="#F1DEBD"
                BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,12,0,10">
            <TextBlock Text="Расчётные данные по выбранной КС-2. Это не официальный бланк КС-3."
                       Foreground="#8B5E20" TextWrapping="Wrap"/>
        </Border>

        <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,10">
            <Border Style="{StaticResource PythonTile}" Background="#EAF2FF"
                    BorderBrush="#D4E4FA" Margin="0,0,6,6">
                <StackPanel>
                    <TextBlock Text="За период · без НДС" Style="{StaticResource PythonTileLabel}" Foreground="#476A98" TextWrapping="Wrap"/>
                    <TextBlock x:Name="PeriodNetText" Text="—" FontWeight="Bold"
                               FontSize="{StaticResource UiH2Size}" Foreground="#164280" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PythonTile}" Background="#EAF2FF"
                    BorderBrush="#D4E4FA" Margin="0,0,6,6">
                <StackPanel>
                    <TextBlock x:Name="YearAmountLabel" Text="С начала года · без НДС" Style="{StaticResource PythonTileLabel}" Foreground="#476A98" TextWrapping="Wrap"/>
                    <TextBlock x:Name="YearNetText" Text="—" FontWeight="Bold"
                               FontSize="{StaticResource UiH2Size}" Foreground="#164280" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PythonTile}" Background="#EAF2FF"
                    BorderBrush="#D4E4FA" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock x:Name="StartAmountLabel" Text="С начала работ · без НДС" Style="{StaticResource PythonTileLabel}" Foreground="#476A98" TextWrapping="Wrap"/>
                    <TextBlock x:Name="StartNetText" Text="—" FontWeight="Bold"
                               FontSize="{StaticResource UiH2Size}" Foreground="#164280" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="3" Background="White" BorderBrush="#E4E8EF"
                BorderThickness="1" CornerRadius="12" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Предыдущие КС-2, учтённые в расчёте"
                           Foreground="#334155" FontWeight="SemiBold" Margin="4,0,0,10"/>
                <DataGrid local:TableColumnMenu.Key="ks3-previous" local:TableColumnMenu.Protect="Акт КС-2" CellStyle="{StaticResource CompactCostCell}" x:Name="PreviousGrid" IsReadOnly="True" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" RowHeaderWidth="0"
                          ColumnHeaderStyle="{StaticResource KsQuantityHeader}" MinRowHeight="27"
                          GridLinesVisibility="All" HorizontalGridLinesBrush="#E4E8EF"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          RowStyle="{StaticResource KsReportRow}" AlternationCount="2" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" CanUserResizeRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Акт КС-2" Binding="{Binding Title}" Width="*" MinWidth="150" HeaderStyle="{StaticResource KsTextHeader}" ElementStyle="{StaticResource CompactCostText}"/>
                        <DataGridTextColumn Header="Без НДС, ₽" Binding="{Binding Net, StringFormat={}{0:N2}}"
                                            Width="190" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource PythonTile}" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="НДС за период" Style="{StaticResource PythonTileLabel}"/>
                    <TextBlock x:Name="VatText" Text="—" FontWeight="Bold" FontSize="{StaticResource UiH2Size}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" CornerRadius="12" Padding="16,11" Margin="6,0,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2563EB" Offset="0"/>
                        <GradientStop Color="#4F46E5" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <TextBlock Text="Итого за период · с НДС" TextWrapping="Wrap" Style="{StaticResource PythonTileLabel}" Foreground="White"/>
                    <TextBlock x:Name="TotalText" Text="—" FontWeight="Bold"
                               FontSize="{StaticResource UiH2Size}" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
