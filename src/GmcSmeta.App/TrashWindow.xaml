<Window x:Class="GmcSmeta.App.TrashWindow" UseLayoutRounding="True" SnapsToDevicePixels="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GmcSmeta.App"
        Title="Корзина" Width="900" Height="480" MinWidth="700" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA"
        FontFamily="{StaticResource UiFontFamily}" FontSize="{StaticResource UiBodySize}"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" Foreground="#0F172A">
    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Корзина" FontWeight="SemiBold" FontSize="{StaticResource UiH2Size}" Foreground="#0F172A"/>
        <TextBlock Grid.Row="1" Foreground="#64748B" Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="Удалённые карточки и документы хранятся 30 дней, потом исчезают насовсем. Выделите строку и нажмите «Вернуть»."/>
        <DataGrid local:TableColumnMenu.Key="trash" MinRowHeight="27" AlternationCount="0"
                  RowStyle="{StaticResource PythonTableRow}"
                 
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto" HorizontalGridLinesBrush="#E4E8EF"
                  Background="#FFFFFF" BorderBrush="#E4E8EF" x:Name="TrashGrid" Grid.Row="2" Margin="0,10,0,0"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow" RowHeaderWidth="0"
                  GridLinesVisibility="All" HeadersVisibility="Column"
                  MouseDoubleClick="TrashGrid_DoubleClick" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.VirtualizationMode="Recycling" Style="{StaticResource DocumentTable}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Что" Binding="{Binding KindText}" Width="90" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                <DataGridTextColumn Header="Карточка" Binding="{Binding ObjectName}" Width="200" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                <DataGridTextColumn Header="Строк" Binding="{Binding RowsText}" Width="60" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsQuantityHeader}"/>
                <DataGridTextColumn Header="Удалено" Binding="{Binding DeletedText}" Width="170" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsQuantityHeader}"/>
                <DataGridTextColumn Header="Осталось" Binding="{Binding DaysLeftText}" Width="80" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="EmptyText" Grid.Row="3" Foreground="#64748B" Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="Корзина пуста — ничего не удаляли." Visibility="Collapsed"/>
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="RestoreButton" Content="Вернуть" Click="Restore_Click" FontWeight="SemiBold"
                    Padding="14,4" Style="{StaticResource PythonToolbarPrimary}" ContentTemplate="{StaticResource IconLabelUndo}"/>
            <Button x:Name="ForgetButton" Grid.Column="1" Content="Удалить навсегда" Click="Forget_Click"
                    Margin="10,0,0,0" Padding="12,4" Style="{StaticResource PythonToolbarButton}" ContentTemplate="{StaticResource IconLabelTrash}"/>
            <Button Grid.Column="3" Style="{StaticResource PythonToolbarButton}" Content="Закрыть" IsCancel="True" Padding="12,4"/>
        </Grid>
    </Grid>
</Window>
