<Window x:Class="GmcSmeta.App.PeopleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GmcSmeta.App"
        Title="Люди и автомобили" Width="1200" Height="760" MinWidth="840" MinHeight="550"
        FontFamily="{StaticResource UiFontFamily}" FontSize="{StaticResource UiBodySize}" WindowStartupLocation="CenterOwner"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        Background="#F4F6FA" Foreground="#0F172A" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <DockPanel Margin="22,16,22,14" LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Загрузить из Excel…" Style="{StaticResource PythonToolbarButton}" ContentTemplate="{StaticResource IconLabelUpload}" Click="Import_Click"
                        Padding="16,8" Margin="12,0,0,0" VerticalAlignment="Top"/>
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="Люди и автомобили"
                               FontSize="{StaticResource UiH1Size}" FontWeight="SemiBold" Foreground="#1F2937" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SubtitleText" Text="Общая база сотрудников и автомобилей"
                               Foreground="#64748B" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
            <WrapPanel x:Name="HistoryPanel" Visibility="Collapsed" Orientation="Horizontal" Margin="0,2,0,7">
                <TextBlock Text="Галочки как в списке:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#64748B"/>
                <ComboBox x:Name="HistoryBox" MinWidth="420" Width="475" DisplayMemberPath="Label"
                          SelectionChanged="History_Changed"/>
                <Button Content="Открыть файл" ContentTemplate="{StaticResource IconLabelOpen}" Style="{StaticResource PythonToolbarButton}" Click="OpenHistory_Click" Padding="10,6" Margin="8,0,0,0"/>
            </WrapPanel>
            <WrapPanel Margin="0,4,0,0">
                <Grid Width="390">
                    <TextBox x:Name="SearchBox" Style="{StaticResource PythonSearch}" Padding="32,5,32,5" TextChanged="Search_Changed"
                             AutomationProperties.Name="Поиск по фамилии, должности, госномеру" ToolTip="Поиск по фамилии, должности, госномеру…"/>
                    <Viewbox Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False">
                        <Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphSearch}" Stroke="#64748B"/></Canvas>
                    </Viewbox>
                    <TextBlock Text="Поиск по фамилии, должности, госномеру…" Foreground="#94A3B8" Margin="32,0,32,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Content="Очистить" ContentTemplate="{StaticResource IconOnlyX}" Click="ClearPeopleSearch_Click"
                            ToolTip="Очистить поиск" AutomationProperties.Name="Очистить поиск"
                            Width="26" Height="26" MinWidth="0" MinHeight="0" Padding="0" Margin="0,0,3,0"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PythonToolbarButton}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger></Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
                <CheckBox x:Name="ShowInactive" Content="Показать тех, кто уже не работает"
                          Margin="20,0,0,0" VerticalAlignment="Center"
                          Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            </WrapPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid x:Name="AccessOptions" Visibility="Collapsed" Margin="0,2,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="От организации:" VerticalAlignment="Top" Margin="0,8,8,0"/>
                <ComboBox Grid.Column="1" x:Name="CompanyBox" DisplayMemberPath="Name"
                          Margin="0,0,18,0" Height="32"/>
                <TextBlock Grid.Column="2" Text="Текст письма:" VerticalAlignment="Top" Margin="0,8,8,0"/>
                <TextBox Grid.Column="3" x:Name="IntroBox" Height="54" Padding="6" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </Grid>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="OrdersButton" Visibility="Collapsed" Content="Приказы…" ContentTemplate="{StaticResource IconLabelFile}" Style="{StaticResource PythonToolbarButton}"
                            Click="Orders_Click" Padding="12,7" Margin="0,0,8,0"/>
                    <Button x:Name="ExportButton" Visibility="Collapsed" Content="Сформировать список (Excel)" ContentTemplate="{StaticResource IconLabelExcel}"
                            Click="Export_Click" Style="{StaticResource ProcurementRequestPrimary}" Margin="0,0,8,0"/>
                    <Button Content="Закрыть" Style="{StaticResource PythonToolbarButton}" Click="Close_Click" Padding="14,7"/>
                </StackPanel>
                <TextBlock x:Name="HintText" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{StaticResource UiMutedTextBrush}" FontSize="{StaticResource UiCaptionSize}"
                           Text="Двойной щелчок или F2 — редактировать ячейку; Enter — сохранить, Esc — отменить."/>
            </DockPanel>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="105"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*" MinHeight="105"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0">
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6" VerticalAlignment="Center">
                    <TextBlock Text="ЛЮДИ" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="#475569" Margin="0,0,10,0"/>
                    <TextBlock x:Name="PeopleCount" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="PeopleAll" Visibility="Collapsed" Content="Отметить всех" ContentTemplate="{StaticResource IconLabelCheck}" Style="{StaticResource PythonToolbarButton}"
                            Click="PeopleAll_Click" Padding="8,4" Margin="0,0,5,0"/>
                    <Button x:Name="PeopleNone" Visibility="Collapsed" Content="Снять все" ContentTemplate="{StaticResource IconLabelX}" Style="{StaticResource PythonToolbarButton}"
                            Click="PeopleNone_Click" Padding="8,4" Margin="0,0,8,0"/>
                    <Button Content="Выше" ContentTemplate="{StaticResource IconOnlyArrowUp}" Style="{StaticResource PythonToolbarButton}" ToolTip="Выше" Click="PersonUp_Click" Margin="0,0,4,0" Width="32" MinWidth="32" Padding="4" />
                    <Button Content="Ниже" ContentTemplate="{StaticResource IconOnlyArrowDown}" Style="{StaticResource PythonToolbarButton}" ToolTip="Ниже" Click="PersonDown_Click" Margin="0,0,8,0" Width="32" MinWidth="32" Padding="4" />
                    <Button Content="Добавить человека" ContentTemplate="{StaticResource IconLabelPlus}" Style="{StaticResource PythonToolbarButton}" Click="PersonAdd_Click" Padding="8,4" Margin="0,0,5,0"/>

                    <Button x:Name="PersonActiveButton" Content="Не работает / Снова работает"
                            Click="PersonActive_Click" Padding="8,4" Margin="0,0,5,0"/>
                    <Button x:Name="PersonDeleteButton" Content="Удалить…" Click="PersonDelete_Click"
                            Padding="8,4"/>
                </WrapPanel>
                <DataGrid local:TableColumnMenu.Key="people" local:TableColumnMenu.Exclude="В списке" local:TableColumnMenu.Protect="ФИО" x:Name="PeopleGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="All"
                          SelectionMode="Extended" SelectionUnit="FullRow" IsReadOnly="False" MinRowHeight="27" AlternationCount="0" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                          Background="White" CanUserReorderColumns="True"
                          SelectionChanged="Selection_Changed"
                          BeginningEdit="Inline_BeginningEdit" CellEditEnding="Inline_CellEditEnding" ContextMenuOpening="People_ContextMenuOpening"
                          PreviewKeyDown="People_PreviewKeyDown"
                          CurrentCellChanged="CheckCell_Changed" Style="{StaticResource DocumentTable}">
                    <DataGrid.ContextMenu><ContextMenu/></DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn x:Name="PeopleSelectedColumn" Header="В списке"
                            Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Width="90"/>
                        <local:PeopleInlineTextColumn Header="ФИО" Binding="{Binding Fio}" Field="Fio" Width="300"  ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                        <local:PeopleInlineTextColumn Header="Должность" Binding="{Binding Post}" Field="Post" Width="210"  ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                        <local:PeopleInlineTextColumn Header="Дата рождения" Binding="{Binding Birth}" Field="Birth" Width="120"  ElementStyle="{StaticResource CompactCostCenter}" HeaderStyle="{StaticResource KsQuantityHeader}"/>
                        <local:PeopleInlineTextColumn Header="Примечание" Binding="{Binding Note}" Field="Note" Width="180"  ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                        <local:PeopleInlineTextColumn Header="ФИО — кого" Binding="{Binding DisplayGenitive}" Field="FioGen" Width="280"  ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                        <local:PeopleInlineTextColumn Header="Должность — кого" Binding="{Binding DisplayPostGenitive}" Field="PostGen"
                                            Width="180"  ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch"
                          VerticalAlignment="Center" Background="#E4E8EF"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>
            <DockPanel Grid.Row="2" Margin="0,6,0,0">
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="АВТОМОБИЛИ" FontWeight="SemiBold" Foreground="#475569"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="CarsCount" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="CarsAll" Visibility="Collapsed" Content="Отметить все" ContentTemplate="{StaticResource IconLabelCheck}" Style="{StaticResource PythonToolbarButton}"
                            Click="CarsAll_Click" Padding="8,4" Margin="0,0,5,0"/>
                    <Button x:Name="CarsNone" Visibility="Collapsed" Content="Снять все" ContentTemplate="{StaticResource IconLabelX}" Style="{StaticResource PythonToolbarButton}"
                            Click="CarsNone_Click" Padding="8,4" Margin="0,0,8,0"/>
                    <Button Content="Выше" ContentTemplate="{StaticResource IconOnlyArrowUp}" Style="{StaticResource PythonToolbarButton}" ToolTip="Выше" Click="CarUp_Click" Margin="0,0,4,0" Width="32" MinWidth="32" Padding="4" />
                    <Button Content="Ниже" ContentTemplate="{StaticResource IconOnlyArrowDown}" Style="{StaticResource PythonToolbarButton}" ToolTip="Ниже" Click="CarDown_Click" Margin="0,0,8,0" Width="32" MinWidth="32" Padding="4" />
                    <Button Content="Добавить автомобиль" ContentTemplate="{StaticResource IconLabelPlus}" Style="{StaticResource PythonToolbarButton}" Click="CarAdd_Click" Padding="8,4" Margin="0,0,5,0"/>

                    <Button Content="Не работает / Снова работает" Click="CarActive_Click"
                            Padding="8,4" Margin="0,0,5,0"/>
                    <Button Content="Удалить…" Click="CarDelete_Click" Padding="8,4"/>
                </WrapPanel>
                <DataGrid local:TableColumnMenu.Key="cars" local:TableColumnMenu.Exclude="В списке" local:TableColumnMenu.Protect="Марка|Госномер" x:Name="CarsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" SelectionMode="Extended" SelectionUnit="FullRow" IsReadOnly="False"
                          GridLinesVisibility="All" MinRowHeight="27" AlternationCount="0" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" Background="White"
                          BeginningEdit="Inline_BeginningEdit" CellEditEnding="Inline_CellEditEnding" ContextMenuOpening="Cars_ContextMenuOpening"
                          PreviewKeyDown="Cars_PreviewKeyDown"
                          CurrentCellChanged="CheckCell_Changed" Style="{StaticResource DocumentTable}">
                    <DataGrid.ContextMenu><ContextMenu/></DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn x:Name="CarsSelectedColumn" Header="В списке"
                             Width="90" Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <local:PeopleInlineTextColumn Header="Марка" Binding="{Binding Model}" Field="Model" Width="300"  ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                        <local:PeopleInlineTextColumn Header="Госномер" Binding="{Binding Plate}" Field="Plate" Width="160"  ElementStyle="{StaticResource CompactCostCenter}" HeaderStyle="{StaticResource KsQuantityHeader}"/>
                        <local:PeopleInlineTextColumn Header="Примечание" Binding="{Binding Note}" Field="Note" Width="*"  ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>