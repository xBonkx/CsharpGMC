<Window x:Class="GmcSmeta.App.ConfirmDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Удаление объекта" Width="560" Height="360" MinWidth="480" MinHeight="330"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F4F6FA"
        FontFamily="{StaticResource UiFontFamily}" FontSize="{StaticResource UiBodySize}" Foreground="#0F172A"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True">
    <Border Padding="24,20,24,18">
        <DockPanel>
            <UniformGrid DockPanel.Dock="Bottom" Columns="2" Rows="1" Margin="0,16,0,0">
                <Button Style="{StaticResource PythonToolbarButton}" Content="Отмена" Click="Cancel_Click" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                <Button x:Name="DeleteButton" Content="Удалить" HorizontalAlignment="Left" IsEnabled="False" Click="Delete_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border" Background="#DC2626" CornerRadius="8" Padding="14,7">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextBlock.FontWeight="SemiBold" TextBlock.Foreground="White"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="#B91C1C"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Border" Property="Background" Value="#F3B4B4"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </UniformGrid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="HeadingText" Text="Удалить объект навсегда?" FontSize="{StaticResource UiH2Size}" FontWeight="SemiBold" Foreground="#DC2626"/>
                <TextBlock x:Name="NameText" FontSize="{StaticResource UiH2Size}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0"/>
                <TextBlock x:Name="DetailsText" TextWrapping="Wrap" Margin="0,10,0,0"/>
                <TextBlock Text="Если удалили по ошибке, запись можно вернуть из корзины в течение 30 дней: меню «☰ → Корзина»."
                           Foreground="#64748B" TextWrapping="Wrap" Margin="0,10,0,0"/>
                <TextBlock Text="Чтобы подтвердить, ответьте на вопрос:" Foreground="#64748B" Margin="0,10,0,0"/>
                <TextBlock x:Name="QuestionText" FontSize="{StaticResource UiH2Size}" FontWeight="SemiBold" Foreground="#B91C1C" Margin="0,10,0,0"/>
                <TextBox x:Name="AnswerBox" Style="{StaticResource PythonSearch}" MaxWidth="160" TextAlignment="Center" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="0,10,0,0"
                         Padding="10,6" ToolTip="ответ цифрами" KeyDown="AnswerBox_KeyDown" TextChanged="AnswerBox_TextChanged"/>
            </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
