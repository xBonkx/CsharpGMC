<Window x:Class="GmcSmeta.App.ConfirmDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Удаление объекта" Width="560" SizeToContent="Height" MinWidth="480" MinHeight="330"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F4F6FA"
        FontFamily="{StaticResource UiFontFamily}" FontSize="{StaticResource UiBodySize}" Foreground="#0F172A"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True">
    <Border Padding="{StaticResource LayoutFormDialogMargin}">
        <DockPanel>
            <UniformGrid DockPanel.Dock="Bottom" Columns="2" Rows="1" Margin="0,16,0,0">
                <Button Style="{StaticResource PythonToolbarButton}" Content="Отмена" IsCancel="True" Click="Cancel_Click" HorizontalAlignment="Right" Margin="{StaticResource LayoutDialogActionGap}"/>
                <Button x:Name="DeleteButton" Content="Удалить" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" IsEnabled="False" Click="Delete_Click" Padding="14,7"/>
            </UniformGrid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="HeadingText" Text="Удалить объект?" TextWrapping="Wrap" FontSize="{StaticResource UiH2Size}" FontWeight="SemiBold" Foreground="#DC2626"/>
                <TextBlock x:Name="NameText" FontSize="{StaticResource UiH2Size}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0"/>
                <TextBlock x:Name="DetailsText" TextWrapping="Wrap" Margin="0,10,0,0"/>
                <TextBlock Text="Если удалили по ошибке, запись можно вернуть из корзины в течение 30 дней: меню «☰ → Корзина»."
                           Style="{StaticResource UiSecondaryText}" Margin="{StaticResource LayoutFormFooterGap}"/>
                <TextBlock Text="Чтобы подтвердить, ответьте на вопрос:" Style="{StaticResource UiSecondaryText}" Margin="{StaticResource LayoutFormFooterGap}"/>
                <TextBlock x:Name="QuestionText" FontSize="{StaticResource UiH2Size}" FontWeight="SemiBold" Foreground="#B91C1C" Margin="0,10,0,0"/>
                <TextBox x:Name="AnswerBox" Style="{StaticResource PythonSearch}" MaxWidth="160" TextAlignment="Center" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="0,10,0,0"
                         Padding="10,6" ToolTip="ответ цифрами" KeyDown="AnswerBox_KeyDown" TextChanged="AnswerBox_TextChanged"/>
            </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
