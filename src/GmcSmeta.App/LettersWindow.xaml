<Window x:Class="GmcSmeta.App.LettersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GmcSmeta.App"
        Title="Письма — исходящая корреспонденция" Width="1200" Height="760"
        MinWidth="800" MinHeight="540" WindowStartupLocation="CenterOwner"
        Background="#F4F6FA" FontFamily="{StaticResource UiFontFamily}" FontSize="{StaticResource UiBodySize}" Foreground="#0F172A" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="ArchivePath" Foreground="{StaticResource UiMutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <WrapPanel x:Name="ActionPanel" Margin="0,0,0,10" IsEnabled="False">
                <Button Style="{StaticResource PythonToolbarButton}" Content="Новое письмо" ContentTemplate="{StaticResource IconLabelPlus}" Click="New_Click" Padding="14,6" Margin="0,0,6,6"/>
                <Button Style="{StaticResource PythonToolbarButton}" Content="Открыть" ContentTemplate="{StaticResource IconLabelOpen}" Click="Open_Click" Padding="14,6" Margin="0,0,6,6"/>
                <Button Style="{StaticResource PythonToolbarButton}" Content="Копировать" ContentTemplate="{StaticResource IconLabelCopy}" Click="Copy_Click" Padding="14,6" Margin="0,0,6,6"/>
                <Button Style="{StaticResource PythonToolbarButton}" Content="Выбрать архив…" ContentTemplate="{StaticResource IconLabelOpen}" Click="Root_Click" Padding="14,6" Margin="0,0,6,6"/>
                <Button Style="{StaticResource PythonToolbarButton}" Content="Резервная копия…" Click="Backup_Click" Padding="14,6" Margin="0,0,6,6"/>
                <Button Style="{StaticResource PythonToolbarButton}" Content="Восстановить…" Click="Restore_Click" Padding="14,6" Margin="0,0,6,6"/>
                <Button Style="{StaticResource PythonToolbarButton}" x:Name="AttachExistingButton" Content="Добавить ранее созданное письмо…" Click="AttachExisting_Click" Visibility="Collapsed" Padding="14,6" Margin="0,0,6,6"/>
            </WrapPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="175"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <TextBox x:Name="SearchBox" Style="{StaticResource PythonSearch}"
                             Background="#FFFFFF" BorderBrush="#D0D7E2" Padding="32,5,10,5"
                             VerticalContentAlignment="Center" AutomationProperties.Name="Поиск писем"
                             ToolTip="Поиск по номеру, теме, объекту, адресату" TextChanged="Search_Changed"/>
                    <Viewbox Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphSearch}" Stroke="#64748B"/></Canvas></Viewbox>
                    <TextBlock Text="Номер, тема, объект, адресат…" Foreground="{StaticResource UiMutedTextBrush}" Margin="32,0,10,0"
                               VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <ComboBox x:Name="StatusFilter" Grid.Column="1" MinHeight="{StaticResource LayoutFieldMinHeight}" SelectionChanged="Search_Changed">
                    <ComboBoxItem Content="Все"/>
                    <ComboBoxItem Content="Черновик"/>
                    <ComboBoxItem Content="Отправлено"/>
                </ComboBox>
                <Button x:Name="RefreshButton" Grid.Column="2" Content="Обновить" ContentTemplate="{StaticResource IconLabelRefresh}"
                        Style="{StaticResource PythonToolbarButton}" Margin="6,0,0,0"
                        Click="Refresh_Click" IsEnabled="False"/>
            </Grid>
        </StackPanel>
        <DataGrid local:TableColumnMenu.Key="letters" x:Name="LetterList" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False"
                  Background="White" BorderBrush="#E4E8EF" GridLinesVisibility="All"
                  MinRowHeight="27" AlternationCount="0" RowStyle="{StaticResource PythonTableRow}" HeadersVisibility="Column" MouseDoubleClick="List_DoubleClick" Style="{StaticResource DocumentTable}" CanUserResizeRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Исходящий №" Width="110" Binding="{Binding Number}" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsQuantityHeader}"/>
                <DataGridTextColumn Header="Дата" Width="105" Binding="{Binding Date}" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsQuantityHeader}"/>
                <DataGridTextColumn Header="Тема" Width="2*" MinWidth="150" Binding="{Binding Subject}" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                <DataGridTextColumn Header="Объект" Width="*" Binding="{Binding Object}" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                <DataGridTextColumn Header="Кому" Width="2*" MinWidth="150" Binding="{Binding Recipient}" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                <DataGridTextColumn Header="Статус" Width="115" Binding="{Binding Status}" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsQuantityHeader}"/>
                <DataGridTextColumn Header="Отправлено" Width="110" Binding="{Binding Sent.Date}" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsQuantityHeader}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>