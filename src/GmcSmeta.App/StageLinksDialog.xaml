<Window x:Class="GmcSmeta.App.StageLinksDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GmcSmeta.App"
        Title="Связи этапов, ДС и КС" Width="910" Height="560"
        MinWidth="680" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="#F4F6FA" FontFamily="{StaticResource UiFontFamily}"
        FontSize="{StaticResource UiBodySize}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Документы полного КП и их зависимости"
                   FontWeight="SemiBold" FontSize="{StaticResource UiH2Size}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <DataGrid local:TableColumnMenu.Key="stage-links" local:TableColumnMenu.Protect="Документ" x:Name="LinksGrid" Grid.Row="1"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  MinRowHeight="{StaticResource LayoutDocumentRowMinHeight}" CanUserResizeRows="False" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Auto" EnableRowVirtualization="True" EnableColumnVirtualization="True" BorderBrush="#E4E8EF"
                  Background="White" RowHeaderWidth="0" Style="{StaticResource DocumentTable}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Тип" Binding="{Binding Kind}" Width="95" ElementStyle="{StaticResource CompactCostCenter}" HeaderStyle="{StaticResource KsQuantityHeader}"/>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" ElementStyle="{StaticResource CompactCostCenter}" HeaderStyle="{StaticResource KsQuantityHeader}"/>
                <DataGridTextColumn Header="Документ" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                <DataGridTextColumn Header="Источник" Binding="{Binding ParentName}" Width="*" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding State}" Width="125" ElementStyle="{StaticResource CompactCostCenter}" HeaderStyle="{StaticResource KsQuantityHeader}"/>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Foreground="#64748B" TextWrapping="Wrap"
                       Text="Удаление этапа с КС, ДС или движениями материалов запрещено."/>
            <Button Grid.Column="1" Style="{StaticResource PythonToolbarButton}" Content="Закрыть" IsCancel="True"
                    MinWidth="95" Padding="12,5" Margin="12,0,0,0"/>
        </Grid>
    </Grid>
</Window>