<Window x:Class="GmcSmeta.App.PtoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GmcSmeta.App"
    Title="ПТО / Исполнительная документация" Width="1200" Height="760"
    MinWidth="750" MinHeight="530" WindowStartupLocation="CenterOwner"
    Background="#F4F6FA" FontFamily="{StaticResource UiFontFamily}" FontSize="{StaticResource UiBodySize}" Foreground="#0F172A" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock x:Name="ArchiveLabel" Margin="0,0,0,10" Foreground="#64748B" TextWrapping="Wrap"/>
      <WrapPanel Margin="0,0,0,6">
        <Button Style="{StaticResource PrimaryButton}" Content="Создать комплект" ContentTemplate="{StaticResource IconLabelPlus}" Click="Create_Click" Padding="12,7" Margin="0,0,8,6"/>
        <Button Content="Открыть" ContentTemplate="{StaticResource IconLabelFile}" Click="Edit_Click" Padding="12,7" Margin="0,0,8,6"/>
        <Button Content="Копировать акт" ContentTemplate="{StaticResource IconLabelCopy}" Click="Copy_Click" Padding="12,7" Margin="0,0,8,6"/>
        <Button Content="Удалить" ContentTemplate="{StaticResource IconLabelTrash}" Click="Delete_Click" Padding="12,7" Margin="0,0,8,6"/>
        <Button Content="Карточка объекта" ContentTemplate="{StaticResource IconLabelBuilding}" Click="ObjectCard_Click" Padding="12,7" Margin="0,0,8,6"/>
        <Button Content="Сертификаты…" ContentTemplate="{StaticResource IconLabelCheck}" Click="Certificates_Click" Padding="12,7" Margin="0,0,8,6"/>
        <Button Content="Шаблоны Excel…" ContentTemplate="{StaticResource IconLabelFile}" Click="Templates_Click" Padding="12,7" Margin="0,0,8,6"/>
      </WrapPanel>
      <WrapPanel Margin="0,0,0,10">
        <Button Content="Резервная копия…" ContentTemplate="{StaticResource IconLabelDownload}" Click="Backup_Click" Padding="12,7" Margin="0,0,8,6"/>
        <Button Content="Восстановить…" ContentTemplate="{StaticResource IconLabelUpload}" Click="Restore_Click" Padding="12,7" Margin="0,0,8,6"/>
        <Button Content="Выбрать архив PDF…" ContentTemplate="{StaticResource IconLabelFile}" Click="Root_Click" Padding="12,7" Margin="0,0,8,6"/>
        <Button Content="Обновить" ContentTemplate="{StaticResource IconLabelRefresh}" Click="Refresh_Click" Padding="12,7" Margin="0,0,8,6"/>
      </WrapPanel>
      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="185"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="Search" Padding="10,7" Margin="0,0,8,0"
          ToolTip="Поиск объекта, договора, акта или замечаний"
          TextChanged="Filter_Changed"/>
        <ComboBox x:Name="StatusFilter" Grid.Column="1" SelectionChanged="Filter_Changed">
          <ComboBoxItem Content="Все статусы" IsSelected="True"/>
          <ComboBoxItem Content="Черновик"/>
          <ComboBoxItem Content="На проверке"/>
          <ComboBoxItem Content="Готов"/>
          <ComboBoxItem Content="Подписан"/>
        </ComboBox>
      </Grid>
    </StackPanel>
    <DataGrid local:TableColumnMenu.Key="pto-packages" x:Name="Packages" AutoGenerateColumns="False" IsReadOnly="True"
        Background="White" MinRowHeight="24" GridLinesVisibility="All"
        SelectionUnit="FullRow" MouseDoubleClick="Packages_DoubleClick" Style="{StaticResource DocumentTable}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Объект / договор" Binding="{Binding ObjectLabel}" Width="3*" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
        <DataGridTextColumn Header="Раздел" Binding="{Binding Section}" Width="1.3*" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
        <DataGridTextColumn Header="Акт №" Binding="{Binding Number}" Width="100" ElementStyle="{StaticResource CompactCostCenter}" HeaderStyle="{StaticResource KsQuantityHeader}"/>
        <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="100" ElementStyle="{StaticResource CompactCostCenter}" HeaderStyle="{StaticResource KsQuantityHeader}"/>
        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="115" ElementStyle="{StaticResource CompactCostCenter}" HeaderStyle="{StaticResource KsQuantityHeader}"/>
        <DataGridTextColumn Header="Замечания" Binding="{Binding Findings}" Width="215" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>