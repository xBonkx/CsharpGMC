<Window x:Class="GmcSmeta.App.PtoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GmcSmeta.App"
    Title="ПТО / Исполнительная документация" Width="1200" Height="760"
    MinWidth="750" MinHeight="530" WindowStartupLocation="CenterOwner"
    Background="#F4F6FA" FontFamily="{StaticResource UiFontFamily}" FontSize="{StaticResource UiBodySize}" Foreground="#0F172A" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
  <DockPanel x:Name="PtoContent" Margin="14">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock x:Name="ArchiveLabel" Margin="0,0,0,10" Foreground="#64748B" TextWrapping="Wrap"/>
      <WrapPanel Margin="0,0,0,6">
        <Button Style="{StaticResource PythonToolbarButton}" Content="Создать комплект" ContentTemplate="{StaticResource IconLabelPlus}" Click="Create_Click" Padding="14,6" Margin="0,0,6,6"/>
        <Button Style="{StaticResource PythonToolbarButton}" Content="Открыть" ContentTemplate="{StaticResource IconLabelOpen}" Click="Edit_Click" Padding="14,6" Margin="0,0,6,6"/>
        <Button Style="{StaticResource PythonToolbarButton}" Content="Копировать акт" ContentTemplate="{StaticResource IconLabelCopy}" Click="Copy_Click" Padding="14,6" Margin="0,0,6,6"/>
        <Button Style="{StaticResource PythonToolbarButton}" Content="Удалить" ContentTemplate="{StaticResource IconLabelTrash}" Click="Delete_Click" Padding="14,6" Margin="0,0,6,6"/>
        <Button Style="{StaticResource PythonToolbarButton}" Content="Карточка объекта" Click="ObjectCard_Click" Padding="14,6" Margin="0,0,6,6"/>
        <Button Style="{StaticResource PythonToolbarButton}" Content="Сертификаты…" Click="Certificates_Click" Padding="14,6" Margin="0,0,6,6"/>
        <Button Style="{StaticResource PythonToolbarButton}" Content="Шаблоны Excel…" Click="Templates_Click" Padding="14,6" Margin="0,0,6,6"/>
      </WrapPanel>
      <WrapPanel Margin="0,0,0,10">
        <Button Style="{StaticResource PythonToolbarButton}" Content="Резервная копия…" Click="Backup_Click" Padding="14,6" Margin="0,0,6,6"/>
        <Button Style="{StaticResource PythonToolbarButton}" Content="Восстановить…" Click="Restore_Click" Padding="14,6" Margin="0,0,6,6"/>
        <Button Style="{StaticResource PythonToolbarButton}" Content="Выбрать архив…" Click="Root_Click" Padding="14,6" Margin="0,0,6,6"/>
        <Button Style="{StaticResource PythonToolbarButton}" Content="Обновить" ContentTemplate="{StaticResource IconLabelRefresh}" Click="Refresh_Click" Padding="14,6" Margin="0,0,6,6"/>
      </WrapPanel>
      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" MinWidth="155" MaxWidth="240"/>
        </Grid.ColumnDefinitions>
        <Grid Margin="0,0,8,0">
          <TextBox x:Name="Search" Style="{StaticResource PythonSearch}"
            Background="White" BorderBrush="#D0D7E2" Padding="32,5,10,5" VerticalContentAlignment="Center"
            AutomationProperties.Name="Поиск комплектов"
            ToolTip="Поиск объекта, договора, акта или замечаний" TextChanged="Filter_Changed"/>
          <Viewbox Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphSearch}" Stroke="#64748B"/></Canvas></Viewbox>
                    <TextBlock Text="Найти комплект по объекту, договору или номеру акта"
            Foreground="#94A3B8" Margin="32,0,10,0" VerticalAlignment="Center"
            IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
        <ComboBox x:Name="StatusFilter" Grid.Column="1" MinHeight="{StaticResource LayoutFieldMinHeight}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" SelectionChanged="Filter_Changed">
          <ComboBoxItem Content="Все статусы" IsSelected="True"/>
          <ComboBoxItem Content="Черновик"/>
          <ComboBoxItem Content="На проверке"/>
          <ComboBoxItem Content="Готов"/>
          <ComboBoxItem Content="Подписан"/>
        </ComboBox>
      </Grid>
    </StackPanel>
    <DataGrid local:TableColumnMenu.Key="pto-packages" x:Name="Packages" AutoGenerateColumns="False" IsReadOnly="True"
        Background="White" MinRowHeight="27" AlternationCount="0" RowStyle="{StaticResource PythonTableRow}" GridLinesVisibility="All"
        SelectionMode="Single" SelectionUnit="FullRow" MouseDoubleClick="Packages_DoubleClick" Style="{StaticResource DocumentTable}" CanUserResizeRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Объект / договор" Binding="{Binding ObjectLabel}" Width="3*" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
        <DataGridTextColumn Header="Раздел" Binding="{Binding Section}" Width="1.3*" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
        <DataGridTextColumn Header="Акт №" Binding="{Binding Number}" Width="100" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsQuantityHeader}"/>
        <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="100" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsQuantityHeader}"/>
        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="115" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsQuantityHeader}"/>
        <DataGridTextColumn Header="Замечания" Binding="{Binding Findings}" Width="215" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>