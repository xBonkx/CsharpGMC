<Window x:Class="GmcSmeta.App.ObjectDialog" UseLayoutRounding="True" SnapsToDevicePixels="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Свойства карточки" Width="620" Height="420" MinWidth="540" MinHeight="340"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA" ResizeMode="CanResize"
        FontFamily="{StaticResource UiFontFamily}" FontSize="{StaticResource UiBodySize}"
        Foreground="#0F172A" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="{StaticResource LayoutFormDialogMargin}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="{StaticResource LayoutFormFieldMargin}">
            <TextBlock x:Name="Heading" Text="Новый договор" TextWrapping="Wrap" FontSize="{StaticResource UiH2Size}" FontWeight="SemiBold"/>
            <TextBlock x:Name="AgreementInfoText" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="Label"><Setter Property="Foreground" Value="#475569"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/><Setter Property="FontSize" Value="{StaticResource UiBodySize}"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="{StaticResource LayoutFormLabelMargin}"/><Setter Property="Padding" Value="0"/></Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                    <Setter Property="Margin" Value="{StaticResource LayoutFormFieldMargin}"/>
                    <Setter Property="Background" Value="White"/>
                </Style>
            </Grid.Resources>
            <Label Content="Название карточки"/><TextBox x:Name="NameInput" Grid.Column="1" ToolTip="ЖК Зелёный бульвар-2, корпус 1"/>
            <Label Grid.Row="1" Content="Заказчик"/><TextBox x:Name="CustomerInput" Grid.Row="1" Grid.Column="1"/>
            <Label Grid.Row="2" Content="Адрес стройки"/><TextBox x:Name="AddressInput" Grid.Row="2" Grid.Column="1"/>
            <Label Grid.Row="3" Content="Папка документов"/>
            <DockPanel Grid.Row="3" Grid.Column="1" Margin="{StaticResource LayoutFormFieldMargin}">
                <Button DockPanel.Dock="Right" Style="{StaticResource PythonToolbarButton}" Content="Обзор…" Click="Browse_Click" Margin="8,0,0,0"/>
                <TextBox x:Name="FolderInput" Margin="0" ToolTip="Папка для сохранения КП, КС и сводных"/>
            </DockPanel>
            <Label Grid.Row="4" Content="Тег заказчика"/>
            <ComboBox x:Name="TagInput" Grid.Row="4" Grid.Column="1" DisplayMemberPath="Caption" SelectedValuePath="Key" Margin="{StaticResource LayoutFormFieldMargin}"
                      ToolTip="Новые документы карточки получат этот тег (правила заказчика)"/>
            <Label Grid.Row="5" Content="Примечание" VerticalAlignment="Top" Margin="0,6,9,0"/>
            <TextBox x:Name="NoteInput" Grid.Row="5" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="70" VerticalAlignment="Top"/>
        </Grid>
        </ScrollViewer>
        <TextBlock x:Name="ValidationMessage" Grid.Row="2" Foreground="#DC2626" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,8">
            <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
        </TextBlock>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Content="Сохранить" IsDefault="True" Click="Save_Click" Style="{StaticResource PrimaryButton}" MinWidth="122" MinHeight="34" Margin="0,0,8,0"/>
            <Button Style="{StaticResource PythonToolbarButton}" Content="Отмена" IsCancel="True" MinWidth="122" MinHeight="34"/>
        </StackPanel>
    </Grid>
</Window>
