<Window x:Class="GmcSmeta.App.ObjectDialog" UseLayoutRounding="True" SnapsToDevicePixels="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Объект" Width="620" Height="480" MinWidth="540" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA" ResizeMode="CanResize"
        FontFamily="{StaticResource UiFontFamily}" FontSize="{StaticResource UiBodySize}"
        Foreground="#0F172A" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="Heading" Text="Новый объект" FontSize="{StaticResource UiH2Size}" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="Label"><Setter Property="Foreground" Value="#475569"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/><Setter Property="FontSize" Value="{StaticResource UiBodySize}"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,9,10"/><Setter Property="Padding" Value="0"/></Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                    <Setter Property="Margin" Value="0,0,0,10"/>
                    <Setter Property="Background" Value="White"/>
                </Style>
            </Grid.Resources>
            <Label Content="Название"/><TextBox x:Name="NameInput" Grid.Column="1" ToolTip="ЖК Зелёный бульвар-2, корпус 1"/>
            <Label Grid.Row="1" Content="Заказчик"/><TextBox x:Name="CustomerInput" Grid.Row="1" Grid.Column="1"/>
            <Label Grid.Row="2" Content="Адрес"/><TextBox x:Name="AddressInput" Grid.Row="2" Grid.Column="1"/>
            <Label Grid.Row="3" Content="Папка документов"/>
            <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource PythonToolbarButton}" Content="Обзор…" Click="Browse_Click" Margin="8,0,0,0"/>
                <TextBox x:Name="FolderInput" Margin="0" ToolTip="Папка для сохранения КП, КС и сводных"/>
            </DockPanel>
            <Label Grid.Row="4" Content="Тег заказчика"/>
            <ComboBox x:Name="TagInput" Grid.Row="4" Grid.Column="1" DisplayMemberPath="Caption" SelectedValuePath="Key" Padding="8,5" Margin="0,0,0,10"
                      ToolTip="Новые документы объекта получат этот тег (правила заказчика)"/>
            <Label Grid.Row="5" Content="Примечание" VerticalAlignment="Top" Margin="0,6,9,0"/>
            <TextBox x:Name="NoteInput" Grid.Row="5" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="70" VerticalAlignment="Top"/>
        </Grid>
        <TextBlock x:Name="ValidationMessage" Grid.Row="2" Foreground="#DC2626" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,8"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Content="Сохранить" IsDefault="True" Click="Save_Click" Style="{StaticResource PrimaryButton}" Width="122" Height="34" Margin="0,0,8,0"/>
            <Button Style="{StaticResource PythonToolbarButton}" Content="Отмена" IsCancel="True" Width="122" Height="34"/>
        </StackPanel>
    </Grid>
</Window>
