<Window x:Class="GmcSmeta.App.KsGroupReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GmcSmeta.App"
        Title="Общая КС-3 и комплект КС-2" Width="1070" Height="730"
        MinWidth="850" MinHeight="510" WindowStartupLocation="CenterOwner"
        Background="#F4F6FA" FontFamily="{StaticResource UiFontFamily}"
        FontSize="{StaticResource UiBodySize}"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}" Foreground="#0F172A" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- The export commands stay visible on a compact 125%-DPI window:
             the entire action group can move below the report title. -->
        <WrapPanel Grid.Row="0" VerticalAlignment="Center">
            <StackPanel MinWidth="200" MaxWidth="420" Margin="0,0,16,7">
                <TextBlock x:Name="TitleText" Text="Общая КС-3"
                           FontSize="{StaticResource UiH1Size}" FontWeight="Bold"
                           Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SubtitleText" Foreground="#64748B" Margin="0,5,0,0"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </StackPanel>
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,7">
                <Button x:Name="ExcelButton" Content="Комплект КС-2 + общая КС-3" ContentTemplate="{StaticResource IconLabelDownload}"
                        Click="Excel_Click" IsEnabled="False"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,8,5"/>
                <Button x:Name="PdfButton" Content="КС-2 + КС-3 PDF" ContentTemplate="{StaticResource IconLabelDownload}"
                        Click="Pdf_Click" IsEnabled="False"
                        Style="{StaticResource PythonToolbarButton}" Margin="0,0,8,5"/>
                <Button x:Name="VorButton" Content="ВОР выбранного акта" ContentTemplate="{StaticResource IconLabelDownload}"
                        Click="Vor_Click" IsEnabled="False"
                        Style="{StaticResource PythonToolbarButton}" Margin="0,0,8,5"/>
                <Button Style="{StaticResource PythonToolbarButton}" Content="Закрыть"
                        Click="Close_Click" Margin="0,0,0,5"/>
            </WrapPanel>
        </WrapPanel>
        <Border Grid.Row="1" BorderBrush="#F1DEBD" BorderThickness="1"
                Background="#FFF8EB" CornerRadius="8" Padding="10"
                Margin="0,12,0,10">
            <TextBlock Text="Excel использует бланки ДНС/Р4 и ВОР из Python; PDF создаётся в типовом печатном оформлении. «Днепровский» требует внешний оригинал. Перед подписанием сверьте суммы и вид формы."
                       TextWrapping="Wrap" Foreground="#8B5E20"/>
        </Border>
        <UniformGrid Grid.Row="2" Columns="5" Margin="0,0,0,9">
            <Border Style="{StaticResource PythonTile}" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="КС-2 в группе" Style="{StaticResource PythonTileLabel}" Foreground="#64748B" TextWrapping="Wrap"/>
                    <TextBlock x:Name="CountText" FontSize="{StaticResource UiH2Size}" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Style="{StaticResource PythonTile}" Background="#EAF2FF"
                    BorderBrush="#D4E4FA" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="За период без НДС" Style="{StaticResource PythonTileLabel}" Foreground="#476A98" TextWrapping="Wrap"/>
                    <TextBlock x:Name="PeriodText" FontSize="{StaticResource UiH2Size}" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Style="{StaticResource PythonTile}" Background="#EAF2FF"
                    BorderBrush="#D4E4FA" Margin="0,0,8,0">
                <StackPanel><TextBlock x:Name="YearAmountLabel" Text="С начала года без НДС" Style="{StaticResource PythonTileLabel}" Foreground="#476A98" TextWrapping="Wrap"/>
                    <TextBlock x:Name="YearText" FontSize="{StaticResource UiH2Size}" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Style="{StaticResource PythonTile}" Background="#EAF2FF"
                    BorderBrush="#D4E4FA" Margin="0,0,8,0">
                <StackPanel><TextBlock x:Name="StartAmountLabel" Text="С начала работ без НДС" Style="{StaticResource PythonTileLabel}" Foreground="#476A98" TextWrapping="Wrap"/>
                    <TextBlock x:Name="StartText" FontSize="{StaticResource UiH2Size}" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border CornerRadius="12" Padding="16,11">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2563EB" Offset="0"/>
                        <GradientStop Color="#4F46E5" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel><TextBlock Text="ИТОГО с НДС, ₽" Style="{StaticResource PythonTileLabel}" Foreground="White" TextWrapping="Wrap"/>
                    <TextBlock x:Name="GrossText" Foreground="White"
                               FontSize="{StaticResource UiH2Size}" FontWeight="Bold"/></StackPanel>
            </Border>
        </UniformGrid>
        <Grid Grid.Row="3">
            <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="White" BorderBrush="#E4E8EF" BorderThickness="1"
                    CornerRadius="12" Margin="0,0,0,9" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Акты, включённые в КС-3" FontWeight="SemiBold"
                               Margin="2,0,0,8"/>
                    <DataGrid local:TableColumnMenu.Key="ks-group-acts" local:TableColumnMenu.Protect="КС-2" CellStyle="{StaticResource CompactCostCell}" x:Name="ActGrid" IsReadOnly="True" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              ColumnHeaderStyle="{StaticResource KsQuantityHeader}"
                              RowHeaderWidth="0" MinRowHeight="24"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              RowStyle="{StaticResource KsReportRow}" AlternationCount="2"
                              GridLinesVisibility="All" HorizontalGridLinesBrush="#E4E8EF" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="КС-2" Binding="{Binding Number}" Width="110" HeaderStyle="{StaticResource KsQuantityHeader}" ElementStyle="{StaticResource CompactCostCenter}"/>
                            <DataGridTextColumn Header="Приложение / ДС" Binding="{Binding SourceName}" Width="*" HeaderStyle="{StaticResource KsTextHeader}" ElementStyle="{StaticResource CompactCostText}"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="110" HeaderStyle="{StaticResource KsQuantityHeader}" ElementStyle="{StaticResource CompactCostCenter}"/>
                            <DataGridTextColumn Header="Без НДС, ₽" Binding="{Binding Ks3Net, StringFormat=N2}"
                                                Width="140" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                            <DataGridTextColumn Header="НДС, ₽" Binding="{Binding Vat, StringFormat=N2}"
                                                Width="105" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                            <DataGridTextColumn Header="С НДС, ₽" Binding="{Binding Total, StringFormat=N2}"
                                                Width="140" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Row="1" Background="White" BorderBrush="#E4E8EF"
                    BorderThickness="1" CornerRadius="12" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Предыдущие КС-3 для накопительного расчёта"
                               FontWeight="SemiBold" Margin="2,0,0,8"/>
                    <DataGrid local:TableColumnMenu.Key="ks-group-previous" local:TableColumnMenu.Protect="Номер группы" CellStyle="{StaticResource CompactCostCell}" x:Name="PreviousGrid" IsReadOnly="True" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" RowHeaderWidth="0"
                              ColumnHeaderStyle="{StaticResource KsQuantityHeader}" MinRowHeight="24"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              RowStyle="{StaticResource KsReportRow}" AlternationCount="2"
                              GridLinesVisibility="All" HorizontalGridLinesBrush="#E4E8EF" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Номер группы" Binding="{Binding Key}" Width="140" HeaderStyle="{StaticResource KsQuantityHeader}" ElementStyle="{StaticResource CompactCostCenter}"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="130" HeaderStyle="{StaticResource KsQuantityHeader}" ElementStyle="{StaticResource CompactCostCenter}"/>
                            <DataGridTextColumn Header="Без НДС, ₽" Binding="{Binding Net, StringFormat=N2}"
                                                Width="175" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                            <DataGridTextColumn Header="НДС, ₽" Binding="{Binding Vat, StringFormat=N2}"
                                                Width="140" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                            <DataGridTextColumn Header="С НДС, ₽" Binding="{Binding Gross, StringFormat=N2}"
                                                Width="175" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
        <DockPanel Grid.Row="4" Margin="2,10,2,0">
            <TextBlock x:Name="StatusText" Text="Загрузка из SQL Server…"
                       Foreground="#64748B" TextWrapping="Wrap"/>
            <TextBlock DockPanel.Dock="Right" x:Name="VatText" Foreground="#64748B"
                       HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</Window>
