<UserControl x:Class="GmcSmeta.App.EstimateView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GmcSmeta.App"
        Background="#F4F6FA"
        FontFamily="{StaticResource UiFontFamily}" FontSize="{StaticResource UiBodySize}"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" PreviewKeyDown="EstimateView_PreviewKeyDown"
         SizeChanged="EstimateView_SizeChanged" Unloaded="EstimateView_Unloaded"
         PreviewMouseWheel="EstimateView_PreviewMouseWheel"
         Loaded="EstimateView_Loaded">

    <UserControl.Resources>
        <local:LevelIndentConverter x:Key="Indent"/>
        <BooleanToVisibilityConverter x:Key="OnlySystems"/>
        <Style x:Key="DocumentNameDisplay" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled, Source={x:Static local:NameWrapPreference.Current}}" Value="False">
                    <Setter Property="TextWrapping" Value="NoWrap"/>
                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Python cost_view.py / theme.py: secondary tabs are smaller and use
             the light accent, not the primary blue gradient. -->
        <Style x:Key="ContractCostSubTab" TargetType="RadioButton" BasedOn="{StaticResource ObjectSubTab}">
            <Setter Property="MinWidth" Value="136"/>
        </Style>

        <!-- kp_editor.py: min 90 plus the 6px right gap in the tab template. -->
        <Style x:Key="DocumentMainTab" TargetType="RadioButton" BasedOn="{StaticResource ObjectTab}">
            <Setter Property="MinWidth" Value="96"/>
        </Style>
        <!-- Compact document toolbar: preserve the existing command handlers and hit targets. -->
        <Style x:Key="DocumentFlatTool" TargetType="Button" BasedOn="{StaticResource PythonToolbarButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="9,6"/>
        </Style>
        <Style x:Key="DocumentTitleEdit" TargetType="Button" BasedOn="{StaticResource DocumentFlatTool}">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style x:Key="DocumentSplitLeft" TargetType="Button" BasedOn="{StaticResource PythonToolbarMain}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,0,1" CornerRadius="8,0,0,8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E8F0FE"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#D9E6FD"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DocumentSplitRight" TargetType="Button" BasedOn="{StaticResource DocumentSplitLeft}">
            <Setter Property="MinWidth" Value="18"/>
            <Setter Property="Padding" Value="2,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="0,8,8,0" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E8F0FE"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#D9E6FD"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The cell owns the inset; display and edit both use the full remaining width. -->
        <Style x:Key="Money" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="EstimateGridEditor" TargetType="TextBox" BasedOn="{StaticResource PythonGridEditor}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="EstimateCenteredEditor" TargetType="TextBox" BasedOn="{StaticResource EstimateGridEditor}">
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="EstimateMoneyEditor" TargetType="TextBox" BasedOn="{StaticResource EstimateGridEditor}">
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <!-- Python ui/common.py menu_header: grey caption inside a menu. -->
        <Style x:Key="EstimateMenuHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="{StaticResource UiSummaryCaptionSize}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="14,6,14,2"/>
        </Style>
        <!-- Actions uses buttons because existing handlers update their visibility/content.
             Match the shared QMenu row metrics without replacing those handlers. -->
        <Style x:Key="EstimateMenuItem" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource UiBodySize}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,7,28,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ContentTemplate">
                <Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ItemChrome" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Canvas Width="24" Height="24">
                                        <Path x:Name="MenuGlyph" Style="{StaticResource SvgGlyphPath}"
                                              Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stroke="#64748B"/>
                                    </Canvas>
                                </Viewbox>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#E8F0FE"/>
                                <Setter Property="Foreground" Value="#1E40AF"/>
                                <Setter TargetName="MenuGlyph" Property="Stroke" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#E8F0FE"/>
                                <Setter Property="Foreground" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#D9E6FD"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="{StaticResource GlyphTrash}">
                                <Setter TargetName="MenuGlyph" Property="Stroke" Value="#DC2626"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter TargetName="MenuGlyph" Property="Stroke" Value="#94A3B8"/>
                                <Setter TargetName="ItemChrome" Property="Background" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Python theme.py QLineEdit: rounded money input inside totals tiles. -->
        <Style x:Key="PythonMoneyEdit" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="FontSize" Value="{StaticResource UiMoneyInputSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Цена: у позиции без цены — красная, как в Python-версии. -->
        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="EstimateTextCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="Price" TargetType="TextBlock" BasedOn="{StaticResource Money}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasNoPrice}" Value="True">
                    <Setter Property="Foreground" Value="#DC2626"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource GridSelectionTextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Share the header template, including sort indicator and resize grips. -->
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ReportGridHeader}">
            <Setter Property="Padding" Value="6,8"/>
            <Setter Property="MinHeight" Value="31"/>
        </Style>

        <Style x:Key="EstimateCell" TargetType="DataGridCell" BasedOn="{StaticResource PythonGridCell}">
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <!-- Paint the frame above the cell, not as a layout border. Focus/hover
                 must never change the available width or the text baseline. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Grid SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <Rectangle Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" IsHitTestVisible="False"/>
                            <Rectangle x:Name="EstimateFocusFrame" Stroke="Transparent" StrokeThickness="2" Margin="1" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="EstimateFocusFrame" Property="Stroke" Value="{StaticResource GridFocusBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEditing" Value="True">
                                <Setter TargetName="EstimateFocusFrame" Property="Stroke" Value="{StaticResource GridFocusBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource GridSelectionBrush}"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                    <Setter Property="BorderBrush" Value="#93B4E9"/>
                </Trigger>
                <!-- Python GridDelegate.paint: the cell under the mouse gets a light blue frame
                     (QPen(QColor(37, 99, 235, 140), 1)); the whole row is lit by the stylesheet. -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#87A9F4"/>
                </Trigger>
                <!-- Python: the current cell — a firm blue frame, like Excel's cell cursor
                     (QPen(QColor(C["accent"]), 2), r.adjusted(1, 1, -1, -1)). No fill. -->
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsEditing" Value="True">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell" BasedOn="{StaticResource PythonGridCell}">
            <Setter Property="Padding" Value="3,0"/>
        </Style>

        <Style x:Key="EstimatePriceCell" TargetType="DataGridCell" BasedOn="{StaticResource EstimateCell}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasNoPrice}" Value="True"/>
                        <Condition Binding="{Binding IsGroup}" Value="False"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False"/>
                        <Condition Binding="{Binding IsEditing, RelativeSource={RelativeSource Self}}" Value="False"/>
                        <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#FDF0F0"/>
                    <Setter Property="ToolTip" Value="Цена не указана. Двойной щелчок — ввести цену."/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EstimateRow" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="27"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSystem}" Value="True">
                    <Setter Property="Background" Value="#F1F4F9"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <!-- Do not fix system-row height: long titles must wrap like Python. -->
                    <Setter Property="Foreground" Value="{StaticResource GridSelectionTextBrush}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSystem}" Value="True"/>
                        <Condition Binding="{Binding Level}" Value="1"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Background" Value="#E8F5FC"/>
                    <Setter Property="Foreground" Value="#246B91"/>
                </MultiDataTrigger>
                <!-- Python grp_bg: a synthetic equal-position header. -->
                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                    <Setter Property="Background" Value="#F5F8FF"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSub}" Value="True">
                    <Setter Property="Foreground" Value="#64748B"/>
                    <Setter Property="FontStyle" Value="Italic"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding OutOfKp}" Value="True">
                    <Setter Property="Background" Value="#FFF8E6"/>
                    <Setter Property="Foreground" Value="#975A16"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F9FAFC"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource GridSelectionBrush}"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource PythonTile}">
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <Style x:Key="CardCaption" TargetType="TextBlock" BasedOn="{StaticResource PythonTileLabel}"/>
        <Style x:Key="CardValue" TargetType="TextBlock" BasedOn="{StaticResource PythonTileValue}">
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <!-- Python QToolButton[checkable=true]: purchase column is a compact button, not a square checkbox. -->
        <Style x:Key="PythonToolbarToggle" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource UiBodySize}"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="ToggleChrome" Background="#FFFFFF" BorderBrush="#E4E8EF"
                                BorderThickness="1" CornerRadius="8" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleChrome" Property="Background" Value="#F1F4F9"/>
                                <Setter TargetName="ToggleChrome" Property="BorderBrush" Value="#C9D3E1"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleChrome" Property="Background" Value="#E8F0FE"/>
                                <Setter TargetName="ToggleChrome" Property="BorderBrush" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#1E40AF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Python kp_editor.py: Page background and 24/18 margin; no white header strip.
             Line 1: object crumb + chips «КП» / организация / замок; line 2: title + pencil.
             Buttons top-right: Отменить · Вернуть · Помощь · Действия · Сохранить в Excel / PDF. -->
        <Border Grid.Row="0" Background="Transparent" BorderThickness="0"
                Padding="{StaticResource LayoutPageHeaderPadding}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Top">
                    <DockPanel LastChildFill="True" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border DockPanel.Dock="Right" x:Name="LockChip" Margin="6,0,0,0" Background="#FEF3E2"
                            CornerRadius="9" Padding="9,2" VerticalAlignment="Center" Visibility="Collapsed"
                            ToolTip="Смета подписана и заблокирована">
                        <TextBlock Text="🔒 Подписан" Foreground="#B45309"
                                   FontSize="{StaticResource UiCaptionSize}" FontWeight="SemiBold"/>
                    </Border>
                        <Border DockPanel.Dock="Right" x:Name="CompanyChip" Margin="6,0,0,0" Background="#F1F4F9"
                            CornerRadius="9" Padding="9,2" VerticalAlignment="Center">
                        <TextBlock x:Name="CompanyText" Foreground="#64748B" MaxWidth="180" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   FontSize="{StaticResource UiCaptionSize}"/>
                    </Border>
                        <Border DockPanel.Dock="Right" x:Name="DocumentKindChip" Margin="6,0,0,0" Background="#E8F0FE"
                            CornerRadius="9" Padding="9,2" VerticalAlignment="Center">
                        <TextBlock x:Name="DocumentKindText" Foreground="#1D4ED8"
                                   FontSize="{StaticResource UiCaptionSize}" FontWeight="SemiBold"/>
                    </Border>
                        <TextBlock x:Name="SubtitleText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                               Foreground="#64748B" FontSize="{StaticResource UiCaptionSize}"/>
                    </DockPanel>
                    <DockPanel HorizontalAlignment="Left" LastChildFill="True" Margin="0,2,0,0">
                        <Button x:Name="EditTitleButton" DockPanel.Dock="Right" Click="EditTitle_Click" Margin="4,0,0,0"
                                ToolTip="Номер, дата и название документа. Двойной щелчок — изменить"
                                Style="{StaticResource DocumentTitleEdit}" Content="Изменить" ContentTemplate="{StaticResource IconOnlyEdit}" AutomationProperties.Name="Изменить реквизиты документа"/>
                        <TextBlock x:Name="TitleText" FontSize="{StaticResource UiValueSize}" VerticalAlignment="Center" FontWeight="Bold"
                                   Foreground="#0F172A" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </DockPanel>
                    <Border x:Name="SourceCheckChip" HorizontalAlignment="Left" Background="#FEE2E2"
                            CornerRadius="8" Padding="8,3" Margin="0,4,0,0" Visibility="Collapsed">
                        <TextBlock Text="✗ Не сходится с файлом" Foreground="#B91C1C"
                                   FontSize="{StaticResource UiCaptionSize}" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="UndoButton" Style="{StaticResource PythonToolbarButton}" Content="Отменить" ContentTemplate="{StaticResource IconLabelUndo}" Click="Undo_Click" ToolTip="Отменить последнее действие (Ctrl+Z)" IsEnabled="False" Margin="0,0,3,0"/>
                    <Button x:Name="RedoButton" Style="{StaticResource PythonToolbarButton}" Content="Вернуть" ContentTemplate="{StaticResource IconLabelRedo}" Click="Redo_Click" ToolTip="Вернуть отменённое (Ctrl+Y)" IsEnabled="False" Margin="0,0,8,0"/>
                    <Button Content="Помощь" Style="{StaticResource PythonToolbarButton}" Click="Help_Click" Margin="0,0,6,0"/>
                    <Button x:Name="MoreActionsButton" Style="{StaticResource PythonToolbarButton}" Content="Действия" ContentTemplate="{StaticResource IconLabelMore}" Click="MoreActions_Click"
                            ToolTip="Всё, что делается с документом целиком" Margin="0,0,8,0"/>
                    <Button x:Name="ExportButton" Style="{StaticResource PythonToolbarPrimary}" Content="Сохранить в Excel / PDF" ContentTemplate="{StaticResource IconLabelDownload}" Click="ExportExcelPdf_Click"
                            ToolTip="Выгрузка сметы в Excel и PDF (Ctrl+E)"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Python parity: contract navigation differs from KP navigation. -->
        <Border Grid.Row="1" Background="#F4F6FA" Padding="{StaticResource LayoutDocumentTabsPadding}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          PanningMode="HorizontalOnly" CanContentScroll="False">
                <Grid>
                    <StackPanel x:Name="KpDocumentTabs" Orientation="Horizontal">
                    <RadioButton x:Name="EstimateModeTab" GroupName="EstimatePage" Tag="estimate"
                                 Content="Смета" ContentTemplate="{StaticResource IconLabelList}" Style="{StaticResource DocumentMainTab}" IsChecked="True"
                                 Checked="ViewMode_Checked"/>
                    <RadioButton x:Name="MaterialsModeTab" GroupName="EstimatePage" Tag="materials"
                                 Content="Материалы" ContentTemplate="{StaticResource IconLabelBuilding}" Style="{StaticResource DocumentMainTab}"
                                 Checked="ViewMode_Checked"/>
                    <RadioButton x:Name="SummaryModeTab" GroupName="EstimatePage" Tag="summary"
                                 Content="Сводная" Style="{StaticResource DocumentMainTab}"
                                 Checked="ViewMode_Checked"/>
                    <RadioButton x:Name="TotalsModeTab" GroupName="EstimatePage" Tag="totals"
                                 Content="Итоги" Style="{StaticResource DocumentMainTab}"
                                 Checked="ViewMode_Checked"/>
                    <!-- Python kp_editor: phase selector «1 · Объёмы ▾» (kp_workflow.PHASES)
                         and «Скопировать расценки» sit right after the tabs for a plain KP. -->
                    <Button x:Name="PhaseButton" Style="{StaticResource PythonToolbarButton}"
                            Click="Phase_Click" Visibility="Collapsed" Margin="8,0,6,6" MinWidth="0"
                            ToolTip="Подготовка КП. Нажмите, чтобы передать на следующий этап">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphHistory}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}"/></Canvas></Viewbox>
                             <TextBlock x:Name="PhaseButtonText" Text="Этап ▾" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="TransferRatesButton" Style="{StaticResource PythonToolbarButton}"
                            Content="Скопировать расценки" ContentTemplate="{StaticResource IconLabelCopy}" Click="TransferRates_Click" Visibility="Collapsed"
                            Margin="0,0,6,6" MinWidth="0"
                            ToolTip="Скопировать цены из другого КП: СМР или материалы"/>
                </StackPanel>
                <StackPanel x:Name="ContractDocumentTabs" Orientation="Horizontal" Visibility="Collapsed">
                    <RadioButton x:Name="ContractEstimateTab"
                                  GroupName="ContractNavigation" IsChecked="True"
                                  Checked="ContractEstimate_Checked"
                                 Style="{StaticResource DocumentMainTab}"
                                  Content="Смета" ContentTemplate="{StaticResource IconLabelList}"/>
                    <RadioButton x:Name="ContractCostsTab" GroupName="ContractNavigation"
                                 Checked="ContractCosts_Checked" Style="{StaticResource DocumentMainTab}"
                                 ToolTip="Встроенная вкладка договора"
                                  Content="Себестоимость" ContentTemplate="{StaticResource IconLabelBuilding}"/>
                    <RadioButton x:Name="ContractProcurementTab" GroupName="ContractNavigation"
                                 Checked="ContractProcurement_Checked" Style="{StaticResource DocumentMainTab}"
                                 ToolTip="Встроенная вкладка договора"
                                  Content="Закупки" ContentTemplate="{StaticResource IconLabelDownload}"/>
                    <RadioButton x:Name="ContractShipmentsTab" GroupName="ContractNavigation"
                                 Checked="ContractShipments_Checked" Style="{StaticResource DocumentMainTab}"
                                 ToolTip="Встроенная вкладка договора"
                                  Content="Выдача" ContentTemplate="{StaticResource IconLabelUpload}"/>
                    <RadioButton x:Name="ContractActsTab"
                                  GroupName="ContractNavigation" Tag="acts"
                                  Checked="ContractActs_Checked"
                                  Style="{StaticResource DocumentMainTab}"
                                  ToolTip="Встроенные акты, КС-3 и сводная по выполнению"
                                  Content="КС-2 / КС-3" ContentTemplate="{StaticResource IconLabelFile}"/>
                </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Contract cost navigation is a second row, never the flat KP strip.
             It shares the tools row because the estimate toolbar is hidden on Costs. -->
        <Border x:Name="ContractCostNavigation" Grid.Row="2" Visibility="Collapsed"
                Background="Transparent" Padding="{StaticResource LayoutDocumentToolbarMargin}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          PanningMode="HorizontalOnly" CanContentScroll="False">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ContractMaterialsModeTab" GroupName="ContractCostSection"
                                 Tag="materials" Content="Материалы" IsChecked="True"
                                 Style="{StaticResource ContractCostSubTab}" Checked="ContractCostMode_Checked"/>
                    <RadioButton x:Name="ContractSummaryModeTab" GroupName="ContractCostSection"
                                 Tag="summary" Content="Сводная"
                                 Style="{StaticResource ContractCostSubTab}" Checked="ContractCostMode_Checked"/>
                    <RadioButton x:Name="ContractTotalsModeTab" GroupName="ContractCostSection"
                                 Tag="totals" Content="Итоги"
                                 Style="{StaticResource ContractCostSubTab}" Checked="ContractCostMode_Checked"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Python kp_editor: left = add + view controls; right = Закуп, Столбцы, search. -->
        <local:ResponsiveToolbarPanel x:Name="EstimateToolsBar" Grid.Row="2" Margin="{StaticResource LayoutDocumentToolbarMargin}">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,2,4">
                    <Button x:Name="AddRowButton" Style="{StaticResource DocumentSplitLeft}" Click="AddRow_Click"
                            Content="+ Строка" ContentTemplate="{StaticResource IconLabelRowPlus}" IsEnabled="False"
                            AutomationProperties.Name="Добавить строку" ToolTip="Добавить строку (Insert)"/>
                    <Button Style="{StaticResource DocumentSplitRight}" Click="AddOptions_Click"
                            AutomationProperties.Name="Варианты добавления"
                            ToolTip="Добавить систему, подраздел, комплектующее или строки из Excel"
                            IsEnabled="{Binding IsEnabled, ElementName=AddRowButton}">
                        <Viewbox Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphChevronDown}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}"/></Canvas></Viewbox>
                    </Button>
                </StackPanel>
                <Button Content="Из справочника" ContentTemplate="{StaticResource IconLabelBook}"
                        Style="{StaticResource PythonToolbarButton}" Click="AddFromCatalog_Click"
                        IsEnabled="{Binding IsEnabled, ElementName=AddRowButton}" Margin="0,0,10,4"
                        ToolTip="Добавить позиции из справочника (Ctrl+K)"/>
                <Border Width="1" Height="22" Background="#E4E8EF" VerticalAlignment="Center" Margin="0,0,6,4"/>
                <!-- Python common.view_button: «Группировка» and «Сортировка» — two buttons,
                     each with its own menu; only the on-screen look changes, not the KP order. -->
                <Button x:Name="GroupButton" Style="{StaticResource DocumentFlatTool}" Content="Группировка" ContentTemplate="{StaticResource IconLabelLayers}"
                        Click="GroupMenu_Click" Margin="0,0,6,4"
                        ToolTip="Как показать строки: по системам, одинаковые вместе, по типу, списком. Порядок строк в КП не меняется"/>
                <Button x:Name="SortButton" Style="{StaticResource DocumentFlatTool}" Content="Сортировка" ContentTemplate="{StaticResource IconLabelSort}"
                        Click="SortMenu_Click" Margin="0,0,2,4"
                        ToolTip="Порядок строк на экране: как в КП, по названию, сумме, цене, количеству"/>
                <Button x:Name="NoPriceFilterButton" Style="{StaticResource PythonToolbarButton}" Content="Без цены" ContentTemplate="{StaticResource IconLabelAlert}" Click="NoPriceFilter_Click"
                        Margin="0,0,2,4" Visibility="Collapsed"
                        ToolTip="Показать только позиции без цены. Проставленная цена убирает строку из фильтра"/>
                <Button x:Name="ResetViewButton" Style="{StaticResource PythonToolbarButton}" Content="Как в КП" ContentTemplate="{StaticResource IconLabelX}" Click="ResetView_Click"
                        Margin="0,0,2,4" Visibility="Collapsed"
                        ToolTip="Вернуть исходный вид, порядок, фильтр и группировку"/>
            </WrapPanel>
            <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                <CheckBox x:Name="PurchaseToggle" Style="{StaticResource PythonToolbarToggle}" Content="Закуп" ContentTemplate="{StaticResource IconLabelBuilding}" VerticalAlignment="Center" Margin="0,0,2,4"
                Checked="PurchaseToggle_Changed" Unchecked="PurchaseToggle_Changed"
                ToolTip="Показать закупочную цену рядом с ценой заказчика. Видна только нам"/>
                <Button x:Name="EstimateColumnsButton" Content="Столбцы" ContentTemplate="{StaticResource IconLabelList}" Style="{StaticResource PythonToolbarButton}" Click="Columns_Click" ToolTip="Какие столбцы показывать" Margin="0,0,2,4"/>
                <Grid Width="150" Height="34" Margin="0,0,0,4">
                <TextBox x:Name="EstimateSearch" Style="{StaticResource PythonSearch}" TextChanged="EstimateSearch_TextChanged"
                         ToolTip="Найти в смете…" AutomationProperties.Name="Найти в смете" Padding="30,6,27,6"/>
                 <Viewbox Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphSearch}" Stroke="#94A3B8"/></Canvas></Viewbox>
                <TextBlock Text="Найти в смете…" Foreground="#64748B" Margin="30,0,27,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
                    <TextBlock.Style><Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=EstimateSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
                <Button Content="Очистить" ContentTemplate="{StaticResource IconOnlyX}" Click="ClearEstimateSearch_Click" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Width="26" Height="26" Padding="0"
                        ToolTip="Очистить поиск по смете" AutomationProperties.Name="Очистить поиск по смете">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PythonToolbarButton}">
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=EstimateSearch}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
              </Grid>
            </WrapPanel>
        </local:ResponsiveToolbarPanel>
        <Popup x:Name="ExtraActionsExpander" PlacementTarget="{Binding ElementName=MoreActionsButton}"
               Placement="Bottom" HorizontalOffset="-10" VerticalOffset="-6"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Style="{StaticResource MenuPopupChrome}" MinWidth="380" MaxWidth="530">
                <ScrollViewer MaxHeight="470" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ActionsMenuPanel" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle"
                                PreviewKeyDown="ActionsMenu_PreviewKeyDown">
                        <!-- Python kp_editor.btn_more: QMenu с разделами. -->
                        <TextBlock Text="ДОКУМЕНТ" Style="{StaticResource EstimateMenuHeader}"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Обновить из SQL Server" Click="RefreshNow_Click" Tag="{StaticResource GlyphRefresh}"
                                ToolTip="Перечитать смету из базы, включая изменения коллег"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Свойства: номер, дата, организация, НДС…" Click="EditTitle_Click" Tag="{StaticResource GlyphEdit}"
                                ToolTip="Реквизиты документа"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Заблокировать — смета подписана" Click="LockToggle_Click" Tag="{StaticResource GlyphCheck}" x:Name="LockMenuItem"
                                ToolTip="Цены, количество и строки больше не поменяются случайно"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Создать копию КП (вариант)…" Click="CopyContract_Click" Tag="{StaticResource GlyphDuplicate}"
                                ToolTip="Полная копия документа рядом с этим"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Сделать договором (закупки, выдача, КС)…" Click="MakeContract_Click" Tag="{StaticResource GlyphCheck}" x:Name="MakeContractItem"
                                ToolTip="У КП появятся Закупки, Выдача и КС-2 / КС-3"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Создать допсоглашение к этому договору…" Click="CreateDop_Click" Tag="{StaticResource GlyphFilePlus}" x:Name="CreateDopItem"/>
                        <Button Style="{StaticResource EstimateMenuItem}" x:Name="MoveContractItem" Content="Перенести в другой объект…" Click="MoveContract_Click" Tag="{StaticResource GlyphFilePlus}"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Этапы — вычесть договоры из КП (режим вкл / выкл)" Click="ToggleInlineStages_Click" Tag="{StaticResource GlyphStage}"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Сравнить с другим документом…" Click="CompareDocs_Click" Tag="{StaticResource GlyphList}"/>
                        <Separator Style="{StaticResource MenuSeparator}"/>
                        <TextBlock Text="ЦЕНЫ" Style="{StaticResource EstimateMenuHeader}"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Скопировать расценки" Click="TransferRates_Click" Tag="{StaticResource GlyphCopy}"
                                ToolTip="Скопировать цены из другого КП: СМР или материалы"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Скидка на всю смету…" Click="Discount_Click" Tag="{StaticResource GlyphEdit}"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Цена работы для выделенных строк…" Click="SetWork_Click" Tag="{StaticResource GlyphEdit}"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Цены работ из справочника (где пусто)" Click="FillWork_Click" Tag="{StaticResource GlyphBook}"/>
                        <Separator Style="{StaticResource MenuSeparator}"/>
                        <TextBlock Text="ИЗМЕНЕНИЯ ПРОЕКТА (СПЕЦИФИКАЦИЯ)" Style="{StaticResource EstimateMenuHeader}"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Обновить из новой спецификации (изм.)…" Click="UpdateSpec_Click" Tag="{StaticResource GlyphUpload}"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Что менялось по изм. — отчёты…" Click="SpecHistory_Click" Tag="{StaticResource GlyphHistory}"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Свернуть воздуховоды и изоляцию в м² — по системам" Click="CollapseAreaSystem_Click" Tag="{StaticResource GlyphLayers}"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Свернуть в м² — одной группой на всё КП" Click="CollapseAreaWhole_Click" Tag="{StaticResource GlyphLayers}"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Развернуть м² обратно в строки" Click="ExpandAreaAll_Click" Tag="{StaticResource GlyphList}"/>
                        <Separator Style="{StaticResource MenuSeparator}"/>
                        <TextBlock Text="ОБЪЕКТ" Style="{StaticResource EstimateMenuHeader}"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Список людей на допуск…" Click="ShowPeople_Click" Tag="{StaticResource GlyphUsers}"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Приказы об ответственных…" Click="ShowOrders_Click" Tag="{StaticResource GlyphFile}"/>
                        <Separator Style="{StaticResource MenuSeparator}"/>
                        <TextBlock Text="ПРОЧЕЕ" Style="{StaticResource EstimateMenuHeader}"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="История изменений документа…" Click="ShowHistory_Click" Tag="{StaticResource GlyphHistory}"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Сохранить ссылку на расчёт в папку…" Click="SaveDocumentLink_Click" Tag="{StaticResource GlyphFolder}"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Пересортировать строки КП (запись)…" Click="Sort_Click" Tag="{StaticResource GlyphSort}"
                                ToolTip="Физически изменить порядок строк в SQL Server: отдельно от временного вида"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Удалить документ…" Click="DeleteContract_Click" Tag="{StaticResource GlyphTrash}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>

        <StackPanel Grid.Row="3">
            <!-- Python help.py HintBar("estimate"): a soft blue line with a tip, closed per user. -->
            <Border x:Name="HintBar" Background="#E8F0FE" CornerRadius="8" Margin="24,10,24,0"
                    Padding="12,7,6,7" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="⚠" Foreground="#2563EB" FontSize="14"
                               VerticalAlignment="Top" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" x:Name="HintText" Foreground="#1E40AF" TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Text="«+ Строка» — новая строка, стрелка ▾ — система и всё остальное. Правый щелчок по строке — действия с ней, «Действия» вверху — с документом целиком."/>
                    <Button Grid.Column="2" Content="Понятно" Click="HintClose_Click" Margin="10,0,0,0"
                            Style="{StaticResource PythonToolbarButton}" MinHeight="28" Padding="10,3"/>
                </Grid>
            </Border>
            <Border x:Name="LockedBar" Background="#E7F6EC" BorderBrush="#86C993" BorderThickness="1"
                    CornerRadius="7" Margin="24,10,24,0" Padding="12,6" Visibility="Collapsed">
                <TextBlock Text="Подписано — смета заблокирована. Цены, количество и строки не меняются случайно."
                           Foreground="#166534" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Таблица сметы -->
        <local:SummaryTableFrame x:Name="EstimateTablePanel" Grid.Row="4" Background="White" BorderBrush="#E4E8EF" BorderThickness="1"
                CornerRadius="12" Margin="24,8,24,0">
            <DockPanel>
                <Button x:Name="BottomAddRowButton" DockPanel.Dock="Bottom" Content="Добавить строку"
                        Click="AddRow_Click" IsEnabled="{Binding IsEnabled, ElementName=AddRowButton}"
                        Foreground="#2563EB" BorderThickness="0" Background="Transparent"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" FontWeight="SemiBold"
                        MinHeight="32" Padding="14,0" ToolTip="Добавить позицию после выбранной">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="20" Height="20" Margin="0,0,6,0" IsHitTestVisible="False">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphPlus}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                <!-- Python ui/stage_mode.py: stage cards and segmented filters sit immediately
                     above the same estimate table; document rows and source amounts stay unchanged. -->
                <Border x:Name="InlineStagesBar" DockPanel.Dock="Top" Visibility="Collapsed"
                        Margin="8,8,8,5" Padding="10,8,10,8" CornerRadius="9"
                        Background="#FFFFFF" BorderBrush="#2563EB" BorderThickness="1">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Управление этапами…" Click="OpenStagesDialog_Click"
                                        ToolTip="Создание этапов, изменение количеств, договорные суммы и документ «Остаток»"
                                        Margin="4,0,6,0"/>
                                <Button Content="Выйти из режима" Click="CloseInlineStages_Click"
                                        ToolTip="Убрать колонки этапов из таблицы"/>
                            </StackPanel>
                            <TextBlock Text="ЭТАПЫ" Foreground="#1D4ED8" FontWeight="Bold"
                                       VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
                        </DockPanel>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      Margin="0,6,0,4">
                            <WrapPanel x:Name="InlineStagesCards"/>
                        </ScrollViewer>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Показать:" VerticalAlignment="Center" Foreground="#64748B"
                                       Margin="0,0,7,0"/>
                            <ComboBox x:Name="InlineStagesFilter" Width="183" SelectedIndex="0"
                                      SelectionChanged="InlineStagesFilter_SelectionChanged"
                                      ToolTip="Фильтр этапов не изменяет данные полного КП">
                                <ComboBoxItem Content="Все строки" Tag="all"/>
                                <ComboBoxItem Content="Не распределено" Tag="undistributed"/>
                                <ComboBoxItem Content="В этапах" Tag="assigned"/>
                                <ComboBoxItem Content="Перебор" Tag="overrun"/>
                            </ComboBox>
                            <TextBlock x:Name="InlineStagesSummary" Foreground="#64748B"
                                       VerticalAlignment="Center" Margin="14,0,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <!-- Python stage_mode.picked(): actions apply to selected systems,
                             equal-position groups and actual rows, never the whole КП. -->
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock x:Name="InlineStagesSelectionInfo"
                                       Text="Выдели позиции или системы →"
                                       FontSize="12" Foreground="#475569" Margin="0,0,0,5"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <WrapPanel x:Name="InlineStagesSelectionButtons"/>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <DataGrid x:Name="EstimateGrid" MinRowHeight="27" MinColumnWidth="36" BorderThickness="0" Background="White"
                          ContextMenuOpening="EstimateGrid_ContextMenuOpening"
                       AllowDrop="True"
                       PreviewMouseLeftButtonDown="EstimateGrid_DragMouseDown"
                       PreviewMouseLeftButtonUp="EstimateGrid_DragMouseUp"
                       PreviewMouseMove="EstimateGrid_DragMouseMove"
                       DragOver="EstimateGrid_DragOver"
                       DragLeave="EstimateGrid_DragLeave"
                       Drop="EstimateGrid_Drop"
                      AutoGenerateColumns="False" IsReadOnly="False"
                      BeginningEdit="EstimateGrid_BeginningEdit"
                      PreparingCellForEdit="EstimateGrid_PreparingCellForEdit"
                      CellEditEnding="EstimateGrid_CellEditEnding"
                      HeadersVisibility="Column" GridLinesVisibility="All"
                       HorizontalGridLinesBrush="#E4E8EF" VerticalGridLinesBrush="#E4E8EF"
                      EnableColumnVirtualization="True"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      RowHeaderWidth="0" SelectionMode="Extended" SelectionUnit="FullRow"
                      RowStyle="{StaticResource EstimateRow}"
                      CellStyle="{StaticResource EstimateCell}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      EnableRowVirtualization="True"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.IsDeferredScrollingEnabled="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Resources>
                    <Style TargetType="TextBox" BasedOn="{StaticResource EstimateGridEditor}"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn x:Name="NumberColumn" Header="№" Width="64" IsReadOnly="True" CanUserReorder="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Click="ToggleSection_Click"
                                            ToolTip="Свернуть или развернуть раздел"
                                            AutomationProperties.Name="Свернуть или развернуть раздел"
                                            Width="16" Height="18" MinHeight="0" MinWidth="0" Padding="0"
                                            BorderThickness="0" Background="Transparent"
                                            Visibility="{Binding IsExpandable, Converter={StaticResource OnlySystems}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="SectionChrome" Background="Transparent" CornerRadius="3">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SectionChrome" Property="Background" Value="#E8F0FE"/></Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SectionChrome" Property="Background" Value="#C9DBFB"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Viewbox Width="12" Height="12" Stretch="Uniform" IsHitTestVisible="False">
                                            <Canvas Width="24" Height="24">
                                                <Path Stroke="#475569">
                                                    <Path.Style>
                                                        <Style TargetType="Path" BasedOn="{StaticResource SvgGlyphPath}">
                                                            <Setter Property="Data" Value="{StaticResource GlyphChevronDown}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                                    <Setter Property="Data" Value="M9 6l6 6-6 6"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayNum}" TextAlignment="Center"
                                               HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn x:Name="NameColumn" Header="Наименование" Width="460" MinWidth="190">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                           Margin="{Binding NameIndentLevel, Converter={StaticResource Indent}}"
                                           Padding="0" ToolTip="{Binding Name}" Style="{StaticResource DocumentNameDisplay}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate><TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                   Margin="{Binding NameIndentLevel, Converter={StaticResource Indent}}"
                                                   TextWrapping="Wrap" AcceptsReturn="False"/></DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="BasisColumn" Header="Обоснование"
                                        Binding="{Binding Basis, Mode=TwoWay}" Width="150"
                                        ElementStyle="{StaticResource EstimateTextCell}" EditingElementStyle="{StaticResource EstimateGridEditor}"
                                        Visibility="Collapsed"/>
                    <DataGridTextColumn Header="Ед." Binding="{Binding Unit, Mode=TwoWay}" Width="64" ElementStyle="{StaticResource CenterCell}" EditingElementStyle="{StaticResource EstimateCenteredEditor}"/>
                    <DataGridTextColumn Header="Кол-во" Binding="{Binding QtyText, Mode=TwoWay}"
                                        Width="80" ElementStyle="{StaticResource CenterCell}" EditingElementStyle="{StaticResource EstimateCenteredEditor}"/>
                    <DataGridTemplateColumn Header="Цена" Width="118" CellStyle="{StaticResource EstimatePriceCell}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayPriceText}" Style="{StaticResource Price}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding PriceText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         TextAlignment="Right" VerticalContentAlignment="Center"
                                         ToolTip="Можно формулой: 12*1,15"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding DisplayAmountText}"
                                        Width="130" ElementStyle="{StaticResource Money}" IsReadOnly="True"/>
                    <DataGridTextColumn x:Name="PurchaseColumn" Header="Закупка" Binding="{Binding PurchaseText, Mode=TwoWay}"
                                        Width="110" ElementStyle="{StaticResource Money}" EditingElementStyle="{StaticResource EstimateMoneyEditor}" Visibility="Collapsed"/>
                    <DataGridTemplateColumn x:Name="WorkColumn" Header="Работа за ед." Width="118" Visibility="Collapsed">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding WorkDisplayText}" Style="{StaticResource Money}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding WorkText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         TextAlignment="Right" VerticalContentAlignment="Center"
                                         ToolTip="Можно формулой: 12*1,15"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="WorkTotalColumn" Header="Работа всего"
                                        Binding="{Binding DisplayWorkAmount, StringFormat={}{0:N2}}"
                                        Width="130" ElementStyle="{StaticResource Money}"
                                        IsReadOnly="True" Visibility="Collapsed"/>
                    <DataGridTemplateColumn x:Name="NoteColumn" Header="Примечание" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Note}" Foreground="#64748B"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Note}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate><TextBox Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/></DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn x:Name="AreaUnitColumn" Header="м² за ед."
                                            Width="90" Visibility="Collapsed">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AreaUnitDisplay}"
                                           TextAlignment="Right" VerticalAlignment="Center"
                                           Padding="0" ToolTip="{Binding AreaUnitTip}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#334155"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AreaWarning}" Value="True">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                    <Setter Property="Foreground" Value="#991B1B"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding AreaManualFlag}" Value="True">
                                                    <Setter Property="Foreground" Value="#2563EB"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding AreaUnitEditText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         TextAlignment="Right"
                                         ToolTip="Можно формулой. Пустое — снова считать площадь автоматически."/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="AreaTotalColumn" Header="м² всего"
                                        Binding="{Binding AreaTotalDisplay}" Width="90"
                                        ElementStyle="{StaticResource Money}"
                                        IsReadOnly="True" Visibility="Collapsed"/>
                </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </local:SummaryTableFrame>


        <!-- Python cost_view mat_page: панель инструментов, подсказка, таблица 13 колонок,
             итоговые плитки. Правки идут теми же сервисами, что и вкладка «Смета»/«Закупки». -->
        <Border x:Name="MaterialsPanel" Grid.Row="4" Visibility="Collapsed" Background="Transparent"
                BorderThickness="0" Margin="{StaticResource LayoutEmbeddedPageMargin}" Padding="0"/>
        <!-- Вкладка «Сводная» КП — перенос cost_summary_view.py: таблица директора
             (материалы/работы/итого), фильтры, плитки, запись через SaveSummaryCell. -->
        <Border x:Name="SummaryPanel" Grid.Row="4" Visibility="Collapsed"
                Background="Transparent" BorderThickness="0"
                Margin="{StaticResource LayoutSummaryPageMargin}" Padding="0"/>

        <!-- Create the KS workspace only when the contract's Acts tab is opened. -->
        <Border x:Name="ContractActsPanel" Grid.Row="4" Visibility="Collapsed"
                Background="#F4F6FA"/>
        <!-- The original three SQL Server editors now live inside the contract.
             Controls are created lazily when their tab is first selected. -->
        <Border x:Name="ContractCostsPanel" Grid.Row="4" Visibility="Collapsed"
                Background="#F4F6FA">
            <ContentControl x:Name="ContractCostsHost"/>
        </Border>
        <Border x:Name="ContractProcurementPanel" Grid.Row="4" Visibility="Collapsed"
                Background="#F4F6FA">
            <ContentControl x:Name="ContractProcurementHost"/>
        </Border>
        <Border x:Name="ContractShipmentsPanel" Grid.Row="4" Visibility="Collapsed"
                Background="#F4F6FA">
            <ContentControl x:Name="ContractShipmentsHost"/>
        </Border>
        <!-- Вкладка «Итоги» КП — перенос cost_totals_view.py: итоговые цифры документа
             перед выдачей; статьи — себестоимость/розница/маржа/маржа %; вписываемые
             ячейки #FFF7E6; запись через SqlServerCostTotals.SaveTotalsField. -->
        <Border x:Name="TotalsPanel" Grid.Row="4" Visibility="Collapsed" Background="#F4F6FA"/>

        <!-- Итоги: Python kp_editor tot_bar + 4 tiles (Материалы / Монтаж · СМР /
             Дополнительные расходы / ИТОГО с НДС) в один ряд. -->
        <Border x:Name="TotalsFooterPanel" Grid.Row="5" Padding="{StaticResource LayoutDocumentFooterPadding}" Background="Transparent"
                BorderThickness="0">
            <DockPanel LastChildFill="True">
                <Button x:Name="ToggleTotalsButton" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="10,0,0,0"
                        Style="{StaticResource DocumentFlatTool}" MinHeight="30"
                        Content="Скрыть итоги" ContentTemplate="{StaticResource IconLabelArrowDown}"
                        Foreground="#64748B" Click="ToggleTotals_Click"/>
                <Grid>
                    <TextBlock x:Name="TotalsSummary" Visibility="Collapsed" TextWrapping="Wrap"
                               Foreground="#64748B" VerticalAlignment="Center"/>
                    <local:EstimateTotalsCardsPanel x:Name="TotalsCards" Columns="4">
                <Border x:Name="MaterialsCard" Style="{StaticResource Card}" MinHeight="70">
                    <StackPanel>
                        <TextBlock x:Name="MaterialsCaption" Text="Материалы" Style="{StaticResource CardCaption}"/>
                        <TextBlock x:Name="MaterialsText" Style="{StaticResource CardValue}"/>
                    </StackPanel>
                </Border>
                <Border x:Name="SmrCard" Style="{StaticResource Card}" MinHeight="70">
                    <StackPanel>
                        <TextBlock x:Name="SmrCaption" Text="Монтаж · СМР" Style="{StaticResource CardCaption}"/>
                        <TextBox x:Name="SmrEdit" Style="{StaticResource PythonMoneyEdit}" Margin="0,2,0,0"
                                 KeyDown="TotalsEdit_KeyDown" LostFocus="SmrEdit_Commit"
                                 ToolTip="СМР: общая сумма (Enter — сохранить)"/>
                        <ComboBox x:Name="SmrModeCombo" Margin="0,2,0,0" MinHeight="30" Padding="10,6"
                                  SelectionChanged="SmrModeCombo_SelectionChanged"
                                  ToolTip="Как рассчитывать СМР: общей суммой, процентом от материалов, по системам или по позициям">
                            <ComboBoxItem Content="Суммой, ₽" Tag="sum"/>
                            <ComboBoxItem Content="Процентом, %" Tag="percent"/>
                            <ComboBoxItem Content="По системам" Tag="systems"/>
                            <ComboBoxItem Content="По позициям" Tag="pos"/>
                        </ComboBox>
                        <TextBlock x:Name="SmrHintText" Style="{StaticResource PythonTileLabel}" Margin="0,2,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
                <Border x:Name="ExpensesCard" Style="{StaticResource Card}" MinHeight="70">
                    <StackPanel>
                        <TextBlock Text="Дополнительные расходы" Style="{StaticResource CardCaption}"/>
                        <Border x:Name="TransportCard" Margin="0,2,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Транспорт, ₽" Style="{StaticResource PythonTileLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="TransportEdit" Grid.Column="1" Style="{StaticResource PythonMoneyEdit}" MaxWidth="150" HorizontalAlignment="Stretch"
                                         KeyDown="TotalsEdit_KeyDown" LostFocus="TransportEdit_Commit"
                                         ToolTip="Транспорт: сумма (Enter — сохранить)"/>
                            </Grid>
                        </Border>
                        <Border x:Name="PnrCard" Margin="0,2,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Пусконаладка, ₽" Style="{StaticResource PythonTileLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="PnrEdit" Grid.Column="1" Style="{StaticResource PythonMoneyEdit}" MaxWidth="150" HorizontalAlignment="Stretch"
                                         KeyDown="TotalsEdit_KeyDown" LostFocus="PnrEdit_Commit"
                                         ToolTip="Пусконаладка: сумма (Enter — сохранить)"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
                <Border x:Name="TotalCard" Style="{StaticResource PythonTileAccent}">
                    <StackPanel>
                        <TextBlock x:Name="TotalCaption" Text="ИТОГО с НДС" Foreground="White" FontWeight="SemiBold" FontSize="{StaticResource UiCaptionSize}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TotalText" Style="{StaticResource PythonTileValue}" Foreground="White"
                                   FontSize="{StaticResource UiGrandTotalSize}"/>
                        <TextBlock x:Name="VatText" Foreground="#E6FFFFFF" FontSize="{StaticResource UiTotalDetailSize}" TextWrapping="Wrap"
                                   Margin="0,2,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <TextBlock x:Name="DiscountTotalText" Foreground="#E6FFFFFF" FontSize="{StaticResource UiTotalDetailSize}"
                                   TextWrapping="Wrap" Visibility="Collapsed" Margin="0,2,0,0"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>
                </Border>
                    </local:EstimateTotalsCardsPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
