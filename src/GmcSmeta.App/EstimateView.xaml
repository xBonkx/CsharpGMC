<UserControl x:Class="GmcSmeta.App.EstimateView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GmcSmeta.App"
        Background="#F4F6FA"
        FontFamily="{StaticResource UiFontFamily}" FontSize="{StaticResource UiBodySize}"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" PreviewKeyDown="EstimateView_PreviewKeyDown"
         SizeChanged="EstimateView_SizeChanged" Unloaded="EstimateView_Unloaded"
         PreviewMouseWheel="EstimateView_PreviewMouseWheel"
         Loaded="EstimateView_Loaded">

    <UserControl.Resources>
        <local:LevelIndentConverter x:Key="Indent"/>
        <BooleanToVisibilityConverter x:Key="OnlySystems"/>

        <!-- Python cost_view.py / theme.py: secondary tabs are smaller and use
             the light accent, not the primary blue gradient. -->
        <Style x:Key="ContractCostSubTab" TargetType="RadioButton" BasedOn="{StaticResource ObjectSubTab}">
            <Setter Property="MinWidth" Value="136"/>
        </Style>

        <!-- kp_editor.py: min 90 plus the 6px right gap in the tab template. -->
        <Style x:Key="DocumentMainTab" TargetType="RadioButton" BasedOn="{StaticResource ObjectTab}">
            <Setter Property="MinWidth" Value="96"/>
        </Style>
        <!-- Compact document toolbar: preserve the existing command handlers and hit targets. -->
        <Style x:Key="DocumentFlatTool" TargetType="Button" BasedOn="{StaticResource PythonToolbarButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style x:Key="DocumentTitleEdit" TargetType="Button" BasedOn="{StaticResource DocumentFlatTool}">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style x:Key="DocumentSplitLeft" TargetType="Button" BasedOn="{StaticResource PythonToolbarMain}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,0,1" CornerRadius="8,0,0,8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E8F0FE"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#D9E6FD"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E8F0FE"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DocumentSplitRight" TargetType="Button" BasedOn="{StaticResource DocumentSplitLeft}">
            <Setter Property="MinWidth" Value="18"/>
            <Setter Property="Padding" Value="2,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="0,8,8,0" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E8F0FE"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#D9E6FD"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E8F0FE"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The cell owns the inset; display and edit both use the full remaining width. -->
        <Style x:Key="Money" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="EstimateGridEditor" TargetType="TextBox" BasedOn="{StaticResource PythonGridEditor}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="EstimateCenteredEditor" TargetType="TextBox" BasedOn="{StaticResource EstimateGridEditor}">
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="EstimateMoneyEditor" TargetType="TextBox" BasedOn="{StaticResource EstimateGridEditor}">
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <!-- Python ui/common.py menu_header: grey caption inside a menu. -->
        <Style x:Key="EstimateMenuHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="14,6,14,2"/>
        </Style>
        <!-- Actions uses buttons because existing handlers update their visibility/content.
             Match the shared QMenu row metrics without replacing those handlers. -->
        <Style x:Key="EstimateMenuItem" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource UiBodySize}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,7,28,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ContentTemplate">
                <Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ItemChrome" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Canvas Width="24" Height="24">
                                        <Path x:Name="MenuGlyph" Style="{StaticResource SvgGlyphPath}"
                                              Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stroke="#64748B"/>
                                    </Canvas>
                                </Viewbox>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#E8F0FE"/>
                                <Setter Property="Foreground" Value="#1E40AF"/>
                                <Setter TargetName="MenuGlyph" Property="Stroke" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#E8F0FE"/>
                                <Setter Property="Foreground" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#D9E6FD"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="{StaticResource GlyphTrash}">
                                <Setter TargetName="MenuGlyph" Property="Stroke" Value="#DC2626"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter TargetName="MenuGlyph" Property="Stroke" Value="#94A3B8"/>
                                <Setter TargetName="ItemChrome" Property="Background" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Python theme.py QLineEdit: rounded money input inside totals tiles. -->
        <Style x:Key="PythonMoneyEdit" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Цена: у позиции без цены — красная, как в Python-версии. -->
        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="EstimateTextCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="Price" TargetType="TextBlock" BasedOn="{StaticResource Money}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasNoPrice}" Value="True">
                    <Setter Property="Foreground" Value="#DC2626"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource GridSelectionTextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F7F9FC"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="{StaticResource UiHeaderSize}"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="MinHeight" Value="31"/>
            <Setter Property="BorderBrush" Value="#D0D7E2"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style x:Key="EstimateCell" TargetType="DataGridCell" BasedOn="{StaticResource PythonGridCell}">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <!-- Paint the frame above the cell, not as a layout border. Focus/hover
                 must never change the available width or the text baseline. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Grid SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <Rectangle Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" IsHitTestVisible="False"/>
                            <Rectangle x:Name="EstimateFocusFrame" Stroke="Transparent" StrokeThickness="2" Margin="1" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="EstimateFocusFrame" Property="Stroke" Value="{StaticResource GridFocusBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEditing" Value="True">
                                <Setter TargetName="EstimateFocusFrame" Property="Stroke" Value="{StaticResource GridFocusBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource GridSelectionBrush}"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                    <Setter Property="BorderBrush" Value="#93B4E9"/>
                </Trigger>
                <!-- Python GridDelegate.paint: the cell under the mouse gets a light blue frame
                     (QPen(QColor(37, 99, 235, 140), 1)); the whole row is lit by the stylesheet. -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#87A9F4"/>
                </Trigger>
                <!-- Python: the current cell — a firm blue frame, like Excel's cell cursor
                     (QPen(QColor(C["accent"]), 2), r.adjusted(1, 1, -1, -1)). No fill. -->
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsEditing" Value="True">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell" BasedOn="{StaticResource PythonGridCell}">
            <Setter Property="Padding" Value="3,0"/>
        </Style>

        <Style x:Key="EstimatePriceCell" TargetType="DataGridCell" BasedOn="{StaticResource EstimateCell}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasNoPrice}" Value="True"/>
                        <Condition Binding="{Binding IsGroup}" Value="False"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False"/>
                        <Condition Binding="{Binding IsEditing, RelativeSource={RelativeSource Self}}" Value="False"/>
                        <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#FDF0F0"/>
                    <Setter Property="ToolTip" Value="Цена не указана. Двойной щелчок — ввести цену."/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EstimateRow" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="23"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSystem}" Value="True">
                    <Setter Property="Background" Value="#F1F4F9"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <!-- Do not fix system-row height: long titles must wrap like Python. -->
                    <Setter Property="Foreground" Value="#1A365D"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSystem}" Value="True"/>
                        <Condition Binding="{Binding Level}" Value="1"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Background" Value="#E8F5FC"/>
                    <Setter Property="Foreground" Value="#246B91"/>
                </MultiDataTrigger>
                <!-- Python grp_bg: a synthetic equal-position header. -->
                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                    <Setter Property="Background" Value="#F5F8FF"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSub}" Value="True">
                    <Setter Property="Foreground" Value="#64748B"/>
                    <Setter Property="FontStyle" Value="Italic"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding OutOfKp}" Value="True">
                    <Setter Property="Background" Value="#FFF8E6"/>
                    <Setter Property="Foreground" Value="#975A16"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F9FAFC"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource GridSelectionBrush}"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource PythonTile}">
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <Style x:Key="CardCaption" TargetType="TextBlock" BasedOn="{StaticResource PythonTileLabel}"/>
        <Style x:Key="CardValue" TargetType="TextBlock" BasedOn="{StaticResource PythonTileValue}">
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <!-- Python QToolButton[checkable=true]: purchase column is a compact button, not a square checkbox. -->
        <Style x:Key="PythonToolbarToggle" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource UiBodySize}"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="ToggleChrome" Background="#FFFFFF" BorderBrush="#E4E8EF"
                                BorderThickness="1" CornerRadius="8" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleChrome" Property="Background" Value="#F1F4F9"/>
                                <Setter TargetName="ToggleChrome" Property="BorderBrush" Value="#C9D3E1"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleChrome" Property="Background" Value="#E8F0FE"/>
                                <Setter TargetName="ToggleChrome" Property="BorderBrush" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#1E40AF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Python kp_editor.py: Page background and 24/18 margin; no white header strip.
             Line 1: object crumb + chips «КП» / организация / замок; line 2: title + pencil.
             Buttons top-right: Отменить · Вернуть · Помощь · Действия · Сохранить в Excel / PDF. -->
        <Border Grid.Row="0" Background="Transparent" BorderThickness="0"
                Padding="24,18,24,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Top">
                    <DockPanel LastChildFill="True" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border DockPanel.Dock="Right" x:Name="LockChip" Margin="6,0,0,0" Background="#FEF3E2"
                            CornerRadius="9" Padding="9,2" VerticalAlignment="Center" Visibility="Collapsed"
                            ToolTip="Смета подписана и заблокирована">
                        <TextBlock Text="🔒 Подписан" Foreground="#B45309"
                                   FontSize="{StaticResource UiCaptionSize}" FontWeight="SemiBold"/>
                    </Border>
                        <Border DockPanel.Dock="Right" x:Name="CompanyChip" Margin="6,0,0,0" Background="#F1F4F9"
                            CornerRadius="9" Padding="9,2" VerticalAlignment="Center">
                        <TextBlock x:Name="CompanyText" Foreground="#64748B"
                                   FontSize="{StaticResource UiCaptionSize}"/>
                    </Border>
                        <Border DockPanel.Dock="Right" x:Name="DocumentKindChip" Margin="6,0,0,0" Background="#E8F0FE"
                            CornerRadius="9" Padding="9,2" VerticalAlignment="Center">
                        <TextBlock x:Name="DocumentKindText" Foreground="#1D4ED8"
                                   FontSize="{StaticResource UiCaptionSize}" FontWeight="SemiBold"/>
                    </Border>
                        <TextBlock x:Name="SubtitleText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Foreground="#64748B" FontSize="{StaticResource UiCaptionSize}"/>
                    </DockPanel>
                    <DockPanel HorizontalAlignment="Left" LastChildFill="True" Margin="0,2,0,0">
                        <Button x:Name="EditTitleButton" DockPanel.Dock="Right" Click="EditTitle_Click" Margin="4,0,0,0"
                                ToolTip="Номер, дата и название документа. Двойной щелчок — изменить"
                                Style="{StaticResource DocumentTitleEdit}" Content="Изменить" ContentTemplate="{StaticResource IconOnlyEdit}" AutomationProperties.Name="Изменить реквизиты документа"/>
                        <TextBlock x:Name="TitleText" FontSize="20" VerticalAlignment="Center" FontWeight="Bold"
                                   Foreground="#0F172A" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </DockPanel>
                    <Border x:Name="SourceCheckChip" HorizontalAlignment="Left" Background="#FEE2E2"
                            CornerRadius="8" Padding="8,3" Margin="0,4,0,0" Visibility="Collapsed">
                        <TextBlock Text="✗ Не сходится с файлом" Foreground="#B91C1C"
                                   FontSize="{StaticResource UiCaptionSize}" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="UndoButton" Style="{StaticResource PythonToolbarButton}" Content="Отменить" ContentTemplate="{StaticResource IconLabelUndo}" Click="Undo_Click" ToolTip="Отменить последнее действие (Ctrl+Z)" IsEnabled="False" Margin="0,0,3,0"/>
                    <Button x:Name="RedoButton" Style="{StaticResource PythonToolbarButton}" Content="Вернуть" ContentTemplate="{StaticResource IconLabelRedo}" Click="Redo_Click" ToolTip="Вернуть отменённое (Ctrl+Y)" IsEnabled="False" Margin="0,0,8,0"/>
                    <Button Content="Помощь" Style="{StaticResource PythonToolbarButton}" Click="Help_Click" Margin="0,0,6,0"/>
                    <Button x:Name="MoreActionsButton" Style="{StaticResource PythonToolbarButton}" Content="Действия" ContentTemplate="{StaticResource IconLabelMore}" Click="MoreActions_Click"
                            ToolTip="Всё, что делается с документом целиком" Margin="0,0,8,0"/>
                    <Button x:Name="ExportButton" Style="{StaticResource PythonToolbarPrimary}" Content="Сохранить в Excel / PDF" ContentTemplate="{StaticResource IconLabelDownload}" Click="ExportExcelPdf_Click"
                            ToolTip="Выгрузка сметы в Excel и PDF (Ctrl+E)"/>
                </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Python parity: contract navigation differs from KP navigation. -->
        <Border Grid.Row="1" Background="#F4F6FA" Padding="24,12,24,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          PanningMode="HorizontalOnly" CanContentScroll="False">
                <Grid>
                    <StackPanel x:Name="KpDocumentTabs" Orientation="Horizontal">
                    <RadioButton x:Name="EstimateModeTab" GroupName="EstimatePage" Tag="estimate"
                                 Content="Смета" ContentTemplate="{StaticResource IconLabelList}" Style="{StaticResource DocumentMainTab}" IsChecked="True"
                                 Checked="ViewMode_Checked"/>
                    <RadioButton x:Name="MaterialsModeTab" GroupName="EstimatePage" Tag="materials"
                                 Content="Материалы" ContentTemplate="{StaticResource IconLabelBuilding}" Style="{StaticResource DocumentMainTab}"
                                 Checked="ViewMode_Checked"/>
                    <RadioButton x:Name="SummaryModeTab" GroupName="EstimatePage" Tag="summary"
                                 Content="Сводная" Style="{StaticResource DocumentMainTab}"
                                 Checked="ViewMode_Checked"/>
                    <RadioButton x:Name="TotalsModeTab" GroupName="EstimatePage" Tag="totals"
                                 Content="Итоги" Style="{StaticResource DocumentMainTab}"
                                 Checked="ViewMode_Checked"/>
                    <!-- Python kp_editor: phase selector «1 · Объёмы ▾» (kp_workflow.PHASES)
                         and «Скопировать расценки» sit right after the tabs for a plain KP. -->
                    <Button x:Name="PhaseButton" Style="{StaticResource PythonToolbarButton}"
                            Click="Phase_Click" Visibility="Collapsed" Margin="8,0,6,6" MinWidth="0"
                            ToolTip="Подготовка КП. Нажмите, чтобы передать на следующий этап">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphHistory}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}"/></Canvas></Viewbox>
                             <TextBlock x:Name="PhaseButtonText" Text="Этап ▾" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="TransferRatesButton" Style="{StaticResource PythonToolbarButton}"
                            Content="Скопировать расценки" ContentTemplate="{StaticResource IconLabelCopy}" Click="TransferRates_Click" Visibility="Collapsed"
                            Margin="0,0,6,6" MinWidth="0"
                            ToolTip="Скопировать цены из другого КП: СМР или материалы"/>
                </StackPanel>
                <StackPanel x:Name="ContractDocumentTabs" Orientation="Horizontal" Visibility="Collapsed">
                    <RadioButton x:Name="ContractEstimateTab"
                                  GroupName="ContractNavigation" IsChecked="True"
                                  Checked="ContractEstimate_Checked"
                                 Style="{StaticResource DocumentMainTab}"
                                  Content="Смета" ContentTemplate="{StaticResource IconLabelList}"/>
                    <RadioButton x:Name="ContractCostsTab" GroupName="ContractNavigation"
                                 Checked="ContractCosts_Checked" Style="{StaticResource DocumentMainTab}"
                                 ToolTip="Встроенная вкладка договора"
                                  Content="Себестоимость" ContentTemplate="{StaticResource IconLabelBuilding}"/>
                    <RadioButton x:Name="ContractProcurementTab" GroupName="ContractNavigation"
                                 Checked="ContractProcurement_Checked" Style="{StaticResource DocumentMainTab}"
                                 ToolTip="Встроенная вкладка договора"
                                  Content="Закупки" ContentTemplate="{StaticResource IconLabelDownload}"/>
                    <RadioButton x:Name="ContractShipmentsTab" GroupName="ContractNavigation"
                                 Checked="ContractShipments_Checked" Style="{StaticResource DocumentMainTab}"
                                 ToolTip="Встроенная вкладка договора"
                                  Content="Выдача" ContentTemplate="{StaticResource IconLabelUpload}"/>
                    <RadioButton x:Name="ContractActsTab"
                                  GroupName="ContractNavigation" Tag="acts"
                                  Checked="ContractActs_Checked"
                                  Style="{StaticResource DocumentMainTab}"
                                  ToolTip="Встроенные акты, КС-3 и сводная по выполнению"
                                  Content="КС-2 / КС-3" ContentTemplate="{StaticResource IconLabelFile}"/>
                </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Contract cost navigation is a second row, never the flat KP strip.
             It shares the tools row because the estimate toolbar is hidden on Costs. -->
        <Border x:Name="ContractCostNavigation" Grid.Row="2" Visibility="Collapsed"
                Background="Transparent" Padding="24,6,24,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          PanningMode="HorizontalOnly" CanContentScroll="False">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ContractMaterialsModeTab" GroupName="ContractCostSection"
                                 Tag="materials" Content="Материалы" IsChecked="True"
                                 Style="{StaticResource ContractCostSubTab}" Checked="ContractCostMode_Checked"/>
                    <RadioButton x:Name="ContractSummaryModeTab" GroupName="ContractCostSection"
                                 Tag="summary" Content="Сводная"
                                 Style="{StaticResource ContractCostSubTab}" Checked="ContractCostMode_Checked"/>
                    <RadioButton x:Name="ContractTotalsModeTab" GroupName="ContractCostSection"
                                 Tag="totals" Content="Итоги"
                                 Style="{StaticResource ContractCostSubTab}" Checked="ContractCostMode_Checked"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Python kp_editor: left = add + view controls; right = Закуп, Столбцы, search. -->
        <Grid x:Name="EstimateToolsBar" Grid.Row="2" Margin="24,6,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,2,4">
                    <Button x:Name="AddRowButton" Style="{StaticResource DocumentSplitLeft}" Click="AddRow_Click"
                            Content="+ Строка" ContentTemplate="{StaticResource IconLabelRowPlus}" IsEnabled="False"
                            AutomationProperties.Name="Добавить строку" ToolTip="Добавить строку (Insert)"/>
                    <Button Style="{StaticResource DocumentSplitRight}" Click="AddOptions_Click"
                            AutomationProperties.Name="Варианты добавления"
                            ToolTip="Добавить систему, подраздел, комплектующее или строки из Excel"
                            IsEnabled="{Binding IsEnabled, ElementName=AddRowButton}">
                        <Viewbox Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphChevronDown}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}"/></Canvas></Viewbox>
                    </Button>
                </StackPanel>
                <Button Content="Из справочника" ContentTemplate="{StaticResource IconLabelBook}"
                        Style="{StaticResource PythonToolbarButton}" Click="AddFromCatalog_Click"
                        IsEnabled="{Binding IsEnabled, ElementName=AddRowButton}" Margin="0,0,10,4"
                        ToolTip="Добавить позиции из справочника (Ctrl+K)"/>
                <Border Width="1" Height="22" Background="#E4E8EF" VerticalAlignment="Center" Margin="0,0,6,4"/>
                <!-- Python common.view_button: «Группировка» and «Сортировка» — two buttons,
                     each with its own menu; only the on-screen look changes, not the KP order. -->
                <Button x:Name="GroupButton" Style="{StaticResource DocumentFlatTool}" Content="Группировка" ContentTemplate="{StaticResource IconLabelLayers}"
                        Click="GroupMenu_Click" Margin="0,0,2,4"
                        ToolTip="Как показать строки: по системам, одинаковые вместе, по типу, списком. Порядок строк в КП не меняется"/>
                <Button x:Name="SortButton" Style="{StaticResource DocumentFlatTool}" Content="Сортировка" ContentTemplate="{StaticResource IconLabelSort}"
                        Click="SortMenu_Click" Margin="0,0,2,4"
                        ToolTip="Порядок строк на экране: как в КП, по названию, сумме, цене, количеству"/>
                <Button x:Name="NoPriceFilterButton" Style="{StaticResource PythonToolbarButton}" Content="Без цены" ContentTemplate="{StaticResource IconLabelAlert}" Click="NoPriceFilter_Click"
                        Margin="0,0,2,4" Visibility="Collapsed"
                        ToolTip="Показать только позиции без цены. Проставленная цена убирает строку из фильтра"/>
                <Button x:Name="ResetViewButton" Style="{StaticResource PythonToolbarButton}" Content="Как в КП" ContentTemplate="{StaticResource IconLabelX}" Click="ResetView_Click"
                        Margin="0,0,2,4" Visibility="Collapsed"
                        ToolTip="Вернуть исходный вид, порядок, фильтр и группировку"/>
            </WrapPanel>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <CheckBox x:Name="PurchaseToggle" Style="{StaticResource PythonToolbarToggle}" Content="Закуп" ContentTemplate="{StaticResource IconLabelBuilding}" VerticalAlignment="Center" Margin="0,0,2,4"
                Checked="PurchaseToggle_Changed" Unchecked="PurchaseToggle_Changed"
                ToolTip="Показать закупочную цену рядом с ценой заказчика. Видна только нам"/>
                <Button Content="Столбцы" ContentTemplate="{StaticResource IconLabelList}" Style="{StaticResource PythonToolbarButton}" Click="Columns_Click" ToolTip="Какие столбцы показывать" Margin="0,0,2,4"/>
                <Grid Width="150" Height="34" Margin="0,0,0,4">
                <TextBox x:Name="EstimateSearch" Style="{StaticResource PythonSearch}" TextChanged="EstimateSearch_TextChanged"
                         ToolTip="Найти в смете…" AutomationProperties.Name="Найти в смете" Padding="30,6,27,6"/>
                 <Viewbox Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphSearch}" Stroke="#94A3B8"/></Canvas></Viewbox>
                <TextBlock Text="Найти в смете…" Foreground="#64748B" Margin="30,0,10,0"
                           VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style><Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=EstimateSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
                <Button Content="Очистить" ContentTemplate="{StaticResource IconOnlyX}" Click="ClearEstimateSearch_Click" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Width="26" Height="26" Padding="0"
                        ToolTip="Очистить поиск по смете" AutomationProperties.Name="Очистить поиск по смете">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PythonToolbarButton}">
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=EstimateSearch}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
              </Grid>
            </WrapPanel>
        </Grid>
        <Popup x:Name="ExtraActionsExpander" PlacementTarget="{Binding ElementName=MoreActionsButton}"
               Placement="Bottom" HorizontalOffset="-10" VerticalOffset="-6"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Style="{StaticResource MenuPopupChrome}" MinWidth="380" MaxWidth="530">
                <ScrollViewer MaxHeight="470" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ActionsMenuPanel" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle"
                                PreviewKeyDown="ActionsMenu_PreviewKeyDown">
                        <!-- Python kp_editor.btn_more: QMenu с разделами. -->
                        <TextBlock Text="ДОКУМЕНТ" Style="{StaticResource EstimateMenuHeader}"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Обновить из SQL Server" Click="RefreshNow_Click" Tag="{StaticResource GlyphRefresh}"
                                ToolTip="Перечитать смету из базы, включая изменения коллег"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Свойства: номер, дата, организация, НДС…" Click="EditTitle_Click" Tag="{StaticResource GlyphEdit}"
                                ToolTip="Реквизиты документа"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Заблокировать — смета подписана" Click="LockToggle_Click" Tag="{StaticResource GlyphCheck}" x:Name="LockMenuItem"
                                ToolTip="Цены, количество и строки больше не поменяются случайно"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Создать копию КП (вариант)…" Click="CopyContract_Click" Tag="{StaticResource GlyphDuplicate}"
                                ToolTip="Полная копия документа рядом с этим"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Сделать договором (закупки, выдача, КС)…" Click="MakeContract_Click" Tag="{StaticResource GlyphCheck}" x:Name="MakeContractItem"
                                ToolTip="У КП появятся Закупки, Выдача и КС-2 / КС-3"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Создать допсоглашение к этому договору…" Click="CreateDop_Click" Tag="{StaticResource GlyphFilePlus}" x:Name="CreateDopItem"/>
                        <Button Style="{StaticResource EstimateMenuItem}" x:Name="MoveContractItem" Content="Перенести в другой объект…" Click="MoveContract_Click" Tag="{StaticResource GlyphFilePlus}"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Этапы — вычесть договоры из КП (режим вкл / выкл)" Click="ToggleInlineStages_Click" Tag="{StaticResource GlyphStage}"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Сравнить с другим документом…" Click="CompareDocs_Click" Tag="{StaticResource GlyphList}"/>
                        <Separator Style="{StaticResource MenuSeparator}"/>
                        <TextBlock Text="ЦЕНЫ" Style="{StaticResource EstimateMenuHeader}"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Скопировать расценки" Click="TransferRates_Click" Tag="{StaticResource GlyphCopy}"
                                ToolTip="Скопировать цены из другого КП: СМР или материалы"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Скидка на всю смету…" Click="Discount_Click" Tag="{StaticResource GlyphEdit}"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Цена работы для выделенных строк…" Click="SetWork_Click" Tag="{StaticResource GlyphEdit}"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Цены работ из справочника (где пусто)" Click="FillWork_Click" Tag="{StaticResource GlyphBook}"/>
                        <Separator Style="{StaticResource MenuSeparator}"/>
                        <TextBlock Text="ИЗМЕНЕНИЯ ПРОЕКТА (СПЕЦИФИКАЦИЯ)" Style="{StaticResource EstimateMenuHeader}"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Обновить из новой спецификации (изм.)…" Click="UpdateSpec_Click" Tag="{StaticResource GlyphUpload}"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Что менялось по изм. — отчёты…" Click="SpecHistory_Click" Tag="{StaticResource GlyphHistory}"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Свернуть воздуховоды и изоляцию в м² — по системам" Click="CollapseAreaSystem_Click" Tag="{StaticResource GlyphLayers}"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Свернуть в м² — одной группой на всё КП" Click="CollapseAreaWhole_Click" Tag="{StaticResource GlyphLayers}"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Развернуть м² обратно в строки" Click="ExpandAreaAll_Click" Tag="{StaticResource GlyphList}"/>
                        <Separator Style="{StaticResource MenuSeparator}"/>
                        <TextBlock Text="ОБЪЕКТ" Style="{StaticResource EstimateMenuHeader}"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Список людей на допуск…" Click="ShowPeople_Click" Tag="{StaticResource GlyphUsers}"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Приказы об ответственных…" Click="ShowOrders_Click" Tag="{StaticResource GlyphFile}"/>
                        <Separator Style="{StaticResource MenuSeparator}"/>
                        <TextBlock Text="ПРОЧЕЕ" Style="{StaticResource EstimateMenuHeader}"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="История изменений документа…" Click="ShowHistory_Click" Tag="{StaticResource GlyphHistory}"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Сохранить ссылку на расчёт в папку…" Click="SaveDocumentLink_Click" Tag="{StaticResource GlyphFolder}"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Пересортировать строки КП (запись)…" Click="Sort_Click" Tag="{StaticResource GlyphSort}"
                                ToolTip="Физически изменить порядок строк в SQL Server: отдельно от временного вида"/>
                        <Button Style="{StaticResource EstimateMenuItem}" Content="Удалить документ…" Click="DeleteContract_Click" Tag="{StaticResource GlyphTrash}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>

        <StackPanel Grid.Row="3">
            <!-- Python help.py HintBar("estimate"): a soft blue line with a tip, closed per user. -->
            <Border x:Name="HintBar" Background="#E8F0FE" CornerRadius="8" Margin="24,10,24,0"
                    Padding="12,7,6,7" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="⚠" Foreground="#2563EB" FontSize="14"
                               VerticalAlignment="Top" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" x:Name="HintText" Foreground="#1E40AF" TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Text="«+ Строка» — новая строка, стрелка ▾ — система и всё остальное. Правый щелчок по строке — действия с ней, «Действия» вверху — с документом целиком."/>
                    <Button Grid.Column="2" Content="Понятно" Click="HintClose_Click" Margin="10,0,0,0"
                            Style="{StaticResource PythonToolbarButton}" MinHeight="28" Padding="10,3"/>
                </Grid>
            </Border>
            <Border x:Name="LockedBar" Background="#E7F6EC" BorderBrush="#86C993" BorderThickness="1"
                    CornerRadius="7" Margin="24,10,24,0" Padding="12,6" Visibility="Collapsed">
                <TextBlock Text="Подписано — смета заблокирована. Цены, количество и строки не меняются случайно."
                           Foreground="#166534" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Таблица сметы -->
        <Border x:Name="EstimateTablePanel" Grid.Row="4" Background="White" BorderBrush="#E4E8EF" BorderThickness="1"
                CornerRadius="12" Margin="24,8,24,0">
            <DockPanel>
                <Button DockPanel.Dock="Bottom" Content="Добавить строку" ContentTemplate="{StaticResource IconLabelPlus}"
                        Click="AddRow_Click" IsEnabled="{Binding IsEnabled, ElementName=AddRowButton}"
                        Foreground="#2563EB" BorderThickness="0" Background="Transparent"
                        HorizontalAlignment="Left" FontWeight="SemiBold" Padding="8,4"
                        Margin="0,3,0,2" ToolTip="Добавить позицию после выбранной"/>
                <!-- Python ui/stage_mode.py: stage cards and segmented filters sit immediately
                     above the same estimate table; document rows and source amounts stay unchanged. -->
                <Border x:Name="InlineStagesBar" DockPanel.Dock="Top" Visibility="Collapsed"
                        Margin="8,8,8,5" Padding="10,8,10,8" CornerRadius="9"
                        Background="#FFFFFF" BorderBrush="#2563EB" BorderThickness="1">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Управление этапами…" Click="OpenStagesDialog_Click"
                                        ToolTip="Создание этапов, изменение количеств, договорные суммы и документ «Остаток»"
                                        Margin="4,0,6,0"/>
                                <Button Content="Выйти из режима" Click="CloseInlineStages_Click"
                                        ToolTip="Убрать колонки этапов из таблицы"/>
                            </StackPanel>
                            <TextBlock Text="ЭТАПЫ" Foreground="#1D4ED8" FontWeight="Bold"
                                       VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
                        </DockPanel>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      Margin="0,6,0,4">
                            <WrapPanel x:Name="InlineStagesCards"/>
                        </ScrollViewer>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Показать:" VerticalAlignment="Center" Foreground="#64748B"
                                       Margin="0,0,7,0"/>
                            <ComboBox x:Name="InlineStagesFilter" Width="183" SelectedIndex="0"
                                      SelectionChanged="InlineStagesFilter_SelectionChanged"
                                      ToolTip="Фильтр этапов не изменяет данные полного КП">
                                <ComboBoxItem Content="Все строки" Tag="all"/>
                                <ComboBoxItem Content="Не распределено" Tag="undistributed"/>
                                <ComboBoxItem Content="В этапах" Tag="assigned"/>
                                <ComboBoxItem Content="Перебор" Tag="overrun"/>
                            </ComboBox>
                            <TextBlock x:Name="InlineStagesSummary" Foreground="#64748B"
                                       VerticalAlignment="Center" Margin="14,0,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <!-- Python stage_mode.picked(): actions apply to selected systems,
                             equal-position groups and actual rows, never the whole КП. -->
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock x:Name="InlineStagesSelectionInfo"
                                       Text="Выдели позиции или системы →"
                                       FontSize="12" Foreground="#475569" Margin="0,0,0,5"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <WrapPanel x:Name="InlineStagesSelectionButtons"/>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <DataGrid x:Name="EstimateGrid" MinRowHeight="23" MinColumnWidth="36" BorderThickness="0" Background="White"
                          ContextMenuOpening="EstimateGrid_ContextMenuOpening"
                       AllowDrop="True"
                       PreviewMouseLeftButtonDown="EstimateGrid_DragMouseDown"
                       PreviewMouseLeftButtonUp="EstimateGrid_DragMouseUp"
                       PreviewMouseMove="EstimateGrid_DragMouseMove"
                       DragOver="EstimateGrid_DragOver"
                       DragLeave="EstimateGrid_DragLeave"
                       Drop="EstimateGrid_Drop"
                      AutoGenerateColumns="False" IsReadOnly="False"
                      BeginningEdit="EstimateGrid_BeginningEdit"
                      PreparingCellForEdit="EstimateGrid_PreparingCellForEdit"
                      CellEditEnding="EstimateGrid_CellEditEnding"
                      HeadersVisibility="Column" GridLinesVisibility="All"
                       HorizontalGridLinesBrush="#E4E8EF" VerticalGridLinesBrush="#E4E8EF"
                      EnableColumnVirtualization="True"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      RowHeaderWidth="0" SelectionMode="Extended" SelectionUnit="FullRow"
                      RowStyle="{StaticResource EstimateRow}"
                      CellStyle="{StaticResource EstimateCell}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      EnableRowVirtualization="True"
                      ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Resources>
                    <Style TargetType="TextBox" BasedOn="{StaticResource EstimateGridEditor}"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn x:Name="NumberColumn" Header="№" Width="64" IsReadOnly="True" CanUserReorder="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Click="ToggleSection_Click"
                                            ToolTip="Свернуть или развернуть раздел"
                                            AutomationProperties.Name="Свернуть или развернуть раздел"
                                            Width="16" Height="18" MinHeight="0" MinWidth="0" Padding="0"
                                            BorderThickness="0" Background="Transparent"
                                            Visibility="{Binding IsExpandable, Converter={StaticResource OnlySystems}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="SectionChrome" Background="Transparent" CornerRadius="3">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SectionChrome" Property="Background" Value="#E8F0FE"/></Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SectionChrome" Property="Background" Value="#C9DBFB"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Viewbox Width="12" Height="12" Stretch="Uniform" IsHitTestVisible="False">
                                            <Canvas Width="24" Height="24">
                                                <Path Stroke="#475569">
                                                    <Path.Style>
                                                        <Style TargetType="Path" BasedOn="{StaticResource SvgGlyphPath}">
                                                            <Setter Property="Data" Value="{StaticResource GlyphChevronDown}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                                    <Setter Property="Data" Value="M9 6l6 6-6 6"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayNum}" TextAlignment="Center"
                                               HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn x:Name="NameColumn" Header="Наименование" Width="460" MinWidth="190">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                           Margin="{Binding NameIndentLevel, Converter={StaticResource Indent}}"
                                           Padding="0" ToolTip="{Binding Name}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WrapEstimateNames, RelativeSource={RelativeSource AncestorType=local:EstimateView}}" Value="False">
                                                    <Setter Property="TextWrapping" Value="NoWrap"/>
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate><TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                   Margin="{Binding NameIndentLevel, Converter={StaticResource Indent}}"
                                                   TextWrapping="Wrap" AcceptsReturn="False"/></DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="BasisColumn" Header="Обоснование"
                                        Binding="{Binding Basis, Mode=TwoWay}" Width="150"
                                        ElementStyle="{StaticResource EstimateTextCell}" EditingElementStyle="{StaticResource EstimateGridEditor}"
                                        Visibility="Collapsed"/>
                    <DataGridTextColumn Header="Ед." Binding="{Binding Unit, Mode=TwoWay}" Width="64" ElementStyle="{StaticResource CenterCell}" EditingElementStyle="{StaticResource EstimateCenteredEditor}"/>
                    <DataGridTextColumn Header="Кол-во" Binding="{Binding QtyText, Mode=TwoWay}"
                                        Width="80" ElementStyle="{StaticResource CenterCell}" EditingElementStyle="{StaticResource EstimateCenteredEditor}"/>
                    <DataGridTemplateColumn Header="Цена" Width="118" CellStyle="{StaticResource EstimatePriceCell}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayPriceText}" Style="{StaticResource Price}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding PriceText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         TextAlignment="Right" VerticalContentAlignment="Center"
                                         ToolTip="Можно формулой: 12*1,15"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding DisplayAmountText}"
                                        Width="130" ElementStyle="{StaticResource Money}" IsReadOnly="True"/>
                    <DataGridTextColumn x:Name="PurchaseColumn" Header="Закупка" Binding="{Binding PurchaseText, Mode=TwoWay}"
                                        Width="110" ElementStyle="{StaticResource Money}" EditingElementStyle="{StaticResource EstimateMoneyEditor}" Visibility="Collapsed"/>
                    <DataGridTemplateColumn x:Name="WorkColumn" Header="Работа за ед." Width="118" Visibility="Collapsed">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding WorkDisplayText}" Style="{StaticResource Money}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding WorkText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         TextAlignment="Right" VerticalContentAlignment="Center"
                                         ToolTip="Можно формулой: 12*1,15"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="WorkTotalColumn" Header="Работа всего"
                                        Binding="{Binding DisplayWorkAmount, StringFormat={}{0:N2}}"
                                        Width="130" ElementStyle="{StaticResource Money}"
                                        IsReadOnly="True" Visibility="Collapsed"/>
                    <DataGridTemplateColumn x:Name="NoteColumn" Header="Примечание" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Note}" Foreground="#64748B"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Note}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate><TextBox Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/></DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn x:Name="AreaUnitColumn" Header="м² за ед."
                                            Width="90" Visibility="Collapsed">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AreaUnitDisplay}"
                                           TextAlignment="Right" VerticalAlignment="Center"
                                           Padding="0" ToolTip="{Binding AreaUnitTip}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#334155"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AreaWarning}" Value="True">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                    <Setter Property="Foreground" Value="#991B1B"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding AreaManualFlag}" Value="True">
                                                    <Setter Property="Foreground" Value="#2563EB"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding AreaUnitEditText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         TextAlignment="Right"
                                         ToolTip="Можно формулой. Пустое — снова считать площадь автоматически."/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="AreaTotalColumn" Header="м² всего"
                                        Binding="{Binding AreaTotalDisplay}" Width="90"
                                        ElementStyle="{StaticResource Money}"
                                        IsReadOnly="True" Visibility="Collapsed"/>
                </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>


        <!-- Python cost_view mat_page: панель инструментов, подсказка, таблица 13 колонок,
             итоговые плитки. Правки идут теми же сервисами, что и вкладка «Смета»/«Закупки». -->
        <Border x:Name="MaterialsPanel" Grid.Row="4" Visibility="Collapsed" Background="Transparent"
                BorderThickness="0" Margin="24,6,24,14" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                    <Button Style="{StaticResource PythonToolbarMain}" Click="MaterialsMarkup_Click"
                            Margin="0,0,2,0" ToolTip="Выделите строки (можно целую систему) и посчитайте цену клиенту из закупа — например, закуп × 1,44 (или наоборот)">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphList}" Stroke="#2563EB"/></Canvas></Viewbox>
                            <TextBlock Text="Наценка выделенным…" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PythonToolbarMain}" Click="MaterialsCatalog_Click"
                            Margin="0,0,2,0" ToolTip="Где закупочная цена пустая — подставить последнюю цену из справочника">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphBook}" Stroke="#2563EB"/></Canvas></Viewbox>
                            <TextBlock Text="Закуп из справочника" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PythonToolbarPrimary}" Click="MaterialsRequest_Click" Margin="0,0,10,0"
                            ToolTip="Excel-заявка поставщику: выберите его в окне — в заявку пойдут все его позиции по договору, одинаковые сложены, количество общее">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphFile}" Stroke="White"/></Canvas></Viewbox>
                            <TextBlock Text="Заявка поставщику" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PythonToolbarButton}" Click="MaterialsColor_Click"
                            Margin="0,0,2,0" ToolTip="Покрасить выделенные строки, как заливку в Excel">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphEdit}" Stroke="#64748B"/></Canvas></Viewbox>
                            <TextBlock Text="Цвет" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PythonToolbarButton}" Click="MaterialsGrouping_Click"
                            Margin="0,0,2,0" ToolTip="Как показать строки: группировка и сортировка. Только на экране — порядок строк в КП, Excel и печати не меняется">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphLayers}" Stroke="#64748B"/></Canvas></Viewbox>
                            <TextBlock Text="Группировка" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PythonToolbarButton}" Click="MaterialsSorting_Click"
                            Margin="0,0,6,0" ToolTip="Порядок строк на экране">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphSort}" Stroke="#64748B"/></Canvas></Viewbox>
                            <TextBlock Text="Сортировка" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <ToggleButton x:Name="MaterialsNoCostToggle" Style="{StaticResource MatFilterToggleWarm}"
                                  Click="MaterialsFilter_Click" Checked="MaterialsFilter_Click" Unchecked="MaterialsFilter_Click"
                                  Visibility="Collapsed"
                                  Margin="0,0,2,0" ToolTip="Показать только строки, где закупочная цена не указана — удобно вписывать: вписанная строка уходит из списка">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphAlert}" Stroke="#B5761E"/></Canvas></Viewbox>
                            <TextBlock x:Name="MaterialsNoCostText" Text="Без закупочных цен" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="MaterialsNoPriceToggle" Style="{StaticResource MatFilterToggle}"
                                  Click="MaterialsFilter_Click" Checked="MaterialsFilter_Click" Unchecked="MaterialsFilter_Click"
                                  Visibility="Collapsed"
                                  Margin="0,0,2,0" ToolTip="Показать только строки без цены клиенту — удобно проставлять: строка с ценой уходит из списка">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphAlert}" Stroke="#64748B"/></Canvas></Viewbox>
                            <TextBlock x:Name="MaterialsNoPriceText" Text="Без цены" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <Button x:Name="MaterialsResetViewButton" Style="{StaticResource PythonToolbarButton}" Content="Как в КП" ContentTemplate="{StaticResource IconLabelX}"
                            Click="MaterialsResetView_Click" Visibility="Collapsed" Margin="0,0,2,0"
                            ToolTip="Вернуть обычный вид — по системам, как в КП"/>
                    <Border Width="10"/>
                    <ComboBox x:Name="MaterialsSystemFilter" Width="160" VerticalContentAlignment="Center"
                              SelectionChanged="MaterialsSystemFilter_Changed"
                              ToolTip="Показать строки одной системы"/>
                    <TextBox x:Name="MaterialsSearch" Style="{StaticResource PythonSearch}" Width="200" Margin="6,0,6,0"
                             TextChanged="MaterialsSearch_TextChanged" ToolTip="Поиск по названию или системе"/>
                    <Button Style="{StaticResource PythonToolbarButton}" Click="MaterialsExport_Click" MinWidth="36"
                            ToolTip="Сохранить закуп-розница: Excel с закупочными и розничными ценами и маржой (только для нас)">
                        <Viewbox Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphDownload}" Stroke="#2563EB"/></Canvas></Viewbox>
                    </Button>
                </WrapPanel>
                <Border x:Name="MaterialsHintBar" Grid.Row="1" Background="#E8F0FE" CornerRadius="8"
                        Margin="0,0,0,10" Padding="12,7,6,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⚠" Foreground="#2563EB" FontSize="14"
                                   VerticalAlignment="Top" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" Foreground="#1E40AF" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="Впишите закуп в «Закуп за ед.» (двойной щелчок). Много строк сразу — выделите и «Наценка выделенным…»."/>
                        <Button Grid.Column="2" Content="Понятно" Click="MaterialsHintClose_Click" Margin="10,0,0,0"
                                Style="{StaticResource PythonToolbarButton}" MinHeight="28" Padding="10,3"/>
                    </Grid>
                </Border>
                <DataGrid local:TableColumnMenu.Key="estimate-materials" x:Name="MaterialsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="False"
                          CellStyle="{StaticResource CompactCostCell}"
                          RowStyle="{StaticResource MaterialsCostRow}"
                          MinRowHeight="24" ColumnHeaderStyle="{StaticResource CompactCostHeader}"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" RowHeaderWidth="0"
                          HeadersVisibility="Column" GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#E4E8EF" VerticalGridLinesBrush="#E4E8EF" BorderBrush="#E4E8EF" BorderThickness="1" Background="White"
                          SelectionMode="Extended" SelectionUnit="FullRow"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          BeginningEdit="MaterialsGrid_BeginningEdit" PreparingCellForEdit="MaterialsGrid_PreparingCellForEdit"
                          CellEditEnding="MaterialsGrid_CellEditEnding"
                          ContextMenuOpening="MaterialsGrid_ContextMenuOpening"
                          PreviewKeyDown="MaterialsGrid_PreviewKeyDown"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Resources>
                        <Style TargetType="TextBox" BasedOn="{StaticResource CompactCostEditor}"/>
                        <!-- Python GridDelegate.paint: выделенная строка — ровная светло-голубая
                             заливка с тёмным текстом, а у текущей ячейки — синяя рамка-курсор,
                             нарисованная ПОВЕРХ (текст не двигается). -->
                        <Style x:Key="MaterialsCell" TargetType="DataGridCell" BasedOn="{StaticResource CompactCostCell}"><Setter Property="Background" Value="Transparent"/></Style>
                        <Style x:Key="MaterialsCellBlue" TargetType="DataGridCell" BasedOn="{StaticResource MaterialsCell}">
                            <Setter Property="Background" Value="#EEF4FF"/>
                        </Style>
                        <Style x:Key="MaterialsCellOrange" TargetType="DataGridCell" BasedOn="{StaticResource MaterialsCell}">
                            <Setter Property="Background" Value="#FFF5E6"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasFact}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Binding="{Binding Num}" Width="56"
                                            IsReadOnly="True" CellStyle="{StaticResource MaterialsCell}"
                                            ElementStyle="{StaticResource CompactCostCenter}" HeaderStyle="{StaticResource CompactCostHeader}"/>
                        <DataGridTemplateColumn Header="Наименование" Width="*" MinWidth="220"
                                                CellStyle="{StaticResource MaterialsCell}" HeaderStyle="{StaticResource CompactCostTextHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding NameTooltip}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Name, Mode=OneWay}" VerticalContentAlignment="Center"
                                             ToolTip="Наименование меняется и в смете"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="48"
                                            IsReadOnly="True" CellStyle="{StaticResource MaterialsCell}"
                                            ElementStyle="{StaticResource CompactCostCenter}" HeaderStyle="{StaticResource CompactCostHeader}"/>
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding QtyText}" Width="64"
                                            IsReadOnly="True" CellStyle="{StaticResource MaterialsCell}"
                                            ElementStyle="{StaticResource CompactCostCenter}" HeaderStyle="{StaticResource CompactCostHeader}"/>
                        <DataGridTemplateColumn Header="Цена клиенту" Width="112"
                                                CellStyle="{StaticResource MaterialsCellBlue}" HeaderStyle="{StaticResource CompactCostMoneyHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PriceText}" Style="{StaticResource CompactCostMoney}"
                                               ToolTip="{Binding PriceTooltip}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding PriceRaw, Mode=OneWay}" TextAlignment="Right"
                                             VerticalContentAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Сумма клиенту" Binding="{Binding AmountText}" Width="124"
                                            IsReadOnly="True" CellStyle="{StaticResource MaterialsCellBlue}"
                                            ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource CompactCostMoneyHeader}"/>
                        <DataGridTemplateColumn Header="Закуп за ед." Width="108"
                                                CellStyle="{StaticResource MaterialsCellOrange}" HeaderStyle="{StaticResource CompactCostMoneyHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CostText}" ToolTip="{Binding CostTooltip}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CompactCostMoney}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CostMissing}" Value="True">
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CostWork}" Value="True">
                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                    </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Value="True"><Setter Property="Foreground" Value="{StaticResource GridSelectionTextBrush}"/></DataTrigger>
</Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding CostRaw, Mode=OneWay}" TextAlignment="Right"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Плановая закупочная цена. Факт по счёту — в колонке «Факт по счёту»"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Закуп сумма" Binding="{Binding CostSumText}" Width="118"
                                            IsReadOnly="True" CellStyle="{StaticResource MaterialsCellOrange}"
                                            ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource CompactCostMoneyHeader}"/>
                        <DataGridTemplateColumn Header="Наценка, %" Width="96"
                                                CellStyle="{StaticResource MaterialsCell}" HeaderStyle="{StaticResource CompactCostHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MarkupText}" ToolTip="{Binding MarkupTooltip}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CompactCostCenter}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MarkupWarn}" Value="True">
                                                        <Setter Property="Foreground" Value="#B45309"/>
                                                    </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Value="True"><Setter Property="Foreground" Value="{StaticResource GridSelectionTextBrush}"/></DataTrigger>
</Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding MarkupRaw, Mode=OneWay}" TextAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Цена клиенту = закуп × (1 + наценка, %)"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Маржа" Binding="{Binding MarginText}" Width="108" IsReadOnly="True"
                                            CellStyle="{StaticResource MaterialsCell}" HeaderStyle="{StaticResource CompactCostMoneyHeader}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CompactCostMoney}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MarginNegative}" Value="True">
                                            <Setter Property="Foreground" Value="#DC2626"/>
                                        </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Value="True"><Setter Property="Foreground" Value="{StaticResource GridSelectionTextBrush}"/></DataTrigger>
</Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Факт по счёту" Width="112"
                                                CellStyle="{StaticResource MaterialsCell}" HeaderStyle="{StaticResource CompactCostMoneyHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FactText}" Style="{StaticResource CompactCostMoney}"
                                               ToolTip="Фактическая цена по счёту поставщика — двойной щелчок, чтобы вписать. Когда указана, считается вместо плановой закупочной."/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding FactRaw, Mode=OneWay}" TextAlignment="Right"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Фактическая цена по счёту поставщика. Пусто — считать по плановой закупочной"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Поставщик" Width="130"
                                                CellStyle="{StaticResource MaterialsCell}" HeaderStyle="{StaticResource CompactCostTextHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Supplier}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               ToolTip="Поставщик — двойной щелчок, чтобы вписать или выбрать из списка. Тот же, что на вкладке «Закупки»."/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Supplier, Mode=OneWay}" VerticalContentAlignment="Center"
                                             ToolTip="Поставщик или «Цех» — тот же, что на вкладке «Закупки»"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Пометки" Width="180"
                                                CellStyle="{StaticResource MaterialsCell}" HeaderStyle="{StaticResource CompactCostTextHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding NoteText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               Foreground="#334155"
                                               ToolTip="{Binding NoteTooltip}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding NoteText, Mode=OneWay}" VerticalContentAlignment="Center"
                                             ToolTip="Наши пометки — заказчик их не видит"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <UniformGrid Grid.Row="3" Columns="4" Margin="0,10,0,0">
                    <Border Style="{StaticResource PythonTile}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock x:Name="MatTileRevCaption" Text="Цена клиенту (материалы)" Style="{StaticResource PythonTileLabel}"/>
                            <TextBlock x:Name="MatTileRevValue" Style="{StaticResource PythonTileValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PythonTile}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Себестоимость (закуп)" Style="{StaticResource PythonTileLabel}"/>
                            <TextBlock x:Name="MatTileCostValue" Style="{StaticResource PythonTileValue}"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="MatTileTrans" Click="MatTileTrans_Click" Cursor="Hand" Margin="0,0,10,0"
                            ToolTip="Щёлкните и впишите, сколько транспорт стоит нам. Сумма клиенту — из сметы («Транспорт» в итогах сметы)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Style="{StaticResource PythonTile}">
                                    <StackPanel>
                                        <TextBlock x:Name="MatTileTransCaption" Text="Транспорт · в смете нет" Style="{StaticResource PythonTileLabel}"/>
                                        <TextBlock x:Name="MatTileTransValue" Style="{StaticResource PythonTileValue}"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Border Style="{StaticResource PythonTileAccent}">
                        <StackPanel>
                            <TextBlock x:Name="MatTileMarginCaption" Text="Маржа на материалах" Foreground="#DBEAFE"
                                       FontSize="{StaticResource UiCaptionSize}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="MatTileMarginValue" Foreground="White" Style="{StaticResource PythonTileValue}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </Border>
        <!-- Вкладка «Сводная» КП — перенос cost_summary_view.py: таблица директора
             (материалы/работы/итого), фильтры, плитки, запись через SaveSummaryCell. -->
        <Border x:Name="SummaryPanel" Grid.Row="4" Visibility="Collapsed"
                Background="Transparent" BorderThickness="0"
                Margin="36,14,44,30" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- заголовок + кнопки справа (cost_summary_view.__init__: title_row) -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SummaryTransferSmrButton" Style="{StaticResource PythonToolbarButton}"
                                Content="СМР в смету по системам…" ContentTemplate="{StaticResource IconLabelList}" Click="SummaryTransferSmr_Click" IsEnabled="False"
                                Margin="0,0,6,0" MinHeight="30"
                                ToolTip="Перенести розницу СМР из «Сводной» в системы сметы"/>
                        <Button x:Name="SummaryExcelButton" Style="{StaticResource PythonToolbarButton}"
                                Content="Excel" ContentTemplate="{StaticResource IconLabelDownload}" Click="SummaryExcel_Click" IsEnabled="False" MinHeight="30"
                                ToolTip="Выгрузить сводную в Excel"/>
                    </StackPanel>
                    <TextBlock Text="Сводная стоимость" Foreground="#233C61" FontSize="19" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </DockPanel>
                <!-- панель фильтров, как на «Материалах» (bar: вид, «без цен», наценка, системы, поиск) -->
                <local:SummaryToolbarPanel Grid.Row="1" Margin="0,0,0,10">
                    <WrapPanel x:Name="SummaryActions" VerticalAlignment="Center">
                    <Button x:Name="SummaryGroupButton" Style="{StaticResource PythonToolbarButton}"
                            Click="SummaryGroup_Click" Margin="0,0,6,0" Height="34" MinHeight="0"
                            ToolTip="Как показать строки: по системам, одинаковые вместе, по поставщику">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphLayers}" Stroke="#64748B"/></Canvas></Viewbox>
                            <TextBlock Text="Группировка" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SummarySortButton" Style="{StaticResource PythonToolbarButton}"
                            Click="SummarySort_Click" Margin="0,0,6,0" Height="34" MinHeight="0"
                            ToolTip="Порядок строк внутри групп">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphSort}" Stroke="#64748B"/></Canvas></Viewbox>
                            <TextBlock Text="Сортировка" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border x:Name="SummaryMissingChrome" CornerRadius="7" BorderThickness="1" Height="34" Margin="0,0,6,0" SnapsToDevicePixels="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FFF8EC"/>
                                <Setter Property="BorderBrush" Value="#EACD9C"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#B5761E"/></Trigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=SummaryMissingToggle}" Value="True">
                                        <Setter Property="Background" Value="#E8F0FE"/>
                                        <Setter Property="BorderBrush" Value="#2563EB"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="SummaryMissingToggle" Checked="SummaryMissing_Changed" Unchecked="SummaryMissing_Changed"
                                          MinHeight="0" Padding="10,0,3,0" BorderThickness="0" Cursor="Hand"
                                          AutomationProperties.Name="Фильтр позиций без цен"
                                          ToolTip="Показать только позиции с выбранными пропусками цен">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Foreground" Value="#99631E"/>
                                        <Setter Property="Template">
                                            <Setter.Value><ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Hit" Background="Transparent" CornerRadius="6,0,0,6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hit" Property="Background" Value="#10000000"/></Trigger>
                                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hit" Property="Background" Value="#19000000"/></Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Hit" Property="BorderBrush" Value="#2563EB"/><Setter TargetName="Hit" Property="BorderThickness" Value="1"/></Trigger>
                                                    <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="#1E40AF"/></Trigger>
                                                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate></Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphAlert}" Stroke="#B5761E"/></Canvas></Viewbox>
                                    <TextBlock x:Name="SummaryMissingText" Text="Без цен" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>
                            <Button x:Name="SummaryMissingArrow" Width="24" MinWidth="0" MinHeight="0" Padding="0"
                                    Content="Варианты фильтра" AutomationProperties.Name="Выбрать пропуски цен"
                                    Click="SummaryMissingMenu_Click" ToolTip="Какие пропуски цен искать">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Foreground" Value="#99631E"/>
                                        <Setter Property="Template">
                                            <Setter.Value><ControlTemplate TargetType="Button">
                                                <Border x:Name="Hit" Background="Transparent" CornerRadius="0,6,6,0">
                                                    <Viewbox Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphChevronDown}" Stroke="{TemplateBinding Foreground}"/></Canvas></Viewbox>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hit" Property="Background" Value="#10000000"/></Trigger>
                                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hit" Property="Background" Value="#19000000"/></Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Hit" Property="BorderBrush" Value="#2563EB"/><Setter TargetName="Hit" Property="BorderThickness" Value="1"/></Trigger>
                                                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate></Setter.Value>
                                        </Setter>
                                        <Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=SummaryMissingToggle}" Value="True"><Setter Property="Foreground" Value="#1E40AF"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Button x:Name="SummaryResetViewButton" Style="{StaticResource PythonToolbarButton}"
                            Content="Как в КП" ContentTemplate="{StaticResource IconLabelX}" Click="SummaryResetView_Click" Visibility="Collapsed"
                            Margin="0,0,6,0" Height="34" MinHeight="0" ToolTip="Вернуть обычный вид — по системам, как в КП"/>
                    <Button x:Name="SummaryMarkupAllButton" Style="{StaticResource PythonToolbarButton}"
                            Click="SummaryMarkupAll_Click" Margin="0,0,6,0" Height="34" MinHeight="0"
                            ToolTip="Пересчитать цену клиенту по всем позициям СМР, включая скрытые фильтром">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphList}" Stroke="#64748B"/></Canvas></Viewbox>
                            <TextBlock Text="Наценка на все СМР…" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    </WrapPanel>
                    <WrapPanel x:Name="SummaryFilters" VerticalAlignment="Center">
                    <Button x:Name="SummarySystemFilter" Width="170" Height="34" MinHeight="0"
                            Click="SummarySystemFilter_Click" Margin="0,0,6,0"
                            ToolTip="Показать одну или несколько систем вместе с подразделами"
                            AutomationProperties.Name="Фильтр систем">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PythonToolbarButton}">
                                <Style.Triggers>
                                    <Trigger Property="Tag" Value="True">
                                        <Setter Property="Background" Value="#E8F0FE"/>
                                        <Setter Property="BorderBrush" Value="#2563EB"/>
                                        <Setter Property="Foreground" Value="#1E40AF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <DockPanel LastChildFill="True" Width="146">
                            <Viewbox DockPanel.Dock="Right" Width="12" Height="12" Margin="6,0,0,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphChevronDown}" Stroke="#64748B"/></Canvas></Viewbox>
                            <TextBlock x:Name="SummarySystemFilterText" Text="Все системы" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                    <Grid Width="200" Height="34"><TextBox x:Name="SummarySearch" Style="{StaticResource PythonSearch}" Padding="30,5,27,5" AutomationProperties.Name="Найти позицию"
                             TextChanged="SummarySearch_TextChanged"
                             ToolTip="Только строки с этим в названии (или системе / поставщике) — например «решетк»"/>
                        <Viewbox Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphSearch}" Stroke="#94A3B8"/></Canvas></Viewbox>
                        <TextBlock Text="Найти позицию…" Foreground="#64748B" Margin="30,0,27,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SummarySearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="Очистить" ContentTemplate="{StaticResource IconOnlyX}" Click="ClearSummarySearch_Click"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Width="26" Height="26" Padding="0"
                                ToolTip="Очистить поиск" AutomationProperties.Name="Очистить поиск позиций">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PythonToolbarButton}">
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="MinWidth" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SummarySearch}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    </WrapPanel>
                </local:SummaryToolbarPanel>
                <!-- таблица (cost_summary_view.show_data): группы, полосатые строки по блокам,
                     редактируются цены за ед./наименование/ед./кол-во, суммы считаются -->
                <local:SummaryTableFrame Grid.Row="2" CornerRadius="9" BorderThickness="1" BorderBrush="#DAE3EF" Background="White">
                    <Grid ClipToBounds="True">
                    <DataGrid local:TableColumnMenu.Key="estimate-summary" x:Name="SummaryGrid" AutoGenerateColumns="False" IsReadOnly="False"
                          MinRowHeight="26" ColumnHeaderHeight="78" MinHeight="120"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                          CanUserReorderColumns="True" RowHeaderWidth="0"
                          HeadersVisibility="Column" GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#E9EEF5" VerticalGridLinesBrush="#EDF1F7"
                          BorderThickness="0" Background="#FFFFFF"
                          BeginningEdit="SummaryGrid_BeginningEdit" PreparingCellForEdit="SummaryGrid_PreparingCellForEdit"
                          CellEditEnding="SummaryGrid_CellEditEnding" ContextMenuOpening="SummaryGrid_ContextMenuOpening"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Resources>
                        <Style TargetType="TextBox" BasedOn="{StaticResource CompactCostEditor}"/>
                        <!-- шапки блоков: ПОЗИЦИЯ / МАТЕРИАЛЫ (голубой) / СМР (оранжевый) /
                             ИТОГО (зелёный) / маржи (сиреневый) — цвета SummaryHeader эталона -->
                        <Style x:Key="SumHdrPos" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CompactCostHeader}">
                            <Setter Property="Padding" Value="4,32,4,4"/>
                            <Setter Property="Background" Value="#EFF3F9"/>
                            <Setter Property="Foreground" Value="#526782"/>
                        </Style>
                        <Style x:Key="SumHdrMat" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CompactCostHeader}">
                            <Setter Property="Padding" Value="4,32,4,4"/>
                            <Setter Property="Background" Value="#F1F6FD"/>
                            <Setter Property="Foreground" Value="#526782"/>
                        </Style>
                        <Style x:Key="SumHdrWork" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CompactCostHeader}">
                            <Setter Property="Padding" Value="4,32,4,4"/>
                            <Setter Property="Background" Value="#FFF8EF"/>
                            <Setter Property="Foreground" Value="#526782"/>
                        </Style>
                        <Style x:Key="SumHdrTot" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CompactCostHeader}">
                            <Setter Property="Padding" Value="4,32,4,4"/>
                            <Setter Property="Background" Value="#F0F8F2"/>
                            <Setter Property="Foreground" Value="#526782"/>
                        </Style>
                        <Style x:Key="SumHdrMarg" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CompactCostHeader}">
                            <Setter Property="Padding" Value="4,32,4,4"/>
                            <Setter Property="Background" Value="#F1EAFB"/>
                            <Setter Property="Foreground" Value="#526782"/>
                        </Style>
                        <Style x:Key="SummaryMoney" TargetType="TextBlock" BasedOn="{StaticResource CompactCostMoney}"><Setter Property="TextTrimming" Value="None"/></Style>
                        <!-- ячейки: полосатые строки внутри цветных блоков + шапки систем/ИТОГО -->
                        <Style x:Key="SumCellBase" TargetType="DataGridCell" BasedOn="{StaticResource CompactCostCell}">
                            <Setter Property="Padding" Value="6,3"/>
                        </Style>
                        <Style x:Key="SumCellPos" TargetType="DataGridCell" BasedOn="{StaticResource SumCellBase}">
                            <Setter Property="Background" Value="#FFFFFF"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOdd}" Value="True">
                                    <Setter Property="Background" Value="#EEF3FA"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSystemHeader}" Value="True">
                                    <Setter Property="Background" Value="#E5ECF7"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsTotalRow}" Value="True">
                                    <Setter Property="Background" Value="#E2ECFA"/>
                                </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource GridSelectionBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource GridSelectionTextBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEditing" Value="True"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource GridSelectionTextBrush}"/></Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="SumCellMat" TargetType="DataGridCell" BasedOn="{StaticResource SumCellBase}">
                            <Setter Property="Background" Value="#F9FBFF"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOdd}" Value="True">
                                    <Setter Property="Background" Value="#E7EFFB"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSystemHeader}" Value="True">
                                    <Setter Property="Background" Value="#DCEAFB"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsTotalRow}" Value="True">
                                    <Setter Property="Background" Value="#E2ECFA"/>
                                </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource GridSelectionBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource GridSelectionTextBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEditing" Value="True"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource GridSelectionTextBrush}"/></Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="SumCellWork" TargetType="DataGridCell" BasedOn="{StaticResource SumCellBase}">
                            <Setter Property="Background" Value="#FFFCF7"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOdd}" Value="True">
                                    <Setter Property="Background" Value="#F8ECDC"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSystemHeader}" Value="True">
                                    <Setter Property="Background" Value="#F9E3C7"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsTotalRow}" Value="True">
                                    <Setter Property="Background" Value="#F5E8D7"/>
                                </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource GridSelectionBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource GridSelectionTextBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEditing" Value="True"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource GridSelectionTextBrush}"/></Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="SumCellTot" TargetType="DataGridCell" BasedOn="{StaticResource SumCellBase}">
                            <Setter Property="Background" Value="#F7FCF8"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOdd}" Value="True">
                                    <Setter Property="Background" Value="#E4F2E8"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSystemHeader}" Value="True">
                                    <Setter Property="Background" Value="#DAEDDF"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsTotalRow}" Value="True">
                                    <Setter Property="Background" Value="#DAEDDF"/>
                                </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource GridSelectionBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource GridSelectionTextBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEditing" Value="True"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource GridSelectionTextBrush}"/></Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="SumCellMarg" TargetType="DataGridCell" BasedOn="{StaticResource SumCellBase}">
                            <Setter Property="Background" Value="#FAF7FE"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOdd}" Value="True">
                                    <Setter Property="Background" Value="#EDE4F8"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSystemHeader}" Value="True">
                                    <Setter Property="Background" Value="#E8DCF6"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsTotalRow}" Value="True">
                                    <Setter Property="Background" Value="#E9E1F5"/>
                                </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource GridSelectionBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource GridSelectionTextBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEditing" Value="True"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource GridSelectionTextBrush}"/></Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource PythonTableRow}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSystemHeader}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#344B6B"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsTotalRow}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsExtraRow}" Value="True">
                                    <Setter Property="FontWeight" Value="Normal"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <!-- ПОЗИЦИЯ: наименование с ▾ сворачиванием систем, ед., кол-во -->
                        <DataGridTemplateColumn Width="*" MinWidth="160" SortMemberPath="name" CanUserReorder="False"
                                                CellStyle="{StaticResource SumCellPos}"
                                                HeaderStyle="{StaticResource SumHdrPos}">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="Наименование" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Left" Width="16" Height="16" MinWidth="0" MinHeight="0" Margin="0,0,4,0" Padding="0"
                                                Background="Transparent" BorderThickness="0" FontSize="10"
                                                Foreground="#475569" Content="{Binding CollapseMark}"
                                                Click="SummaryToggleSystem_Click"
                                                AutomationProperties.Name="Свернуть или развернуть систему"
                                                Visibility="{Binding CanCollapseSystem, Converter={StaticResource OnlySystems}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ArrowHit" Background="Transparent" CornerRadius="3">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ArrowHit" Property="Background" Value="#D4E2F8"/></Trigger>
                                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ArrowHit" Property="BorderBrush" Value="#2563EB"/><Setter TargetName="ArrowHit" Property="BorderThickness" Value="1"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Margin" Value="0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsIndented}" Value="True">
                                                            <Setter Property="Margin" Value="14,0,0,0"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsExtraRow}" Value="True">
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Name, Mode=OneWay}" VerticalContentAlignment="Center"
                                             ToolTip="Наименование меняется и в смете"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="44" MinWidth="36" SortMemberPath="unit"
                                                CellStyle="{StaticResource SumCellPos}"
                                                HeaderStyle="{StaticResource SumHdrPos}">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="Ед." HorizontalAlignment="Center"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Unit}" Style="{StaticResource CompactCostCenter}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Unit, Mode=OneWay}" TextAlignment="Center"
                                             VerticalContentAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="60" MinWidth="44" SortMemberPath="qty"
                                                CellStyle="{StaticResource SumCellPos}"
                                                HeaderStyle="{StaticResource SumHdrPos}">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="Кол-во" HorizontalAlignment="Center"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding QtyText}" Style="{StaticResource CompactCostCenter}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding QtyRaw, Mode=OneWay}" TextAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Можно формулой: 12*1,15. Пусто — убрать"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
