                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="190" SortMemberPath="cost"
                                                    CellStyle="{StaticResource TotalsCostCell}"
                                                    HeaderStyle="{StaticResource TotalsArticleHeader}" Header="Себестоимость (нам)">
                                
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CostText}" Style="{StaticResource TotalsArticleMoney}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding CostRaw, Mode=OneWay}" TextAlignment="Right"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="Сумма — наш расход статьи. Пусто — не учитывается"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="190" SortMemberPath="sell"
                                                    CellStyle="{StaticResource TotalsSellCell}"
                                                    HeaderStyle="{StaticResource TotalsArticleHeader}" Header="Розница (клиенту)">
                                
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SellText}" Style="{StaticResource TotalsArticleMoney}"
                                                   ToolTip="{Binding SellTip}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding SellRaw, Mode=OneWay}" TextAlignment="Right"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="Сумма клиенту по статье (Enter — сохранить)"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="160" SortMemberPath="margin" IsReadOnly="True"
                                                CellStyle="{StaticResource TotalsArticleCell}"
                                                HeaderStyle="{StaticResource TotalsArticleHeader}"
                                                Binding="{Binding MarginText}" Header="Маржа">
                            
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource TotalsArticleMargin}"/></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="100" SortMemberPath="pct" IsReadOnly="True"
                                                CellStyle="{StaticResource TotalsArticleCell}"
                                                HeaderStyle="{StaticResource TotalsArticleHeader}"
                                                Binding="{Binding PctText}"
                                                ElementStyle="{StaticResource TotalsArticleMargin}" Header="Маржа, %">
                            
                        </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Итоги: Python kp_editor tot_bar + 4 tiles (Материалы / Монтаж · СМР /
             Дополнительные расходы / ИТОГО с НДС) в один ряд. -->
        <Border x:Name="TotalsFooterPanel" Grid.Row="5" Padding="24,12,24,14" Background="Transparent"
                BorderThickness="0">
            <DockPanel LastChildFill="True">
                <Button x:Name="ToggleTotalsButton" DockPanel.Dock="Right" VerticalAlignment="Top"
                        Style="{StaticResource DocumentFlatTool}" MinHeight="30"
                        Content="Скрыть итоги" Click="ToggleTotals_Click"/>
                <Grid>
                    <TextBlock x:Name="TotalsSummary" Visibility="Collapsed" TextWrapping="Wrap"
                               Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <UniformGrid x:Name="TotalsCards" Columns="4">
                <Border x:Name="MaterialsCard" Style="{StaticResource Card}" MinHeight="70">
                    <StackPanel>
                        <TextBlock x:Name="MaterialsCaption" Text="Материалы" Style="{StaticResource CardCaption}"/>
                        <TextBlock x:Name="MaterialsText" Style="{StaticResource CardValue}"/>
                    </StackPanel>
                </Border>
                <Border x:Name="SmrCard" Style="{StaticResource Card}" MinHeight="70">
                    <StackPanel>
                        <TextBlock x:Name="SmrCaption" Text="Монтаж · СМР" Style="{StaticResource CardCaption}"/>
                        <TextBox x:Name="SmrEdit" Style="{StaticResource PythonMoneyEdit}"
                                 KeyDown="TotalsEdit_KeyDown" LostFocus="SmrEdit_Commit"
                                 ToolTip="СМР: общая сумма (Enter — сохранить)"/>
                        <ComboBox x:Name="SmrModeCombo" Margin="0,6,0,0" MinHeight="30"
                                  SelectionChanged="SmrModeCombo_SelectionChanged"
                                  ToolTip="Как рассчитывать СМР: общей суммой, процентом от материалов, по системам или по позициям">
                            <ComboBoxItem Content="Суммой, ₽" Tag="sum"/>
                            <ComboBoxItem Content="Процентом, %" Tag="percent"/>
                            <ComboBoxItem Content="По системам" Tag="systems"/>
                            <ComboBoxItem Content="По позициям" Tag="pos"/>
                        </ComboBox>
                        <TextBlock x:Name="SmrHintText" Foreground="#64748B" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border x:Name="ExpensesCard" Style="{StaticResource Card}" MinHeight="70">
                    <StackPanel>
                        <TextBlock Text="Дополнительные расходы" Style="{StaticResource CardCaption}" Margin="0,0,0,4"/>
                        <Border x:Name="TransportCard" Margin="0,2,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Транспорт, ₽" Style="{StaticResource PythonTileLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="TransportEdit" Grid.Column="1" Style="{StaticResource PythonMoneyEdit}" MaxWidth="150" HorizontalAlignment="Stretch"
                                         KeyDown="TotalsEdit_KeyDown" LostFocus="TransportEdit_Commit"
                                         ToolTip="Транспорт: сумма (Enter — сохранить)"/>
                            </Grid>
                        </Border>
                        <Border x:Name="PnrCard" Margin="0,6,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Пусконаладка, ₽" Style="{StaticResource PythonTileLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="PnrEdit" Grid.Column="1" Style="{StaticResource PythonMoneyEdit}" MaxWidth="150" HorizontalAlignment="Stretch"
                                         KeyDown="TotalsEdit_KeyDown" LostFocus="PnrEdit_Commit"
                                         ToolTip="Пусконаладка: сумма (Enter — сохранить)"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
                <Border x:Name="TotalCard" Style="{StaticResource PythonTileAccent}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="ИТОГО с НДС" Foreground="White" FontWeight="SemiBold" FontSize="{StaticResource UiCaptionSize}"/>
                        <TextBlock x:Name="TotalText" Style="{StaticResource PythonTileValue}" Foreground="White"
                                   FontSize="24"/>
                        <TextBlock x:Name="DiscountTotalText" Foreground="#DBEAFE" FontSize="{StaticResource UiCaptionSize}"
                                   TextWrapping="Wrap" Visibility="Collapsed" Margin="0,2,0,0"/>
                        <TextBlock x:Name="VatText" Foreground="#DBEAFE" FontSize="{StaticResource UiCaptionSize}" TextWrapping="Wrap"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                    </UniformGrid>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
