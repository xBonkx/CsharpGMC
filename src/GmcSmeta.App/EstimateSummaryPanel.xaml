<Grid x:Class="GmcSmeta.App.EstimateSummaryPanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:GmcSmeta.App">
    <Grid.Resources>
        <BooleanToVisibilityConverter x:Key="OnlySystems"/>
    </Grid.Resources>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <!-- заголовок + кнопки справа (cost_summary_view.__init__: title_row) -->
    <WrapPanel Grid.Row="0" Margin="0,0,0,10" VerticalAlignment="Center">
        <TextBlock Text="Сводная стоимость" Foreground="#233C61" FontSize="{StaticResource UiSummaryTitleSize}" FontWeight="Bold"
                   VerticalAlignment="Center" Margin="0,0,12,4"/>
            <Button x:Name="SummaryTransferSmrButton" Style="{StaticResource PythonToolbarButton}"
                    Content="СМР в смету по системам…" ContentTemplate="{StaticResource IconLabelList}" Click="SummaryTransferSmr_Click" IsEnabled="False"
                    Margin="0,0,6,0" MinHeight="30"
                    ToolTip="Перенести розницу СМР из «Сводной» в системы сметы"/>
            <Button x:Name="SummaryExcelButton" Style="{StaticResource PythonToolbarButton}"
                    Content="Excel" ContentTemplate="{StaticResource IconLabelDownload}" Click="SummaryExcel_Click" IsEnabled="False" MinHeight="30"
                    ToolTip="Выгрузить текущий вид сводной в Excel (отчёт, без обратной загрузки)"/>
    </WrapPanel>
    <!-- панель фильтров, как на «Материалах» (bar: вид, «без цен», наценка, системы, поиск) -->
    <local:SummaryToolbarPanel Grid.Row="1" Margin="0,0,0,10">
        <WrapPanel x:Name="SummaryActions" VerticalAlignment="Center">
        <Button x:Name="SummaryGroupButton" Style="{StaticResource PythonToolbarButton}"
                Click="SummaryGroup_Click" Margin="0,0,6,0" Height="34" MinHeight="0"
                ToolTip="Как показать строки: по системам, одинаковые вместе, по поставщику">
            <StackPanel Orientation="Horizontal">
                <Viewbox Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphLayers}" Stroke="#64748B"/></Canvas></Viewbox>
                <TextBlock Text="Группировка" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        <Button x:Name="SummarySortButton" Style="{StaticResource PythonToolbarButton}"
                Click="SummarySort_Click" Margin="0,0,6,0" Height="34" MinHeight="0"
                ToolTip="Порядок строк внутри групп">
            <StackPanel Orientation="Horizontal">
                <Viewbox Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphSort}" Stroke="#64748B"/></Canvas></Viewbox>
                <TextBlock Text="Сортировка" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        <Border x:Name="SummaryMissingChrome" CornerRadius="7" BorderThickness="1" Height="34" Margin="0,0,6,0" SnapsToDevicePixels="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFF8EC"/>
                    <Setter Property="BorderBrush" Value="#EACD9C"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#B5761E"/></Trigger>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=SummaryMissingToggle}" Value="True">
                            <Setter Property="Background" Value="#E8F0FE"/>
                            <Setter Property="BorderBrush" Value="#2563EB"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="SummaryMissingToggle" Checked="SummaryMissing_Changed" Unchecked="SummaryMissing_Changed"
                              MinHeight="0" Padding="10,0,3,0" BorderThickness="0" Cursor="Hand"
                              AutomationProperties.Name="Фильтр позиций без цен"
                              ToolTip="Показать только позиции с выбранными пропусками цен">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Foreground" Value="#99631E"/>
                            <Setter Property="Template">
                                <Setter.Value><ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Hit" Background="Transparent" CornerRadius="6,0,0,6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hit" Property="Background" Value="#10000000"/></Trigger>
                                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hit" Property="Background" Value="#19000000"/></Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Hit" Property="BorderBrush" Value="#2563EB"/><Setter TargetName="Hit" Property="BorderThickness" Value="1"/></Trigger>
                                        <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="#1E40AF"/></Trigger>
                                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate></Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphAlert}" Stroke="#B5761E"/></Canvas></Viewbox>
                        <TextBlock x:Name="SummaryMissingText" Text="Без цен" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
                <Button x:Name="SummaryMissingArrow" Width="24" MinWidth="0" MinHeight="0" Padding="0"
                        Content="Варианты фильтра" AutomationProperties.Name="Выбрать пропуски цен"
                        Click="SummaryMissingMenu_Click" ToolTip="Какие пропуски цен искать">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Foreground" Value="#99631E"/>
                            <Setter Property="Template">
                                <Setter.Value><ControlTemplate TargetType="Button">
                                    <Border x:Name="Hit" Background="Transparent" CornerRadius="0,6,6,0">
                                        <Viewbox Style="{StaticResource SvgGlyphViewbox}" Width="12" Height="12"><Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphChevronDown}" Stroke="{TemplateBinding Foreground}"/></Canvas></Viewbox>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hit" Property="Background" Value="#10000000"/></Trigger>
                                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hit" Property="Background" Value="#19000000"/></Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Hit" Property="BorderBrush" Value="#2563EB"/><Setter TargetName="Hit" Property="BorderThickness" Value="1"/></Trigger>
                                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate></Setter.Value>
                            </Setter>
                            <Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=SummaryMissingToggle}" Value="True"><Setter Property="Foreground" Value="#1E40AF"/></DataTrigger></Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
        <Button x:Name="SummaryResetViewButton" Style="{StaticResource PythonToolbarButton}"
                Content="Как в КП" ContentTemplate="{StaticResource IconLabelX}" Click="SummaryResetView_Click" Visibility="Collapsed"
                Margin="0,0,6,0" Height="34" MinHeight="0" ToolTip="Вернуть обычный вид — по системам, как в КП"/>
        <Button x:Name="SummaryMarkupAllButton" Style="{StaticResource PythonToolbarButton}"
                Click="SummaryMarkupAll_Click" Margin="0,0,6,0" Height="34" MinHeight="0"
                ToolTip="Пересчитать цену клиенту по всем позициям СМР, включая скрытые фильтром">
            <StackPanel Orientation="Horizontal">
                <Viewbox Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphList}" Stroke="#64748B"/></Canvas></Viewbox>
                <TextBlock Text="Наценка на все СМР…" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        </WrapPanel>
        <WrapPanel x:Name="SummaryFilters" VerticalAlignment="Center">
        <Button x:Name="SummarySystemFilter" Width="170" Height="34" MinHeight="0"
                Click="SummarySystemFilter_Click" Margin="0,0,6,0"
                ToolTip="Показать одну или несколько систем вместе с подразделами"
                AutomationProperties.Name="Фильтр систем">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource PythonToolbarButton}">
                    <Style.Triggers>
                        <Trigger Property="Tag" Value="True">
                            <Setter Property="Background" Value="#E8F0FE"/>
                            <Setter Property="BorderBrush" Value="#2563EB"/>
                            <Setter Property="Foreground" Value="#1E40AF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <DockPanel LastChildFill="True" Width="146">
                <Viewbox DockPanel.Dock="Right" Width="12" Height="12" Margin="6,0,0,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphChevronDown}" Stroke="#64748B"/></Canvas></Viewbox>
                <TextBlock x:Name="SummarySystemFilterText" Text="Все системы" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
        </Button>
        <Grid Width="200" MinHeight="34"><TextBox x:Name="SummarySearch" Style="{StaticResource PythonIconSearch}" AutomationProperties.Name="Найти позицию"
                 TextChanged="SummarySearch_TextChanged"
                 ToolTip="Только строки с этим в названии (или системе / поставщике) — например «решетк»"/>
            <Viewbox Style="{StaticResource LayoutSmallSearchIcon}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphSearch}" Stroke="#94A3B8"/></Canvas></Viewbox>
            <TextBlock Text="Найти позицию…" Foreground="#64748B" Margin="30,0,32,0"
                       VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SummarySearch}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Content="Очистить" ContentTemplate="{StaticResource IconOnlyX}" Click="ClearSummarySearch_Click"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Width="26" Height="26" Padding="0"
                    ToolTip="Очистить поиск" AutomationProperties.Name="Очистить поиск позиций">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PythonToolbarButton}">
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SummarySearch}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
        </WrapPanel>
    </local:SummaryToolbarPanel>
    <!-- таблица (cost_summary_view.show_data): группы, полосатые строки по блокам,
         редактируются цены за ед./наименование/ед./кол-во, суммы считаются -->
    <local:SummaryTableFrame Grid.Row="2" CornerRadius="9" BorderThickness="1" BorderBrush="#DAE3EF" Background="White">
        <Grid ClipToBounds="True">
        <DataGrid local:TableColumnMenu.Key="estimate-summary" x:Name="SummaryGrid" AutoGenerateColumns="False" IsReadOnly="False"
              MinRowHeight="27" ColumnHeaderHeight="78" MinHeight="120"
              EnableRowVirtualization="True" EnableColumnVirtualization="True"
              VirtualizingPanel.VirtualizationMode="Recycling"
              VirtualizingPanel.ScrollUnit="Pixel"
              CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
              CanUserReorderColumns="True" RowHeaderWidth="0"
              HeadersVisibility="Column" GridLinesVisibility="All"
              HorizontalGridLinesBrush="#E9EEF5" VerticalGridLinesBrush="#EDF1F7"
              BorderThickness="0" Background="#FFFFFF"
              BeginningEdit="SummaryGrid_BeginningEdit" PreparingCellForEdit="SummaryGrid_PreparingCellForEdit"
              CellEditEnding="SummaryGrid_CellEditEnding" ContextMenuOpening="SummaryGrid_ContextMenuOpening"
              ScrollViewer.CanContentScroll="True"
              ScrollViewer.HorizontalScrollBarVisibility="Auto"
              ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.IsDeferredScrollingEnabled="False">
        <DataGrid.Resources>
            <Style TargetType="TextBox" BasedOn="{StaticResource CompactCostEditor}"/>
            <!-- шапки блоков: ПОЗИЦИЯ / МАТЕРИАЛЫ (голубой) / СМР (оранжевый) /
                 ИТОГО (зелёный) / маржи (сиреневый) — цвета SummaryHeader эталона -->
            <Style x:Key="SumHdrPos" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CompactCostHeader}">
                <Setter Property="Padding" Value="4,32,4,4"/>
                <Setter Property="Background" Value="#EFF3F9"/>
                <Setter Property="Foreground" Value="#526782"/>
            </Style>
            <Style x:Key="SumHdrMat" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CompactCostHeader}">
                <Setter Property="Padding" Value="4,32,4,4"/>
                <Setter Property="Background" Value="#F1F6FD"/>
                <Setter Property="Foreground" Value="#526782"/>
            </Style>
            <Style x:Key="SumHdrWork" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CompactCostHeader}">
                <Setter Property="Padding" Value="4,32,4,4"/>
                <Setter Property="Background" Value="#FFF8EF"/>
                <Setter Property="Foreground" Value="#526782"/>
            </Style>
            <Style x:Key="SumHdrTot" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CompactCostHeader}">
                <Setter Property="Padding" Value="4,32,4,4"/>
                <Setter Property="Background" Value="#F0F8F2"/>
                <Setter Property="Foreground" Value="#526782"/>
            </Style>
            <Style x:Key="SumHdrMarg" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CompactCostHeader}">
                <Setter Property="Padding" Value="4,32,4,4"/>
                <Setter Property="Background" Value="#F1EAFB"/>
                <Setter Property="Foreground" Value="#526782"/>
            </Style>
            <Style x:Key="SummaryMoney" TargetType="TextBlock" BasedOn="{StaticResource CompactCostMoney}"><Setter Property="TextTrimming" Value="None"/></Style>
            <!-- ячейки: полосатые строки внутри цветных блоков + шапки систем/ИТОГО -->
            <Style x:Key="SumCellBase" TargetType="DataGridCell" BasedOn="{StaticResource CompactCostCell}">
                <Setter Property="Padding" Value="6,3"/>
            </Style>
            <Style x:Key="SumCellPos" TargetType="DataGridCell" BasedOn="{StaticResource SumCellBase}">
                <Setter Property="Background" Value="#FFFFFF"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOdd}" Value="True">
                        <Setter Property="Background" Value="#EEF3FA"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSystemHeader}" Value="True">
                        <Setter Property="Background" Value="#E5ECF7"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsTotalRow}" Value="True">
                        <Setter Property="Background" Value="#E2ECFA"/>
                    </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource GridSelectionBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource GridSelectionTextBrush}"/>
                    </Trigger>
                    <Trigger Property="IsEditing" Value="True"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource GridSelectionTextBrush}"/></Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SumCellMat" TargetType="DataGridCell" BasedOn="{StaticResource SumCellBase}">
                <Setter Property="Background" Value="#F9FBFF"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOdd}" Value="True">
                        <Setter Property="Background" Value="#E7EFFB"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSystemHeader}" Value="True">
                        <Setter Property="Background" Value="#DCEAFB"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsTotalRow}" Value="True">
                        <Setter Property="Background" Value="#E2ECFA"/>
                    </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource GridSelectionBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource GridSelectionTextBrush}"/>
                    </Trigger>
                    <Trigger Property="IsEditing" Value="True"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource GridSelectionTextBrush}"/></Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SumCellWork" TargetType="DataGridCell" BasedOn="{StaticResource SumCellBase}">
                <Setter Property="Background" Value="#FFFCF7"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOdd}" Value="True">
                        <Setter Property="Background" Value="#F8ECDC"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSystemHeader}" Value="True">
                        <Setter Property="Background" Value="#F9E3C7"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsTotalRow}" Value="True">
                        <Setter Property="Background" Value="#F5E8D7"/>
                    </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource GridSelectionBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource GridSelectionTextBrush}"/>
                    </Trigger>
                    <Trigger Property="IsEditing" Value="True"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource GridSelectionTextBrush}"/></Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SumCellTot" TargetType="DataGridCell" BasedOn="{StaticResource SumCellBase}">
                <Setter Property="Background" Value="#F7FCF8"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOdd}" Value="True">
                        <Setter Property="Background" Value="#E4F2E8"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSystemHeader}" Value="True">
                        <Setter Property="Background" Value="#DAEDDF"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsTotalRow}" Value="True">
                        <Setter Property="Background" Value="#DAEDDF"/>
                    </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource GridSelectionBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource GridSelectionTextBrush}"/>
                    </Trigger>
                    <Trigger Property="IsEditing" Value="True"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource GridSelectionTextBrush}"/></Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SumCellMarg" TargetType="DataGridCell" BasedOn="{StaticResource SumCellBase}">
                <Setter Property="Background" Value="#FAF7FE"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOdd}" Value="True">
                        <Setter Property="Background" Value="#EDE4F8"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSystemHeader}" Value="True">
                        <Setter Property="Background" Value="#E8DCF6"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsTotalRow}" Value="True">
                        <Setter Property="Background" Value="#E9E1F5"/>
                    </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource GridSelectionBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource GridSelectionTextBrush}"/>
                    </Trigger>
                    <Trigger Property="IsEditing" Value="True"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource GridSelectionTextBrush}"/></Trigger>
                </Style.Triggers>
            </Style>
        </DataGrid.Resources>
        <DataGrid.RowStyle>
            <Style TargetType="DataGridRow" BasedOn="{StaticResource PythonTableRow}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSystemHeader}" Value="True">
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="#344B6B"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsTotalRow}" Value="True">
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsExtraRow}" Value="True">
                        <Setter Property="FontWeight" Value="Normal"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </DataGrid.RowStyle>
        <DataGrid.Columns>
            <!-- ПОЗИЦИЯ: наименование с ▾ сворачиванием систем, ед., кол-во -->
            <DataGridTemplateColumn Width="*" MinWidth="160" SortMemberPath="name" CanUserReorder="False"
                                    CellStyle="{StaticResource SumCellPos}"
                                    HeaderStyle="{StaticResource SumHdrPos}">
                <DataGridTemplateColumn.Header>
                    <TextBlock Text="Наименование" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Width="22" MinWidth="22" MinHeight="24" Margin="0,0,4,0" Padding="0"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#475569"
                                    Click="SummaryToggleSystem_Click"
                                    AutomationProperties.Name="Свернуть или развернуть систему"
                                    Visibility="{Binding CanCollapseSystem, Converter={StaticResource OnlySystems}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ArrowHit" Background="Transparent" CornerRadius="3">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ArrowHit" Property="Background" Value="#D4E2F8"/></Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ArrowHit" Property="BorderBrush" Value="#2563EB"/><Setter TargetName="ArrowHit" Property="BorderThickness" Value="1"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Viewbox Style="{StaticResource SvgGlyphViewbox}" Width="12" Height="12">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                            <Path.Style>
                                                <Style TargetType="Path" BasedOn="{StaticResource SvgGlyphPath}">
                                                    <Setter Property="Data" Value="{StaticResource GlyphChevronDown}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CollapseMark}" Value="▸">
                                                            <Setter Property="Data" Value="{StaticResource GlyphChevronRight}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsIndented}" Value="True">
                                                <Setter Property="Margin" Value="14,0,0,0"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsExtraRow}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
                <DataGridTemplateColumn.CellEditingTemplate>
                    <DataTemplate>
                        <TextBox Text="{Binding Name, Mode=OneWay}" VerticalContentAlignment="Center"
                                 ToolTip="Наименование меняется и в смете"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellEditingTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Width="44" MinWidth="36" SortMemberPath="unit"
                                    CellStyle="{StaticResource SumCellPos}"
                                    HeaderStyle="{StaticResource SumHdrPos}">
                <DataGridTemplateColumn.Header>
                    <TextBlock Text="Ед." HorizontalAlignment="Center"/>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Unit}" Style="{StaticResource CompactCostCenter}"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
                <DataGridTemplateColumn.CellEditingTemplate>
                    <DataTemplate>
                        <TextBox Text="{Binding Unit, Mode=OneWay}" TextAlignment="Center"
                                 VerticalContentAlignment="Center"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellEditingTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Width="60" MinWidth="44" SortMemberPath="qty"
                                    CellStyle="{StaticResource SumCellPos}"
                                    HeaderStyle="{StaticResource SumHdrPos}">
                <DataGridTemplateColumn.Header>
                    <TextBlock Text="Кол-во" HorizontalAlignment="Center"/>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding QtyText}" Style="{StaticResource CompactCostCenter}"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
                <DataGridTemplateColumn.CellEditingTemplate>
