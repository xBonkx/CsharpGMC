    <!-- примечание под таблицей (⚠ Неполно / Показано по фильтру) -->
    <TextBlock x:Name="SummaryNote" Grid.Row="3" Foreground="#64748B" TextWrapping="Wrap"
               Margin="0,10,0,0" Visibility="Collapsed"/>
    <!-- плитки (cost_summary_view tiles): материалы / СМР / себестоимость /
         цена клиенту / маржа материалов + работ -->
    <Grid Grid.Row="4" Margin="0,10,0,0">
        <Grid.Resources>
            <Style x:Key="SummaryTileFrame" TargetType="Border" BasedOn="{StaticResource PythonTile}">
                <Setter Property="Effect" Value="{x:Null}"/>
                <Setter Property="BorderBrush" Value="#DFE6F0"/>
                <Setter Property="CornerRadius" Value="9"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Padding" Value="16,11"/>
            </Style>
            <Style x:Key="SummaryTileCaption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource UiSummaryCaptionSize}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="SummaryTileNumber" TargetType="TextBlock" BasedOn="{StaticResource PythonTileValue}">
                <Setter Property="FontSize" Value="{StaticResource UiSummaryValueSize}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
            </Style>
            <Style x:Key="SummaryTileDetail" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource UiCaptionSize}"/>
                <Setter Property="Foreground" Value="#64748B"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="SummaryTileMat" Grid.Column="0" Style="{StaticResource SummaryTileFrame}" Background="#F1F6FD">
            <StackPanel>
                <TextBlock Text="Материалы · цена клиенту" Style="{StaticResource SummaryTileCaption}" Foreground="#2B659C"/>
                <TextBlock x:Name="SummaryTileMatValue" Style="{StaticResource SummaryTileNumber}" Foreground="#2B659C"/>
                <TextBlock x:Name="SummaryTileMatDetail" Style="{StaticResource SummaryTileDetail}"/>
            </StackPanel>
        </Border>
        <Border x:Name="SummaryTileWork" Grid.Column="2" Style="{StaticResource SummaryTileFrame}" Background="#FFF8EF">
            <StackPanel>
                <TextBlock Text="СМР по позициям" Style="{StaticResource SummaryTileCaption}" Foreground="#956023"/>
                <TextBlock x:Name="SummaryTileWorkValue" Style="{StaticResource SummaryTileNumber}" Foreground="#956023"/>
                <TextBlock x:Name="SummaryTileWorkDetail" Style="{StaticResource SummaryTileDetail}"/>
            </StackPanel>
        </Border>
        <Border x:Name="SummaryTileCost" Grid.Column="4" Style="{StaticResource SummaryTileFrame}" Background="#F1F4F9">
            <StackPanel>
                <TextBlock Text="Себестоимость · всего" Style="{StaticResource SummaryTileCaption}" Foreground="#415B7E"/>
                <TextBlock x:Name="SummaryTileCostValue" Style="{StaticResource SummaryTileNumber}" Foreground="#415B7E"/>
                <TextBlock Text="Материалы + работы + транспорт" Style="{StaticResource SummaryTileDetail}"/>
            </StackPanel>
        </Border>
        <Border x:Name="SummaryTileSell" Grid.Column="6" Style="{StaticResource SummaryTileFrame}" Background="#EDF8F0">
            <StackPanel>
                <TextBlock Text="Цена клиенту · всего" Style="{StaticResource SummaryTileCaption}" Foreground="#287445"/>
                <TextBlock x:Name="SummaryTileSellValue" Style="{StaticResource SummaryTileNumber}" Foreground="#287445"/>
                <TextBlock Text="По текущей сводной" Style="{StaticResource SummaryTileDetail}"/>
            </StackPanel>
        </Border>
        <Border x:Name="SummaryTileMargin" Grid.Column="8" Style="{StaticResource SummaryTileFrame}" Background="#F3EDFB">
            <StackPanel>
                <TextBlock Text="Маржа материалов" Style="{StaticResource SummaryTileCaption}" Foreground="#7954A8"/>
                <TextBlock x:Name="SummaryTileMatMarginValue" Style="{StaticResource SummaryTileNumber}" Foreground="#7954A8"/>
                <TextBlock Text="Маржа работ" Style="{StaticResource SummaryTileCaption}" Foreground="#7954A8" Margin="0,2,0,0"/>
                <TextBlock x:Name="SummaryTileWorkMarginValue" Style="{StaticResource SummaryTileNumber}" Foreground="#7954A8"/>
            </StackPanel>
        </Border>
    </Grid>
</Grid>
