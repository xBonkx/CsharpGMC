<Window x:Class="GmcSmeta.App.LetterEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GmcSmeta.App"
        Title="Письмо" Width="1050" Height="820" MinWidth="790" MinHeight="590"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA"
        FontFamily="{StaticResource UiFontFamily}" FontSize="{StaticResource UiBodySize}" Closing="Editor_Closing" Foreground="#0F172A" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <DockPanel Margin="{StaticResource LayoutAuxTabPageMargin}">
        <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Margin="2,0,0,12"
                   Foreground="{StaticResource UiMutedTextBrush}" TextWrapping="Wrap"/>
        <WrapPanel x:Name="EditorActions" DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource PythonToolbarButton}" Content="Сохранить" ContentTemplate="{StaticResource IconLabelCheck}" Click="Save_Click" Padding="12,7" Margin="{StaticResource LayoutAuxActionGap}"/>
            <Button Style="{StaticResource PythonToolbarButton}" Content="Предпросмотр PDF" ContentTemplate="{StaticResource IconLabelFile}" Click="Preview_Click" Padding="12,7" Margin="{StaticResource LayoutAuxActionGap}"/>
            <Button Style="{StaticResource PythonToolbarButton}" x:Name="BuildButton" Content="Собрать выдачу…" ContentTemplate="{StaticResource IconLabelDownload}" Click="Build_Click" Padding="12,7" Margin="{StaticResource LayoutAuxActionGap}"/>
            <Button Style="{StaticResource PythonToolbarButton}" x:Name="SendButton" Content="Отметить отправленным…" Click="Sent_Click" Padding="12,7" Margin="{StaticResource LayoutAuxActionGap}"/>
            <Button Style="{StaticResource PythonToolbarButton}" Content="История…" ContentTemplate="{StaticResource IconLabelHistory}" Click="History_Click" Padding="12,7" Margin="{StaticResource LayoutAuxActionGap}"/>
            <Button Style="{StaticResource PythonToolbarButton}" Content="Закрыть" Click="Close_Click" Padding="12,7" Margin="{StaticResource LayoutAuxActionGap}"/>
        </WrapPanel>
        <TabControl x:Name="LetterTabs" Background="White" Style="{StaticResource PythonTabbedPane}">
            <TabItem Header="1. Реквизиты">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="{StaticResource LayoutAuxTabPageMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MaxWidth="220"/>
                            <ColumnDefinition Width="5*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" Text="Исходящий №"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="NumberBox" Margin="0,2,0,6"
                                 TextChanged="Number_Changed"/>
                        <TextBlock Grid.Row="1" Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" Text="Дата (ДД.ММ.ГГГГ)"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="DateBox" Margin="0,2,0,6" LostFocus="Date_LostFocus"/>
                        <Button Style="{StaticResource PythonToolbarButton}" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Content="Номер по дате" Click="AutoNumber_Click" Padding="12,6" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="3" Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" Text="Объект / договор (для поиска)"/>
                        <Grid Grid.Row="3" Grid.Column="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="ObjectBox" Margin="0,2,8,6"/>
                            <Button Style="{StaticResource PythonToolbarButton}" x:Name="ObjectButton" Grid.Column="1" Padding="12,6" MaxWidth="220"
                                    Margin="0,2,0,6" Click="Object_Click">
                                <TextBlock Text="Выбрать объект из основной базы…" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                        </Grid>
                        <TextBlock Grid.Row="4" Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" Text="Тема"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="SubjectBox" MinHeight="32" Margin="0,2,0,6"/>
                        <TextBlock Grid.Row="5" Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" Text="Шапка организации"/>
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="SenderBox" MinHeight="110" MaxHeight="240" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Margin="0,2,0,6"/>
                        <Button Style="{StaticResource PythonToolbarButton}" Grid.Row="6" Grid.Column="1" HorizontalAlignment="Left"
                                Content="Реквизиты из «Наших организаций»…" Padding="12,6" Click="Company_Click" Margin="0,0,0,8" x:Name="CompanyButton"/>
                        <TextBlock Grid.Row="7" Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" Text="Кому"/>
                        <TextBox Grid.Row="7" Grid.Column="1" x:Name="RecipientBox" MinHeight="110" MaxHeight="240" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Margin="0,2,0,6"/>
                        <TextBlock Grid.Row="8" Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" Text="Обращение"/>
                        <TextBox Grid.Row="8" Grid.Column="1" x:Name="GreetingBox" MinHeight="32" Margin="0,2,0,6"/>
                        <TextBlock Grid.Row="9" Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" Text="Должность, ФИО подписанта"/>
                        <TextBox Grid.Row="9" Grid.Column="1" x:Name="SignerBox" MinHeight="32" Margin="0,2,0,6"/>
                        <CheckBox Grid.Row="10" Grid.Column="1" x:Name="ScanMode"
                                  Content="Использовать сканы вместо текста письма (в порядке списка файлов)"
                                  Margin="0,12,0,8"/>
                        <TextBlock Grid.Row="11" Grid.ColumnSpan="2" x:Name="ContextNote"
                                   Foreground="{StaticResource UiMutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="2. Текст письма">
                <DockPanel Margin="{StaticResource LayoutAuxTabPageMargin}">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Button Style="{StaticResource PythonToolbarButton}" FontWeight="Bold" Content="Жирный" Click="Bold_Click" Padding="12,6" Margin="{StaticResource LayoutAuxActionGap}"/>
                        <Button Style="{StaticResource PythonToolbarButton}" FontStyle="Italic" Content="Курсив" Click="Italic_Click" Padding="12,6" Margin="{StaticResource LayoutAuxActionGap}"/>
                        <Button Style="{StaticResource PythonToolbarButton}" Content="Список" Click="List_Click" Padding="12,6" Margin="{StaticResource LayoutAuxActionGap}"/>
                        <Button Style="{StaticResource PythonToolbarButton}" Content="По левому краю" Click="AlignLeft_Click" Padding="12,6" Margin="{StaticResource LayoutAuxActionGap}"/>
                        <Button Style="{StaticResource PythonToolbarButton}" Content="По центру" Click="AlignCenter_Click" Padding="12,6" Margin="{StaticResource LayoutAuxActionGap}"/>
                        <Button Style="{StaticResource PythonToolbarButton}" Content="По ширине" Click="AlignJustify_Click" Padding="12,6" Margin="{StaticResource LayoutAuxActionGap}"/>
                    </WrapPanel>
                    <RichTextBox x:Name="BodyBox" AcceptsTab="True" VerticalScrollBarVisibility="Auto"
                                 Background="White" BorderBrush="#D0D7E2" Padding="10" FontFamily="Times New Roman"
                                 FontSize="16"/>
                </DockPanel>
            </TabItem>
            <TabItem Header="3. Приложения и сканы">
                <DockPanel Margin="{StaticResource LayoutAuxTabPageMargin}">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" Foreground="{StaticResource UiMutedTextBrush}"
                               TextWrapping="Wrap" Text="Приложения выдаются отдельно. Сканы письма и подтверждения отправки хранятся в карточке."/>
                    <StackPanel DockPanel.Dock="Bottom">
                        <WrapPanel Margin="0,6,0,3">
                            <ComboBox x:Name="RoleBox" MinWidth="180" MaxWidth="320" MinHeight="{StaticResource LayoutFieldMinHeight}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" SelectedIndex="0" Margin="0,0,8,6">
                                <ComboBoxItem Content="Приложение"/>
                                <ComboBoxItem Content="Скан письма"/>
                                <ComboBoxItem Content="Подтверждение отправки"/>
                            </ComboBox>
                            <Button Style="{StaticResource PythonToolbarButton}" Content="Добавить PDF / фото…" Click="FileAdd_Click" Padding="10,5" Margin="{StaticResource LayoutAuxActionGap}"/>
                            <Button Style="{StaticResource PythonToolbarButton}" Content="Открыть" Click="FileOpen_Click" Padding="10,5" Margin="{StaticResource LayoutAuxActionGap}"/>
                            <Button Style="{StaticResource PythonToolbarButton}" Content="Название…" Click="FileRename_Click" Padding="10,5" Margin="{StaticResource LayoutAuxActionGap}"/>
                            <Button Style="{StaticResource PythonToolbarButton}" Content="Включить / исключить" Click="FileToggle_Click" Padding="10,5" Margin="{StaticResource LayoutAuxActionGap}"/>
                            <Button Style="{StaticResource PythonToolbarButton}" Content="Выше" ContentTemplate="{StaticResource IconOnlyArrowUp}" AutomationProperties.Name="Выше" ToolTip="Выше" Click="FileUp_Click" Margin="{StaticResource LayoutAuxActionGap}" Width="32" MinWidth="32" Padding="4" />
                            <Button Style="{StaticResource PythonToolbarButton}" Content="Ниже" ContentTemplate="{StaticResource IconOnlyArrowDown}" AutomationProperties.Name="Ниже" ToolTip="Ниже" Click="FileDown_Click" Margin="{StaticResource LayoutAuxActionGap}" Width="32" MinWidth="32" Padding="4" />
                        </WrapPanel>
                        <CheckBox x:Name="CombineBox" Margin="0,4,0,10" Content="Дополнительно собрать письмо и приложения в один PDF"/>
                        <TextBlock Text="Выпуски (двойной щелчок — открыть папку):" Margin="0,0,0,4"/>
                        <ListBox x:Name="ReleasesBox" Height="110" MouseDoubleClick="Releases_DoubleClick"/>
                    </StackPanel>
                    <DataGrid local:TableColumnMenu.Key="letter-files" local:TableColumnMenu.Protect="Название" x:Name="FilesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False"
                              Background="White" MinRowHeight="27" AlternationCount="0" RowStyle="{StaticResource PythonTableRow}" HeadersVisibility="Column" Style="{StaticResource DocumentTable}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="2*" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                            <DataGridTextColumn Header="Назначение" Binding="{Binding Kind}" Width="*" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                            <DataGridTextColumn Header="Страниц" Binding="{Binding Pages}" Width="75" ElementStyle="{StaticResource CompactCostCenter}" HeaderStyle="{StaticResource KsQuantityHeader}"/>
                            <DataGridCheckBoxColumn Header="В выдаче" Binding="{Binding Included}" Width="92"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>