<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Logical DIP; page owns outer spacing, child content must not repeat it.
         Summary keeps Python's inner 12/8/20/16, composed with page 24/6/24/14.
         Standalone cost window overrides LayoutCostPaneMargin locally. -->
    <Thickness x:Key="LayoutPageMargin">24,18,24,14</Thickness>
    <!-- Python main_window.py side margins/spacing and 40px show-panel reservation. -->
    <Thickness x:Key="LayoutSidebarPadding">14,16,14,12</Thickness>
    <Thickness x:Key="LayoutSidebarSectionGap">0,0,0,10</Thickness>
    <Thickness x:Key="LayoutShowSidebarMargin">24,6,0,4</Thickness>
    <Thickness x:Key="LayoutPageHeaderPadding">24,18,24,0</Thickness>
    <Thickness x:Key="LayoutDocumentTabsPadding">24,12,24,0</Thickness>
    <Thickness x:Key="LayoutDocumentToolbarMargin">24,6,24,0</Thickness>
    <Thickness x:Key="LayoutEmbeddedPageMargin">24,6,24,14</Thickness>
    <Thickness x:Key="LayoutCostPaneMargin">24,6,24,14</Thickness>
    <!-- Python cost_totals_view.py: max content width1060, tile spacing10,
         vertical spacing12, row34; 4px white space below the last row. -->
    <sys:Double x:Key="LayoutTotalsMaxWidth">1060</sys:Double>
    <sys:Double x:Key="LayoutTotalsTileGap">10</sys:Double>
    <Thickness x:Key="LayoutTotalsTileSectionGap">0,0,0,12</Thickness>
    <Thickness x:Key="LayoutTotalsTablePadding">0,0,0,4</Thickness>
    <sys:Double x:Key="LayoutTotalsRowHeight">34</sys:Double>
    <Thickness x:Key="LayoutSummaryPageMargin">36,14,44,30</Thickness>
    <Thickness x:Key="LayoutDocumentFooterPadding">24,12,24,14</Thickness>
    <!-- Collapsed footer owns only one summary line, not full card spacing. -->
    <Thickness x:Key="LayoutDocumentFooterCompactPadding">24,6,24,8</Thickness>
    <Thickness x:Key="LayoutDialogMargin">22,18,22,16</Thickness>
    <!-- dialogs.py _form: 22/18/22/18, spacing 9; labels right/center. -->
    <Thickness x:Key="LayoutFormDialogMargin">22,18,22,18</Thickness>
    <Thickness x:Key="LayoutFormFieldMargin">0,0,0,9</Thickness>
    <Thickness x:Key="LayoutFormLabelMargin">0,0,9,9</Thickness>
    <Thickness x:Key="LayoutCompareDialogMargin">20,16,20,16</Thickness>
    <Thickness x:Key="LayoutCardPadding">18,14,18,14</Thickness>
    <Thickness x:Key="LayoutTilePadding">16,11,16,11</Thickness>
    <!-- director_view.py root spacing12; tile gap10; object_view.py legend gap14. -->
    <Thickness x:Key="LayoutDirectorSectionGap">0,12,0,0</Thickness>
    <Thickness x:Key="LayoutDirectorTileInset">5,5</Thickness>
    <Thickness x:Key="LayoutDirectorTilesInset">-5,7,-5,-5</Thickness>
    <Thickness x:Key="LayoutCardLegendGap">0,0,14,0</Thickness>
    <!-- Small affordances, navigation icons and primary toolbar icons are different roles. -->
    <Style x:Key="LayoutSmallAffordanceIcon" TargetType="Viewbox">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="LayoutSmallSearchIcon" TargetType="Viewbox" BasedOn="{StaticResource LayoutSmallAffordanceIcon}">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
    </Style>
    <Style x:Key="LayoutNavigationIcon" TargetType="Viewbox" BasedOn="{StaticResource LayoutSmallAffordanceIcon}">
        <Setter Property="Width" Value="17"/>
        <Setter Property="Height" Value="17"/>
    </Style>
    <sys:Double x:Key="LayoutToolbarGlyphSize">18</sys:Double>
    <sys:Double x:Key="LayoutBrandGlyphSize">28</sys:Double>
    <sys:Double x:Key="LayoutMenuGlyphSize">20</sys:Double>
    <sys:Double x:Key="LayoutHeaderActionMinHeight">34</sys:Double>
    <Thickness x:Key="LayoutHeaderActionGap">0,0,6,0</Thickness>
    <sys:Double x:Key="LayoutObjectTileGap">10</sys:Double>
    <Thickness x:Key="LayoutToolbarPadding">10,4,10,4</Thickness>
    <Thickness x:Key="LayoutCellPadding">4,3,4,3</Thickness>
    <!-- QTabBar: 14/7 padding, pane overlaps the tab strip by one DIP. -->
    <Thickness x:Key="LayoutAuxTabHeaderPadding">14,7</Thickness>
    <Thickness x:Key="LayoutAuxTabPaneOverlap">0,-1,0,0</Thickness>
    <Thickness x:Key="LayoutAuxTabPageMargin">12</Thickness>
    <Thickness x:Key="LayoutAuxActionGap">0,0,6,6</Thickness>
    <!-- Qt final field inset and drop-down arrow width; explicit compact controls can override. -->
    <Thickness x:Key="LayoutFieldPadding">10,6</Thickness>
    <sys:Double x:Key="LayoutFieldMinHeight">32</sys:Double>
    <sys:Double x:Key="LayoutComboArrowWidth">22</sys:Double>
    <sys:Double x:Key="LayoutDocumentRowMinHeight">27</sys:Double>
</ResourceDictionary>
