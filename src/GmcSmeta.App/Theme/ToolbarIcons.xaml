    <Style x:Key="SvgGlyphPath" TargetType="Path">
        <Setter Property="Stretch" Value="None"/>
        <Setter Property="StrokeThickness" Value="1.9"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <DataTemplate x:Key="IconLabelPlus">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Viewbox Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" IsHitTestVisible="False" Stretch="Uniform">
                <Canvas Width="24" Height="24">
                    <Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphPlus}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}"/>
                </Canvas>
            </Viewbox>
            <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
        </StackPanel>
    </DataTemplate>
