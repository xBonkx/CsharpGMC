<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Python overrides use both pt and px. 12pt=16 DIP, 18pt=24 DIP;
         explicit summary px sizes remain 19/22/11, not converted twice. -->
    <sys:Double x:Key="UiSummaryTitleSize">19</sys:Double>
    <sys:Double x:Key="UiSummaryValueSize">22</sys:Double>
    <sys:Double x:Key="UiSummaryCaptionSize">11</sys:Double>
    <sys:Double x:Key="UiMoneyInputSize">16</sys:Double>
    <sys:Double x:Key="UiGrandTotalSize">24</sys:Double>
    <sys:Double x:Key="UiTotalDetailSize">12</sys:Double>
    <sys:Double x:Key="UiHelpBodySize">15.333333333333334</sys:Double>
    <!-- kp_editor.py _apply_zoom_style: heading = body × 0.95. -->
    <sys:Double x:Key="UiEstimateHeaderZoomRatio">0.95</sys:Double>
    <!-- Natural font metrics, rather than a fixed line box that can clip
         wrapped titles at non-default scale or with fallback fonts. -->
    <Style x:Key="UiWrappedHeading" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineStackingStrategy" Value="MaxHeight"/>
    </Style>
    <!-- Keep disabled text readable on white and pale dialog surfaces; inactive non-text affordances retain the original shade. -->
    <SolidColorBrush x:Key="UiMutedTextBrush" Color="#526174"/>
    <SolidColorBrush x:Key="UiDisabledTextBrush" Color="#59697D"/>
    <SolidColorBrush x:Key="UiDisabledAffordanceBrush" Color="#94A3B8"/>
    <!-- Python navigation: 8.8pt, not a second application-scale multiplier. -->
    <sys:Double x:Key="UiNavigationDetailSize">11.733333333333333</sys:Double>
    <sys:Double x:Key="UiTotalsTableSize">14</sys:Double>
    <Style x:Key="UiPageHeading" TargetType="TextBlock" BasedOn="{StaticResource UiWrappedHeading}">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="UiHeadingText" TargetType="TextBlock" BasedOn="{StaticResource UiWrappedHeading}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="UiSecondaryText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource UiMutedTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineStackingStrategy" Value="MaxHeight"/>
    </Style>
</ResourceDictionary>
