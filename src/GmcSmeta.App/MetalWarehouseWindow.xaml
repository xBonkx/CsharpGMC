<Window x:Class="GmcSmeta.App.MetalWarehouseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GmcSmeta.App"
        Title="Склад металла" Width="1370" Height="810" MinWidth="970" MinHeight="610"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA"
        FontFamily="{StaticResource UiFontFamily}" FontSize="{StaticResource UiBodySize}" Foreground="#0F172A" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <local:MetalAreaConverter xmlns:local="clr-namespace:GmcSmeta.App" x:Key="Area" />
        <local:MetalPaidTextConverter x:Key="MetalPaidText"/>
        <Style TargetType="DataGrid" BasedOn="{StaticResource DocumentTable}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="MinRowHeight" Value="27"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E4E8EF"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E4E8EF"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
        </Style>
        <Style x:Key="MetalOwnedCell" TargetType="DataGridCell" BasedOn="{StaticResource CompactCostCell}">
            <Setter Property="Background" Value="#EAF5ED"/>
        </Style>
        <Style x:Key="MetalSupplierCell" TargetType="DataGridCell" BasedOn="{StaticResource CompactCostCell}">
            <Setter Property="Background" Value="#EAF2FC"/>
        </Style>
        <Style x:Key="MetalDeficitCell" TargetType="DataGridCell" BasedOn="{StaticResource CompactCostCell}">
            <Setter Property="Background" Value="#FCE8E6"/>
            <Setter Property="Foreground" Value="#A21C26"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Deficit}" Value="0">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource GridSelectionBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource GridSelectionTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MetalStockHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource KsMoneyHeader}">
            <Setter Property="MinHeight" Value="42"/>
        </Style>
        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource PythonTile}">
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top">
            <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Style="{StaticResource PythonToolbarButton}" Content="Провести операцию…" Click="Operation_Click" Padding="13,7" Margin="0,0,8,0"/>
                <Button Style="{StaticResource PythonToolbarButton}" x:Name="OpeningButton" Content="Перенести остатки из Excel…" ContentTemplate="{StaticResource IconLabelUpload}" Click="Import_Click" Padding="12,7" Margin="0,0,8,0"/>
                <Button Style="{StaticResource PythonToolbarButton}" Content="Учёт металла (Excel)…" ContentTemplate="{StaticResource IconLabelList}" Click="Register_Click" Padding="12,7" Margin="0,0,8,0"/>
                <Button Style="{StaticResource PythonToolbarButton}" Content="Отчёт Excel…" ContentTemplate="{StaticResource IconLabelDownload}" Click="Export_Click" Padding="12,7" Margin="0,0,8,0"/>
                <Button Style="{StaticResource PythonToolbarButton}" Content="Обновить" ContentTemplate="{StaticResource IconLabelRefresh}" Click="Refresh_Click" Padding="12,7"/>
            </WrapPanel>
            <TextBlock x:Name="StatusText" Text="Загрузка…" TextWrapping="Wrap" Foreground="{StaticResource UiMutedTextBrush}" Margin="1,1,0,8"/>
        </StackPanel>
        <TabControl x:Name="Tabs" Style="{StaticResource PythonTabbedPane}">
            <TabItem Header="Остатки">
                <Grid Margin="9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <UniformGrid Grid.Row="0" Columns="5" Margin="0,0,0,10">
                        <Border Style="{StaticResource PythonTileAccent}" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Всего в собственности" Style="{StaticResource PythonTileLabel}" Foreground="White"/>
                                <TextBlock x:Name="TotalOwned" Style="{StaticResource PythonTileValue}" Foreground="White"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="Физически у нас" Style="{StaticResource PythonTileLabel}"/>
                                <TextBlock x:Name="TotalOurs" Style="{StaticResource PythonTileValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="На хранении у поставщиков" Style="{StaticResource PythonTileLabel}"/>
                                <TextBlock x:Name="TotalSupplier" Style="{StaticResource PythonTileValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="Осталось обеспечить" Style="{StaticResource PythonTileLabel}"/>
                                <TextBlock x:Name="TotalNeed" Style="{StaticResource PythonTileValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="Дефицит по материалам" Style="{StaticResource PythonTileLabel}"/>
                                <TextBlock x:Name="TotalDeficit" Style="{StaticResource PythonTileValue}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <WrapPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Категория:" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <ComboBox x:Name="StockCategory" Width="205" MinHeight="{StaticResource LayoutFieldMinHeight}" SelectedIndex="0" SelectionChanged="StockFilter_Changed" Margin="0,0,14,0">
                            <ComboBoxItem Content="Металл в бухтах" Tag="Бухты"/>
                            <ComboBoxItem Content="Штрипсы" Tag="Штрипсы"/>
                            <ComboBoxItem Content="Листовой металл" Tag="Листы"/>
                            <ComboBoxItem Content="Все материалы" Tag=""/>
                        </ComboBox>
                        </StackPanel>
                        <Grid Width="270" Margin="0,0,0,4">
                            <TextBox x:Name="StockSearch" Style="{StaticResource PythonSearch}" AutomationProperties.Name="Поиск материала или толщины" Background="White"
                                     BorderBrush="#D0D7E2" Padding="32,5,10,5" VerticalContentAlignment="Center"
                                     ToolTip="Найти материал или толщину" TextChanged="StockFilter_Changed"/>
                            <Viewbox Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphSearch}" Stroke="#64748B"/></Canvas></Viewbox>
                    <TextBlock Text="Найти материал или толщину" Foreground="{StaticResource UiMutedTextBrush}" Margin="32,0,10,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style><Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=StockSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </WrapPanel>
                    <DataGrid local:TableColumnMenu.Key="metal-stock" local:TableColumnMenu.Protect="Материал" x:Name="StockGrid" Grid.Row="2" ColumnHeaderHeight="42" SelectionChanged="StockGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="95" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                            <DataGridTextColumn Header="Материал" Binding="{Binding Material}" Width="*" MinWidth="150" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                            <DataGridTextColumn Header="У нас, м²" Binding="{Binding Ours,Converter={StaticResource Area}}" Width="105" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource MetalStockHeader}" CellStyle="{StaticResource MetalOwnedCell}"/>
                            <DataGridTextColumn local:TableColumnMenu.FitDisplayPath="OursPieces" Header="У нас, шт." Binding="{Binding OursPieces}" Width="84" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource MetalStockHeader}" CellStyle="{StaticResource MetalOwnedCell}"/>
                            <DataGridTextColumn Header="У поставщиков, м²" Binding="{Binding Supplier,Converter={StaticResource Area}}" Width="118" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource MetalStockHeader}" CellStyle="{StaticResource MetalSupplierCell}"/>
                            <DataGridTextColumn local:TableColumnMenu.FitDisplayPath="SupplierPieces" Header="У поставщиков, шт." Binding="{Binding SupplierPieces}" Width="106" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource MetalStockHeader}" CellStyle="{StaticResource MetalSupplierCell}"/>
                            <DataGridTextColumn Header="Ещё нужно, м²" Binding="{Binding RemainingDemand,Converter={StaticResource Area}}" Width="103" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                            <DataGridTextColumn Header="В резерве, м²" Binding="{Binding Reserved,Converter={StaticResource Area}}" Width="100" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                            <DataGridTextColumn Header="Можно выдать, м²" Binding="{Binding Available,Converter={StaticResource Area}}" Width="112" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource MetalStockHeader}" CellStyle="{StaticResource MetalOwnedCell}"/>
                            <DataGridTextColumn Header="Излишек, м²" Binding="{Binding Surplus,Converter={StaticResource Area}}" Width="95" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                            <DataGridTextColumn Header="Дефицит, м²" Binding="{Binding Deficit,Converter={StaticResource Area}}" Width="94" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource MetalStockHeader}" CellStyle="{StaticResource MetalDeficitCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="DetailTitle" Grid.Row="3" Text="Выберите материал" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,9,0,6"/>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TabControl Grid.Column="0" Style="{StaticResource PythonTabbedPane}" Margin="0,0,8,0">
                            <TabItem Header="Наличие">
                        <DataGrid local:TableColumnMenu.Key="metal-places" x:Name="PlaceGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Место хранения" Binding="{Binding Place}" Width="*" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                                <DataGridTextColumn local:TableColumnMenu.FitDisplayPath="Pieces" Header="Бухты, шт." Binding="{Binding Pieces}" Width="95" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                                <DataGridTextColumn Header="Площадь, м²" Binding="{Binding Area,Converter={StaticResource Area}}" Width="110" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                            </TabItem>
                            <TabItem Header="По объектам, м²">
                        <DataGrid local:TableColumnMenu.Key="metal-material-objects" x:Name="MaterialObjectsGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Объект" Binding="{Binding ObjectName}" Width="*" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                                <DataGridTextColumn Header="Потребность" Binding="{Binding Demand,Converter={StaticResource Area}}" Width="95" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                                <DataGridTextColumn Header="Резерв" Binding="{Binding Reserved,Converter={StaticResource Area}}" Width="70" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                                <DataGridTextColumn Header="Выдано" Binding="{Binding Issued,Converter={StaticResource Area}}" Width="70" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                                <DataGridTextColumn Header="Осталось" Binding="{Binding Remaining,Converter={StaticResource Area}}" Width="80" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                            </TabItem>
                        </TabControl>
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel MinWidth="150">
                            <TextBlock Text="Быстрые действия" FontWeight="SemiBold" Margin="0,0,0,7"/>
                            <Button Style="{StaticResource PythonToolbarButton}" Content="Приход металла" Tag="Приход" Click="QuickOperation_Click" Margin="0,0,0,6"/>
                            <Button Style="{StaticResource PythonToolbarButton}" Content="Резерв под объект" Tag="Резерв" Click="QuickOperation_Click" Margin="0,0,0,6"/>
                            <Button Style="{StaticResource PythonToolbarButton}" Content="Выдача на объект" Tag="Выдача" Click="QuickOperation_Click" Margin="0,0,0,6"/>
                            <Button Style="{StaticResource PythonToolbarButton}" Content="Перемещение" Tag="Перемещение" Click="QuickOperation_Click"/>
                        </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="По объектам">
                <DataGrid local:TableColumnMenu.Key="metal-objects" local:TableColumnMenu.Protect="Материал" x:Name="ObjectsGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Объект" Binding="{Binding ObjectName}" Width="*" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                        <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="120" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                        <DataGridTextColumn Header="Материал" Binding="{Binding Material}" Width="180" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                        <DataGridTextColumn Header="Потребность, м²" Binding="{Binding Demand,Converter={StaticResource Area}}" Width="120" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                        <DataGridTextColumn Header="Резерв, м²" Binding="{Binding Reserved,Converter={StaticResource Area}}" Width="110" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                        <DataGridTextColumn Header="Выдано, м²" Binding="{Binding Issued,Converter={StaticResource Area}}" Width="110" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                        <DataGridTextColumn Header="Осталось, м²" Binding="{Binding Remaining,Converter={StaticResource Area}}" Width="110" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem x:Name="JournalTab" Header="Операции">
                <DockPanel Margin="9">
                    <WrapPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,7">
                        <Grid Width="330">
                            <TextBox x:Name="HistorySearch" Style="{StaticResource PythonSearch}" Background="White"
                                     BorderBrush="#D0D7E2" Padding="32,5,10,5" VerticalContentAlignment="Center"
                                     AutomationProperties.Name="Поиск операций склада"
                                     ToolTip="Поиск материала, объекта, операции или счёта"/>
                            <Viewbox Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphSearch}" Stroke="#64748B"/></Canvas></Viewbox>
                            <TextBlock Text="Поиск материала, объекта, операции или счёта" Foreground="{StaticResource UiMutedTextBrush}" Margin="32,0,10,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style><Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=HistorySearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button Style="{StaticResource PythonToolbarButton}" Content="Найти" ContentTemplate="{StaticResource IconLabelSearch}" x:Name="JournalSearchButton" IsEnabled="False" Click="JournalSearch_Click" Margin="8,0,0,0" Padding="12,5"/>
                        <Button Style="{StaticResource PythonToolbarButton}" Content="Назад" ContentTemplate="{StaticResource IconLabelArrowBack}" ToolTip="Назад" x:Name="JournalPreviousButton" IsEnabled="False" Click="JournalPrevious_Click" Margin="16,0,7,0" Padding="12,5"/>
                        <Button Style="{StaticResource PythonToolbarButton}" Content="Далее" ContentTemplate="{StaticResource IconLabelArrowForward}" ToolTip="Далее" x:Name="JournalNextButton" IsEnabled="False" Click="JournalNext_Click" Padding="12,5"/>
                        <TextBlock x:Name="JournalPage" VerticalAlignment="Center" Margin="15,0,0,0"/>
                    </WrapPanel>
                    <DataGrid local:TableColumnMenu.Key="metal-journal" x:Name="JournalGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn local:TableColumnMenu.FitDisplayPath="CreatedUtc" Header="Дата" Binding="{Binding CreatedUtc,StringFormat=dd.MM.yyyy HH:mm}" Width="128" ElementStyle="{StaticResource CompactCostCenter}" HeaderStyle="{StaticResource KsQuantityHeader}"/>
                            <DataGridTextColumn Header="Операция" Binding="{Binding Kind}" Width="120" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                            <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="90" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                            <DataGridTextColumn Header="Материал" Binding="{Binding Material}" Width="90" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                            <DataGridTextColumn Header="м²" Binding="{Binding Area,Converter={StaticResource Area}}" Width="75" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                            <DataGridTextColumn local:TableColumnMenu.FitDisplayPath="Pieces" Header="шт." Binding="{Binding Pieces}" Width="55" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                            <DataGridTextColumn Header="Откуда" Binding="{Binding Source}" Width="115" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                            <DataGridTextColumn Header="Куда" Binding="{Binding Destination}" Width="115" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                            <DataGridTextColumn Header="Объект" Binding="{Binding ObjectName}" Width="135" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                            <DataGridTextColumn Header="Сотрудник" Binding="{Binding User}" Width="105" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                            <DataGridTextColumn Header="Поставщик" Binding="{Binding Supplier}" Width="105" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                            <DataGridTextColumn Header="Счёт" Binding="{Binding Invoice}" Width="95" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                            <DataGridTextColumn Header="Примечание" Binding="{Binding Note}" Width="*" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Закупки и хранение">
                <DockPanel Margin="9">
                    <WrapPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button Style="{StaticResource PythonToolbarButton}" Content="Добавить партию…" Click="LotAdd_Click" Padding="12,6" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource PythonToolbarButton}" Content="Отметить оплату" Click="LotPay_Click" Padding="12,6" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource PythonToolbarButton}" Content="Забрать с хранения…" Click="LotReceive_Click" Padding="12,6"/>
                    </WrapPanel>
                    <DataGrid local:TableColumnMenu.Key="metal-lots" x:Name="LotsGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Поставщик" Binding="{Binding Supplier}" Width="180" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                            <DataGridTextColumn Header="Счёт" Binding="{Binding Invoice}" Width="130" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                            <DataGridTextColumn Header="Материал" Binding="{Binding Material}" Width="*" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                            <DataGridTextColumn Header="Площадь, м²" Binding="{Binding Ordered,Converter={StaticResource Area}}" Width="110" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                            <DataGridTextColumn local:TableColumnMenu.FitDisplayPath="OrderedPieces" Header="Заказано, шт." Binding="{Binding OrderedPieces}" Width="100" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                            <DataGridTextColumn Header="Оплачено" Binding="{Binding Paid, Converter={StaticResource MetalPaidText}}" Width="110"
                                                ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                            <DataGridTextColumn Header="Получено, м²" Binding="{Binding Received,Converter={StaticResource Area}}" Width="107" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                            <DataGridTextColumn local:TableColumnMenu.FitDisplayPath="ReceivedPieces" Header="Получено, шт." Binding="{Binding ReceivedPieces}" Width="95" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                            <DataGridTextColumn Header="На хранении, м²" Binding="{Binding AtSupplier,Converter={StaticResource Area}}" Width="125" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                            <DataGridTextColumn local:TableColumnMenu.FitDisplayPath="PiecesAtSupplier" Header="На хранении, шт." Binding="{Binding PiecesAtSupplier}" Width="115" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>