<Window x:Class="GmcSmeta.App.MetalWarehouseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GmcSmeta.App"
        Title="Склад металла" Width="1370" Height="810" MinWidth="970" MinHeight="610"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA"
        FontFamily="{StaticResource UiFontFamily}" FontSize="{StaticResource UiBodySize}" Foreground="#0F172A" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <local:MetalAreaConverter xmlns:local="clr-namespace:GmcSmeta.App" x:Key="Area" />
        <Style TargetType="DataGrid" BasedOn="{StaticResource DocumentTable}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="MinRowHeight" Value="24"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E4E8EF"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E4E8EF"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
        </Style>
        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource PythonTile}">
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top">
            <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Style="{StaticResource PrimaryButton}" Content="Провести операцию…" ContentTemplate="{StaticResource IconLabelPlus}" Click="Operation_Click" Padding="13,7" Margin="0,0,8,0"/>
                <Button x:Name="OpeningButton" Content="Перенести остатки из Excel…" ContentTemplate="{StaticResource IconLabelUpload}" Click="Import_Click" Padding="12,7" Margin="0,0,8,0"/>
                <Button Content="Учёт металла (Excel)…" ContentTemplate="{StaticResource IconLabelList}" Click="Register_Click" Padding="12,7" Margin="0,0,8,0"/>
                <Button Content="Отчёт Excel…" ContentTemplate="{StaticResource IconLabelDownload}" Click="Export_Click" Padding="12,7" Margin="0,0,8,0"/>
                <Button Content="Обновить" ContentTemplate="{StaticResource IconLabelRefresh}" Click="Refresh_Click" Padding="12,7"/>
            </WrapPanel>
            <TextBlock x:Name="StatusText" Text="Загрузка…" Foreground="#64748B" Margin="1,1,0,8"/>
        </StackPanel>
        <TabControl x:Name="Tabs" Style="{StaticResource PythonTabbedPane}">
            <TabItem Header="Остатки">
                <Grid Margin="9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <UniformGrid Grid.Row="0" Columns="5" Margin="0,0,0,10">
                        <Border Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="Всего в собственности" Foreground="#64748B"/>
                                <TextBlock x:Name="TotalOwned" Style="{StaticResource PythonTileValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="Физически у нас" Foreground="#64748B"/>
                                <TextBlock x:Name="TotalOurs" Style="{StaticResource PythonTileValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="У поставщиков" Foreground="#64748B"/>
                                <TextBlock x:Name="TotalSupplier" Style="{StaticResource PythonTileValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="Осталось обеспечить" Foreground="#64748B"/>
                                <TextBlock x:Name="TotalNeed" Style="{StaticResource PythonTileValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="Дефицит" Foreground="#A21C26"/>
                                <TextBlock x:Name="TotalDeficit" Style="{StaticResource PythonTileValue}" Foreground="#A21C26"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,6">
                        <TextBlock Text="Категория:" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <ComboBox x:Name="StockCategory" Width="205" SelectedIndex="0" SelectionChanged="StockFilter_Changed" Margin="0,0,14,0">
                            <ComboBoxItem Content="Металл в бухтах" Tag="Бухты"/>
                            <ComboBoxItem Content="Штрипсы" Tag="Штрипсы"/>
                            <ComboBoxItem Content="Листовой металл" Tag="Листы"/>
                            <ComboBoxItem Content="Все материалы" Tag=""/>
                        </ComboBox>
                        <TextBox x:Name="StockSearch" Width="270" Padding="6,4" ToolTip="Поиск материала или толщины" TextChanged="StockFilter_Changed"/>
                    </StackPanel>
                    <DataGrid local:TableColumnMenu.Key="metal-stock" local:TableColumnMenu.Protect="Материал" x:Name="StockGrid" Grid.Row="2" SelectionChanged="StockGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="95" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                            <DataGridTextColumn Header="Материал" Binding="{Binding Material}" Width="*" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                            <DataGridTextColumn Header="У нас, м²" Binding="{Binding Ours,Converter={StaticResource Area}}" Width="105" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                            <DataGridTextColumn Header="У нас, шт." Binding="{Binding OursPieces}" Width="84" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                            <DataGridTextColumn Header="У поставщиков, м²" Binding="{Binding Supplier,Converter={StaticResource Area}}" Width="118" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                            <DataGridTextColumn Header="У поставщиков, шт." Binding="{Binding SupplierPieces}" Width="106" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                            <DataGridTextColumn Header="Ещё нужно, м²" Binding="{Binding RemainingDemand,Converter={StaticResource Area}}" Width="103" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                            <DataGridTextColumn Header="В резерве, м²" Binding="{Binding Reserved,Converter={StaticResource Area}}" Width="100" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                            <DataGridTextColumn Header="Можно выдать, м²" Binding="{Binding Available,Converter={StaticResource Area}}" Width="112" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                            <DataGridTextColumn Header="Излишек, м²" Binding="{Binding Surplus,Converter={StaticResource Area}}" Width="95" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                            <DataGridTextColumn Header="Дефицит, м²" Binding="{Binding Deficit,Converter={StaticResource Area}}" Width="94" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="DetailTitle" Grid.Row="3" Text="Выберите материал" FontWeight="SemiBold" Margin="0,9,0,6"/>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid local:TableColumnMenu.Key="metal-places" x:Name="PlaceGrid" Grid.Column="0" Margin="0,0,8,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Место хранения" Binding="{Binding Place}" Width="*" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                                <DataGridTextColumn Header="Бухты, шт." Binding="{Binding Pieces}" Width="95" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                                <DataGridTextColumn Header="Площадь, м²" Binding="{Binding Area,Converter={StaticResource Area}}" Width="110" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid local:TableColumnMenu.Key="metal-material-objects" x:Name="MaterialObjectsGrid" Grid.Column="1" Margin="0,0,8,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Объект" Binding="{Binding ObjectName}" Width="*" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                                <DataGridTextColumn Header="Потребность" Binding="{Binding Demand,Converter={StaticResource Area}}" Width="95" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                                <DataGridTextColumn Header="Резерв" Binding="{Binding Reserved,Converter={StaticResource Area}}" Width="70" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                                <DataGridTextColumn Header="Выдано" Binding="{Binding Issued,Converter={StaticResource Area}}" Width="70" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                                <DataGridTextColumn Header="Осталось" Binding="{Binding Remaining,Converter={StaticResource Area}}" Width="80" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Быстрые действия" FontWeight="SemiBold" Margin="0,0,0,7"/>
                            <Button Content="Приход металла" Tag="Приход" Click="QuickOperation_Click" Margin="0,0,0,6"/>
                            <Button Content="Резерв под объект" Tag="Резерв" Click="QuickOperation_Click" Margin="0,0,0,6"/>
                            <Button Content="Выдача на объект" Tag="Выдача" Click="QuickOperation_Click" Margin="0,0,0,6"/>
                            <Button Content="Перемещение" Tag="Перемещение" Click="QuickOperation_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="По объектам">
                <DataGrid local:TableColumnMenu.Key="metal-objects" local:TableColumnMenu.Protect="Материал" x:Name="ObjectsGrid" Margin="9">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Объект" Binding="{Binding ObjectName}" Width="*" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                        <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="120" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                        <DataGridTextColumn Header="Материал" Binding="{Binding Material}" Width="180" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                        <DataGridTextColumn Header="Потребность, м²" Binding="{Binding Demand,Converter={StaticResource Area}}" Width="120" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                        <DataGridTextColumn Header="Резерв, м²" Binding="{Binding Reserved,Converter={StaticResource Area}}" Width="110" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                        <DataGridTextColumn Header="Выдано, м²" Binding="{Binding Issued,Converter={StaticResource Area}}" Width="110" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                        <DataGridTextColumn Header="Осталось, м²" Binding="{Binding Remaining,Converter={StaticResource Area}}" Width="110" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Операции">
                <DockPanel Margin="9">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,7">
                        <TextBox x:Name="HistorySearch" Width="330" Padding="6,4" ToolTip="Поиск материала, объекта, операции или счёта"/>
                        <Button Content="Найти" ContentTemplate="{StaticResource IconLabelSearch}" Click="JournalSearch_Click" Margin="8,0,0,0" Padding="12,5"/>
                        <Button Content="Назад" ContentTemplate="{StaticResource IconLabelArrowBack}" ToolTip="Назад" Click="JournalPrevious_Click" Margin="16,0,7,0" Padding="12,5"/>
                        <Button Content="Далее" ContentTemplate="{StaticResource IconLabelArrowForward}" ToolTip="Далее" Click="JournalNext_Click" Padding="12,5"/>
                        <TextBlock x:Name="JournalPage" VerticalAlignment="Center" Margin="15,0,0,0"/>
                    </StackPanel>
                    <DataGrid local:TableColumnMenu.Key="metal-journal" x:Name="JournalGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding CreatedUtc,StringFormat=dd.MM.yyyy HH:mm}" Width="128" ElementStyle="{StaticResource CompactCostCenter}" HeaderStyle="{StaticResource KsQuantityHeader}"/>
                            <DataGridTextColumn Header="Операция" Binding="{Binding Kind}" Width="120" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                            <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="90" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                            <DataGridTextColumn Header="Материал" Binding="{Binding Material}" Width="90" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                            <DataGridTextColumn Header="м²" Binding="{Binding Area,Converter={StaticResource Area}}" Width="75" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                            <DataGridTextColumn Header="шт." Binding="{Binding Pieces}" Width="55" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                            <DataGridTextColumn Header="Откуда" Binding="{Binding Source}" Width="115" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                            <DataGridTextColumn Header="Куда" Binding="{Binding Destination}" Width="115" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                            <DataGridTextColumn Header="Объект" Binding="{Binding ObjectName}" Width="135" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                            <DataGridTextColumn Header="Сотрудник" Binding="{Binding User}" Width="105" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                            <DataGridTextColumn Header="Поставщик" Binding="{Binding Supplier}" Width="105" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                            <DataGridTextColumn Header="Счёт" Binding="{Binding Invoice}" Width="95" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                            <DataGridTextColumn Header="Примечание" Binding="{Binding Note}" Width="*" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Закупки и хранение">
                <DockPanel Margin="9">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button Content="Добавить партию…" ContentTemplate="{StaticResource IconLabelPlus}" Click="LotAdd_Click" Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="Отметить оплату" ContentTemplate="{StaticResource IconLabelCheck}" Click="LotPay_Click" Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="Забрать с хранения…" ContentTemplate="{StaticResource IconLabelDownload}" Click="LotReceive_Click" Padding="12,6"/>
                    </StackPanel>
                    <DataGrid local:TableColumnMenu.Key="metal-lots" x:Name="LotsGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Поставщик" Binding="{Binding Supplier}" Width="180" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                            <DataGridTextColumn Header="Счёт" Binding="{Binding Invoice}" Width="130" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                            <DataGridTextColumn Header="Материал" Binding="{Binding Material}" Width="*" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                            <DataGridTextColumn Header="Площадь, м²" Binding="{Binding Ordered,Converter={StaticResource Area}}" Width="110" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                            <DataGridTextColumn Header="Заказано, шт." Binding="{Binding OrderedPieces}" Width="100" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                            <DataGridCheckBoxColumn Header="Оплачено" Binding="{Binding Paid}" Width="90"/>
                            <DataGridTextColumn Header="Получено, м²" Binding="{Binding Received,Converter={StaticResource Area}}" Width="107" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                            <DataGridTextColumn Header="Получено, шт." Binding="{Binding ReceivedPieces}" Width="95" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                            <DataGridTextColumn Header="На хранении, м²" Binding="{Binding AtSupplier,Converter={StaticResource Area}}" Width="125" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                            <DataGridTextColumn Header="На хранении, шт." Binding="{Binding PiecesAtSupplier}" Width="115" ElementStyle="{StaticResource CompactCostMoney}" HeaderStyle="{StaticResource KsMoneyHeader}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>