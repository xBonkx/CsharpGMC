<Window x:Class="GmcSmeta.App.ContractDialog" UseLayoutRounding="True" SnapsToDevicePixels="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Документ" Width="620" MinWidth="540" SizeToContent="Height" ResizeMode="CanResize"
        MaxHeight="{Binding Height, Source={x:Static SystemParameters.WorkArea}}"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFontFamily}" FontSize="{StaticResource UiBodySize}"
        Foreground="#0F172A" TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="{StaticResource LayoutFormDialogMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="CaptionText" FontSize="{StaticResource UiH2Size}" FontWeight="SemiBold" Text="Документ" TextWrapping="Wrap"/>
            <TextBlock x:Name="ObjectText" Foreground="#64748B" Margin="0,3,0,0" TextWrapping="Wrap"/>
            <StackPanel x:Name="LegalAgreementPanel" Visibility="Collapsed" Margin="0,8,0,0">
                <TextBlock Text="Юридический договор" TextWrapping="Wrap"/>
                <ComboBox x:Name="LegalAgreementCombo" DisplayMemberPath="Caption" SelectedValuePath="Id" MinHeight="32"/>
                <TextBlock Text="Номер приложения (если есть)" Margin="0,6,0,0"/><TextBox x:Name="LegalAnnexNumberBox" MaxLength="200" MinHeight="{StaticResource LayoutFieldMinHeight}"/>
            </StackPanel>
            <Button x:Name="AgreementDefaultsButton" Content="Подставить реквизиты договора" Visibility="Collapsed"
                    Style="{StaticResource PythonToolbarButton}" HorizontalAlignment="Left" Margin="0,6,0,0"
                    ContentTemplate="{StaticResource IconLabelCopy}" Click="AgreementDefaults_Click" ToolTip="Заполнить номер, дату и организацию из совпадающих реквизитов приложений."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="138"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Тип" Margin="{StaticResource LayoutFormLabelMargin}" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center"/>
            <ComboBox x:Name="KindCombo" Grid.Row="0" Grid.Column="1" Margin="{StaticResource LayoutFormFieldMargin}"
                      SelectionChanged="Kind_SelectionChanged"/>

            <TextBlock x:Name="NumberLabel" Grid.Row="1" Grid.Column="0" Text="Номер" Margin="{StaticResource LayoutFormLabelMargin}" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center"/>
            <TextBox x:Name="NumberBox" Grid.Row="1" Grid.Column="1" Margin="{StaticResource LayoutFormFieldMargin}"/>

            <TextBlock x:Name="DateLabel" Grid.Row="2" Grid.Column="0" Text="Дата" Margin="{StaticResource LayoutFormLabelMargin}" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center"/>
            <TextBox x:Name="DateBox" Grid.Row="2" Grid.Column="1" Margin="{StaticResource LayoutFormFieldMargin}" ToolTip="дд.мм.гггг"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Название" Margin="{StaticResource LayoutFormLabelMargin}" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center"/>
            <TextBox x:Name="NameBox" Grid.Row="3" Grid.Column="1" Margin="{StaticResource LayoutFormFieldMargin}"
                     ToolTip="например: вариант 2, парковка, раздел 1"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Организация" Margin="{StaticResource LayoutFormLabelMargin}" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center"/>
            <ComboBox x:Name="CompanyCombo" Grid.Row="4" Grid.Column="1" Margin="0"
                      SelectionChanged="Company_SelectionChanged"/>

            <TextBlock x:Name="VatHint" Grid.Row="5" Grid.Column="1" Foreground="#64748B"
                       FontSize="{StaticResource UiCaptionSize}" Margin="0,3,0,9" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="К приложению / КП" Margin="{StaticResource LayoutFormLabelMargin}" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center"/>
            <ComboBox x:Name="BaseCombo" Grid.Row="6" Grid.Column="1" Margin="{StaticResource LayoutFormFieldMargin}"/>

            <TextBlock Grid.Row="7" Grid.Column="0" x:Name="VatLabel" Text="НДС (внутри цен)" Margin="{StaticResource LayoutFormLabelMargin}" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center"/>
            <TextBox x:Name="VatBox" Grid.Row="7" Grid.Column="1" Margin="{StaticResource LayoutFormFieldMargin}" Width="100"
                     HorizontalAlignment="Left"/>

            <TextBlock Grid.Row="8" Grid.Column="0" x:Name="TagLabel" Text="Тег заказчика" Margin="{StaticResource LayoutFormLabelMargin}" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center"/>
            <ComboBox x:Name="TagCombo" Grid.Row="8" Grid.Column="1" Margin="{StaticResource LayoutFormFieldMargin}"/>

            <TextBlock Grid.Row="9" Grid.Column="0" x:Name="NoteLabel" Text="Примечание" Margin="{StaticResource LayoutFormLabelMargin}" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center"/>
            <TextBox x:Name="NoteBox" Grid.Row="9" Grid.Column="1" Margin="{StaticResource LayoutFormFieldMargin}" Height="58"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

            <StackPanel x:Name="ContentPanel" Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2"
                        Margin="0,4,0,8">
                <TextBlock Text="Содержимое" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <RadioButton x:Name="EmptyRadio" Content="Пустое — начну с нуля" IsChecked="True"
                             GroupName="Content" Checked="Content_Changed"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <RadioButton x:Name="CopyRadio" Content="Копия документа:" GroupName="Content"
                                 VerticalAlignment="Center" Checked="Content_Changed"/>
                    <ComboBox x:Name="SourceCombo" Grid.Column="1" Margin="8,0,0,0" MinWidth="0"/>
                </Grid>
            </StackPanel>

            <TextBlock x:Name="TagNote" Grid.Row="11" Grid.Column="1" Foreground="#64748B" FontSize="{StaticResource UiCaptionSize}"
                       TextWrapping="Wrap" Margin="0,0,0,4"
                       Text="Тег — правила заказчика: НДС сверху, нумерация, форма КС."/>
        </Grid>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="False">
            <Button x:Name="ImportExcelButton" DockPanel.Dock="Left" Content="Из Excel…"
                    Style="{StaticResource PythonToolbarButton}" MinWidth="110" Visibility="Collapsed"
                    ContentTemplate="{StaticResource IconLabelExcel}" Click="ImportExcel_Click"
                    ToolTip="Открыть импорт нового КП из файла Excel. Реквизиты указываются в окне импорта."/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Style="{StaticResource PythonToolbarButton}" Content="Отмена" IsCancel="True" MinWidth="90" Margin="0,0,8,0"/>
            <Button x:Name="OkButton" Content="Сохранить" IsDefault="True" MinWidth="110"
                    Click="Ok_Click" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
