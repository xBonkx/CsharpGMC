<Window x:Class="GmcSmeta.App.ContractDialog" UseLayoutRounding="True" SnapsToDevicePixels="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Документ" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFontFamily}" FontSize="{StaticResource UiBodySize}"
        Foreground="#0F172A" TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="CaptionText" FontSize="{StaticResource UiH2Size}" FontWeight="SemiBold" Text="Документ" TextWrapping="Wrap"/>
            <TextBlock x:Name="ObjectText" Foreground="#64748B" Margin="0,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="138"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Тип" Margin="0,4,12,10"/>
            <ComboBox x:Name="KindCombo" Grid.Row="0" Grid.Column="1" Margin="0,2,0,8"
                      SelectionChanged="Kind_SelectionChanged"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Номер" Margin="0,4,12,10"/>
            <TextBox x:Name="NumberBox" Grid.Row="1" Grid.Column="1" Margin="0,2,0,8"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Дата" Margin="0,4,12,10"/>
            <TextBox x:Name="DateBox" Grid.Row="2" Grid.Column="1" Margin="0,2,0,8" ToolTip="дд.мм.гггг"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Название" Margin="0,4,12,10"/>
            <TextBox x:Name="NameBox" Grid.Row="3" Grid.Column="1" Margin="0,2,0,8"
                     ToolTip="например: вариант 2, парковка, раздел 1"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Организация" Margin="0,4,12,10"/>
            <ComboBox x:Name="CompanyCombo" Grid.Row="4" Grid.Column="1" Margin="0,2,0,0"
                      SelectionChanged="Company_SelectionChanged"/>

            <TextBlock x:Name="VatHint" Grid.Row="5" Grid.Column="1" Foreground="#64748B"
                       FontSize="{StaticResource UiCaptionSize}" Margin="0,3,0,8" TextWrapping="Wrap"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="К договору" Margin="0,4,12,10"/>
            <ComboBox x:Name="BaseCombo" Grid.Row="6" Grid.Column="1" Margin="0,2,0,8"/>

            <TextBlock Grid.Row="7" Grid.Column="0" x:Name="VatLabel" Text="НДС (внутри цен)" Margin="0,4,12,10"/>
            <TextBox x:Name="VatBox" Grid.Row="7" Grid.Column="1" Margin="0,2,0,8" Width="100"
                     HorizontalAlignment="Left"/>

            <TextBlock Grid.Row="8" Grid.Column="0" x:Name="TagLabel" Text="Тег заказчика" Margin="0,4,12,10"/>
            <ComboBox x:Name="TagCombo" Grid.Row="8" Grid.Column="1" Margin="0,2,0,8"/>

            <TextBlock Grid.Row="9" Grid.Column="0" x:Name="NoteLabel" Text="Примечание" Margin="0,4,12,10"/>
            <TextBox x:Name="NoteBox" Grid.Row="9" Grid.Column="1" Margin="0,2,0,8" Height="58"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

            <StackPanel x:Name="ContentPanel" Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2"
                        Margin="0,4,0,8">
                <TextBlock Text="Содержимое" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <RadioButton x:Name="EmptyRadio" Content="Пустое — начну с нуля" IsChecked="True"
                             GroupName="Content" Checked="Content_Changed"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <RadioButton x:Name="CopyRadio" Content="Копия документа:" GroupName="Content"
                                 VerticalAlignment="Center" Checked="Content_Changed"/>
                    <ComboBox x:Name="SourceCombo" Margin="8,0,0,0" MinWidth="320"/>
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="TagNote" Grid.Row="11" Grid.Column="1" Foreground="#64748B" FontSize="{StaticResource UiCaptionSize}"
                       TextWrapping="Wrap" Margin="0,0,0,4"
                       Text="Тег — правила заказчика: НДС сверху, нумерация, форма КС."/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Style="{StaticResource PythonToolbarButton}" Content="Отмена" IsCancel="True" MinWidth="90" Margin="0,0,8,0"/>
            <Button x:Name="OkButton" Content="Сохранить" IsDefault="True" MinWidth="110"
                    Click="Ok_Click" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
