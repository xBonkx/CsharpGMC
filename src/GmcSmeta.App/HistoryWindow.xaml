<Window x:Class="GmcSmeta.App.HistoryWindow" UseLayoutRounding="True" SnapsToDevicePixels="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GmcSmeta.App"
        Title="Журнал изменений" Width="1150" Height="640" MinWidth="900" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA"
        PreviewKeyDown="HistoryWindow_PreviewKeyDown"
        FontFamily="{StaticResource UiFontFamily}" FontSize="{StaticResource UiBodySize}"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" Foreground="#0F172A">
    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Text="Журнал изменений" TextWrapping="Wrap" FontWeight="SemiBold"
                   FontSize="{StaticResource UiH2Size}" Foreground="#0F172A"/>

        <DockPanel Grid.Row="1" Margin="0,10,0,0">
            <Grid DockPanel.Dock="Right" Width="300" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Style="{StaticResource PythonSearch}"
                         Background="#FFFFFF" BorderBrush="#D0D7E2" Padding="32,5,32,5"
                         VerticalContentAlignment="Center"
                         ToolTip="Ctrl+F — поиск. Кто, что, действие, название строки. Несколько слов — все должны совпасть."
                         AutomationProperties.Name="Поиск по журналу изменений"
                         TextChanged="SearchBox_TextChanged"/>
                <Viewbox Width="18" Height="18" Margin="8,0,0,0" HorizontalAlignment="Left"
                         VerticalAlignment="Center" IsHitTestVisible="False">
                    <Canvas Width="24" Height="24">
                        <Path Style="{StaticResource SvgGlyphPath}" Data="{StaticResource GlyphSearch}" Stroke="#64748B"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="Найти: кто, что, название строки…" Foreground="#94A3B8"
                           Margin="32,0,32,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Content="Очистить" ContentTemplate="{StaticResource IconOnlyX}"
                        Click="ClearSearch_Click" Width="26" Height="26" Padding="0"
                        Margin="0,0,3,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                        ToolTip="Очистить поиск" AutomationProperties.Name="Очистить поиск">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PythonToolbarButton}">
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
            <TextBlock x:Name="SubtitleText" Foreground="#64748B" TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <DataGrid local:TableColumnMenu.Key="history" x:Name="HistoryGrid" Grid.Row="2" Margin="0,10,0,0"
                 
                 
                  MinRowHeight="27" AlternationCount="0" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  HorizontalGridLinesBrush="#E4E8EF" Background="#FFFFFF" BorderBrush="#E4E8EF"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  CanUserDeleteRows="False" CanUserReorderColumns="False" SelectionMode="Single"
                  SelectionUnit="FullRow" RowHeaderWidth="0" GridLinesVisibility="All"
                  HeadersVisibility="Column" VirtualizingPanel.VirtualizationMode="Recycling" Style="{StaticResource DocumentTable}" CanUserResizeRows="False">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource PythonTableRow}">
                    <Setter Property="Background" Value="{Binding RowBrush}"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Когда" Binding="{Binding When}" Width="125" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsQuantityHeader}"/>
                <DataGridTextColumn Header="Кто" Binding="{Binding Who}" Width="110" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                <DataGridTextColumn Header="Что" Binding="{Binding What}" Width="100" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                <DataGridTextColumn Header="Действие" Binding="{Binding Action}" Width="150" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                <DataGridTextColumn Header="Подробности" Binding="{Binding Details}" Width="*" MinWidth="180" HeaderStyle="{StaticResource KsTextHeader}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CompactCostText}">
                            <Setter Property="ToolTip" Value="{Binding Details}"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="EmptyText" Grid.Row="3" Foreground="#64748B" Margin="0,10,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed"
                   Text="Пока изменений нет. Всё, что поменяют в документе, появится здесь."/>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Зелёным — создано, красным — удалено, жёлтым — отмена."
                       Foreground="#64748B" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Style="{StaticResource PythonToolbarButton}" Content="Закрыть"
                    IsCancel="True" Padding="12,4"/>
        </Grid>
    </Grid>
</Window>
