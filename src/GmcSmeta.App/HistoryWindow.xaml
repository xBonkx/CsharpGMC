<Window x:Class="GmcSmeta.App.HistoryWindow" UseLayoutRounding="True" SnapsToDevicePixels="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GmcSmeta.App"
        Title="Журнал изменений" Width="1150" Height="640" MinWidth="900" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA"
        PreviewKeyDown="HistoryWindow_PreviewKeyDown"
        FontFamily="{StaticResource UiFontFamily}" FontSize="{StaticResource UiBodySize}"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" Foreground="#0F172A">
    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Text="Журнал изменений" FontWeight="SemiBold"
                   FontSize="{StaticResource UiH2Size}" Foreground="#0F172A"/>

        <DockPanel Grid.Row="1" Margin="0,6,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="14,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock Text="Найти:" Foreground="#64748B" VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBox x:Name="SearchBox" Width="300" Padding="8,4"
                         ToolTip="Ctrl+F — поиск. Кто, что, действие, название строки. Несколько слов — все должны совпасть."
                         TextChanged="SearchBox_TextChanged"/>
            </StackPanel>
            <TextBlock x:Name="SubtitleText" Foreground="#64748B" TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <DataGrid local:TableColumnMenu.Key="history" x:Name="HistoryGrid" Grid.Row="2" Margin="0,10,0,0"
                 
                 
                  MinRowHeight="24" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  HorizontalGridLinesBrush="#E4E8EF" Background="#FFFFFF" BorderBrush="#E4E8EF"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  CanUserDeleteRows="False" CanUserReorderColumns="False" SelectionMode="Single"
                  SelectionUnit="FullRow" RowHeaderWidth="0" GridLinesVisibility="All"
                  HeadersVisibility="Column" VirtualizingPanel.VirtualizationMode="Recycling" Style="{StaticResource DocumentTable}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource PythonTableRow}">
                    <Setter Property="Background" Value="{Binding RowBrush}"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Когда" Binding="{Binding When}" Width="125" ElementStyle="{StaticResource CompactCostCenter}" HeaderStyle="{StaticResource KsQuantityHeader}"/>
                <DataGridTextColumn Header="Кто" Binding="{Binding Who}" Width="110" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                <DataGridTextColumn Header="Что" Binding="{Binding What}" Width="100" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                <DataGridTextColumn Header="Действие" Binding="{Binding Action}" Width="150" ElementStyle="{StaticResource CompactCostText}" HeaderStyle="{StaticResource KsTextHeader}"/>
                <DataGridTextColumn Header="Подробности" Binding="{Binding Details}" Width="*" HeaderStyle="{StaticResource KsTextHeader}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CompactCostText}">
                            <Setter Property="ToolTip" Value="{Binding Details}"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="EmptyText" Grid.Row="3" Foreground="#64748B" Margin="0,8,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed"
                   Text="Пока изменений нет. Всё, что поменяют в документе, появится здесь."/>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Зелёным — создано, красным — удалено, жёлтым — отмена."
                       Foreground="#64748B" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Style="{StaticResource PythonToolbarButton}" Content="Закрыть"
                    IsCancel="True" Padding="12,4"/>
        </Grid>
    </Grid>
</Window>
