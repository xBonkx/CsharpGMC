<Window x:Class="GmcSmeta.App.StagesDialog" UseLayoutRounding="True" SnapsToDevicePixels="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Этапы" Width="1180" Height="690" MinWidth="900" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA"
        FontFamily="{StaticResource UiFontFamily}" FontSize="{StaticResource UiBodySize}"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}">
    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="CaptionText" FontWeight="SemiBold" FontSize="{StaticResource UiH2Size}" TextWrapping="Wrap"/>
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Style="{StaticResource PythonSearch}" TextChanged="Search_Changed" ToolTip="Поиск по названию или разделу"/>
            <Button x:Name="AddStageButton" Grid.Column="1" Content="Этап" ContentTemplate="{StaticResource IconLabelPlus}" Click="AddStage_Click"
                    Margin="10,0,0,0" FontWeight="SemiBold" Padding="12,4" Style="{StaticResource PrimaryButton}"/>
            <Button Grid.Column="2" Style="{StaticResource PythonToolbarButton}" Content="Остаток" Click="CreateRest_Click" Margin="8,0,0,0"
                    ToolTip="Создать или обновить документ «Остаток»: полное КП − этапы"/>
            <Button Grid.Column="3" Style="{StaticResource PythonToolbarButton}" Content="Закрыть" IsCancel="True" Margin="8,0,0,0" Padding="12,4"/>
        </Grid>
        <DataGrid MinRowHeight="30"
                 
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto" HorizontalGridLinesBrush="#E4E8EF"
                  Background="#FFFFFF" BorderBrush="#E4E8EF" x:Name="StagesGrid" Grid.Row="2" Margin="0,10,0,0"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                  BeginningEdit="StagesGrid_BeginningEdit" CellEditEnding="StagesGrid_CellEditEnding"
                  ContextMenuOpening="StagesGrid_ContextMenuOpening" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.VirtualizationMode="Recycling" Style="{StaticResource DocumentTable}">
            <DataGrid.ContextMenu>
                <ContextMenu x:Name="StageMenu"/>
            </DataGrid.ContextMenu>
        </DataGrid>
        <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="#64748B" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
