<Window x:Class="GmcSmeta.App.SqlConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подключение к SQL Server" Height="640" Width="690"
        MinWidth="560" MinHeight="440" WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#F4F6FA" FontFamily="{StaticResource UiFontFamily}" FontSize="{StaticResource UiBodySize}"
        Foreground="#0F172A" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <DockPanel Margin="22,18,22,18" LastChildFill="True">
        <Border DockPanel.Dock="Bottom" BorderBrush="#E4E8EF" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,10,0,0">
            <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="TestButton" Click="TestButton_Click" Style="{StaticResource PythonToolbarButton}"
                        Content="Проверить подключение" ContentTemplate="{StaticResource IconLabelSearch}" Margin="0,0,8,4"/>
                <Button x:Name="DemoButton" Content="Демо" Click="DemoButton_Click" Style="{StaticResource PythonToolbarButton}" Margin="0,0,8,4"/>
                <Button x:Name="ConnectButton" Content="Сохранить и подключиться" IsDefault="True"
                        Click="ConnectButton_Click" Style="{StaticResource PythonToolbarPrimary}" ContentTemplate="{StaticResource IconLabelCheck}" Margin="0,0,8,4"/>
                <Button Content="Отмена" IsCancel="True" Style="{StaticResource PythonToolbarButton}" Margin="0,0,0,4"/>
            </WrapPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" FontSize="{StaticResource UiH2Size}" FontWeight="SemiBold"
                   Text="Подключение к тестовой базе" Margin="0,0,0,12"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <Button x:Name="DeleteProfileButton" DockPanel.Dock="Right" Content="Удалить" Margin="8,0,0,0"
                    Style="{StaticResource PythonToolbarButton}" ContentTemplate="{StaticResource IconLabelTrash}" Click="DeleteProfile_Click"/>
            <ComboBox x:Name="ProfilePicker" MinHeight="30" DisplayMemberPath="Name"
                      SelectionChanged="ProfilePicker_SelectionChanged"/>
        </DockPanel>
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Название профиля"/>
            <TextBox Grid.Column="1" x:Name="ProfileNameBox" AutomationProperties.Name="Название профиля" MinHeight="30" Padding="6,4"/>
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Сервер или IP"/>
            <TextBox Grid.Column="1" x:Name="ServerBox" AutomationProperties.Name="Сервер или IP" MinHeight="30" Padding="6,4" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="2" Text="Порт" VerticalAlignment="Center"/>
            <TextBox Grid.Column="3" x:Name="PortBox" Text="1433" MinHeight="30" AutomationProperties.Name="Порт SQL Server"/>
        </Grid>
        <Grid Grid.Row="4" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="База данных"/>
            <TextBox Grid.Column="1" x:Name="DatabaseBox" AutomationProperties.Name="База данных" MinHeight="30" Text="GmcSmetaPilot_Laptop" Padding="6,4"/>
        </Grid>
        <Grid Grid.Row="5" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Авторизация"/>
            <ComboBox Grid.Column="1" x:Name="AuthBox" AutomationProperties.Name="Авторизация" MinHeight="30" SelectedIndex="1" Padding="6,3"
                      SelectionChanged="AuthBox_SelectionChanged">
                <ComboBoxItem Content="Windows Authentication"/>
                <ComboBoxItem Content="SQL Server Authentication"/>
            </ComboBox>
        </Grid>
        <Grid Grid.Row="6" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="SQL-логин"/>
            <TextBox Grid.Column="1" x:Name="UserBox" AutomationProperties.Name="SQL-логин" MinHeight="30" Padding="6,4"/>
        </Grid>
        <Grid Grid.Row="7" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Пароль"/>
            <PasswordBox Grid.Column="1" x:Name="PasswordInput" AutomationProperties.Name="Пароль" MinHeight="30" Padding="6,4"/>
        </Grid>
        <StackPanel Grid.Row="8" Margin="150,0,0,8">
            <CheckBox x:Name="RememberBox" Content="Запомнить пароль (Windows DPAPI)"
                      Margin="0,0,0,7"/>
            <CheckBox x:Name="TrustBox" Checked="TrustBox_Changed" Unchecked="TrustBox_Changed">
                <TextBlock Text="Доверять сертификату сервера (только тест)" TextWrapping="Wrap"/>
            </CheckBox>
        </StackPanel>
        <TextBlock Grid.Row="9" TextWrapping="Wrap" Foreground="#64748B" Margin="0,4,0,8"
                   Text="Запись разрешена только в GmcSmetaPilot_*. Для постоянной работы настройте доверенный TLS-сертификат."/>
        <TextBlock Grid.Row="10" x:Name="StatusText" TextWrapping="Wrap" FontWeight="SemiBold"
                   Margin="0,5,0,8" Foreground="#334155"
                   Text="Введите адрес компьютера с SQL Server и проверьте соединение."/>
        <TextBlock Grid.Row="11" x:Name="MetricsText" Foreground="#64748B"
                   TextWrapping="Wrap" VerticalAlignment="Top"/>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>